---
import Layout from '../layouts/Layout.astro';
import FeatDetails from '../components/feats/FeatDetails.astro';
import { featsData } from '../data/feats';

const sortedFeats = [...featsData].sort((a, b) => 
  a.name.localeCompare(b.name, 'ru')
);

const featTypes = {
  'origin': 'Черта происхождения',
  'general': 'Общая черта',
  'fighting-style': 'Черта боевого стиля',
  'epic': 'Эпическая черта'
};

const abilities = {
  'STR': 'Сила',
  'DEX': 'Ловкость',
  'CON': 'Телосложение',
  'INT': 'Интеллект',
  'WIS': 'Мудрость',
  'CHA': 'Харизма'
};
---

<Layout title="Черты">
  <div class="content">
    <h1>Черты</h1>
    
    <div class="feats-workspace" id="feats-workspace">
      <section class="feats-list-panel" aria-label="Поиск и список черт">
    <div class="search-container">
      <div class="search-controls">
        <div class="search-input-container">
          <label class="sr-only" for="feat-search">Поиск по названию, описанию, источнику или требованиям</label>
          <input 
            type="search"
            id="feat-search" 
            placeholder="Поиск черт..."
            class="search-input"
          />
          <div id="feats-counter" class="feats-counter" role="status" aria-live="polite" aria-atomic="true">0/0</div>
          <button id="clear-search" class="clear-search-button" style="display: none;">×</button>
        </div>
        <button id="filter-button" class="filter-button" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="filter-popup">
          <span class="filter-icon">⚙</span>
          Фильтры
          <span id="filter-count" class="filter-count">0</span>
        </button>
      </div>

      <div id="filter-popup" class="filter-popup">
        <div class="filter-content">
          <div class="filter-header">
            <h3>Фильтры</h3>
            <button id="reset-filters" class="reset-button" title="Сбросить фильтры">Сбросить</button>
            <button class="close-button">×</button>
          </div>
          
          <div class="filter-section">
            <h4>Тип черты</h4>
            <div class="checkbox-group">
              {Object.entries(featTypes).map(([key, label]) => (
                <button type="button" class="tri-filter" data-filter="feat-type" data-value={key} data-state="neutral">{label}</button>
              ))}
            </div>
          </div>

          <div class="filter-section">
            <h4>Повышение характеристик</h4>
            <div class="checkbox-group">
              {Object.entries(abilities).map(([key, label]) => (
                <button type="button" class="tri-filter" data-filter="ability-score" data-value={key} data-state="neutral">{label}</button>
              ))}
            </div>
          </div>
          
          <div class="filter-section">
            <h4>Доп. требования</h4>
            <div class="checkbox-group">
              <button type="button" class="tri-filter" data-filter="no-extra-req" data-value="no-extra-req" data-state="neutral">Только без дополнительных требований</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="feats-list-scroll">
    <div class="feats-grid">
      {sortedFeats.map(feat => {
        const reqs = feat.requirements || [];
        const hasExtraReq = reqs.length > 0 && (
          feat.type === 'origin' ||
          (feat.type === 'general' && !reqs.every(r => /Уровень\s*4\+/i.test(String(r)) || /13\+/i.test(String(r))))
        );
        const abilitySummary = (feat.abilityScoreIncrease || []).map(score => abilities[score]).join(', ');
        return (
          <a href={`/feats/${encodeURIComponent(feat.id)}`} class="feat-card" data-feat-id={feat.id} data-search={[feat.name, feat.nameEn, featTypes[feat.type], feat.sourceBook, abilitySummary, ...(feat.requirements || []), feat.description, ...feat.effects].filter(Boolean).join(' ')} data-feat-type={feat.type} data-abilities={feat.abilityScoreIncrease?.join(',')} data-has-extra-req={hasExtraReq ? 'true' : 'false'}>
            <span class="feat-card-heading"><span class="feat-card-name">{feat.name}</span><span class="name-en">{feat.nameEn}</span></span>
            <span class="feat-card-meta">{featTypes[feat.type]}{feat.sourceBook ? ` · ${feat.sourceBook}` : ''}</span>
            {abilitySummary && <span class="feat-card-abilities">Повышение характеристик: {abilitySummary}</span>}
            {feat.requirements?.length > 0 && <span class="feat-card-requirements">{feat.requirements.join(', ')}</span>}
          </a>
        );
      })}
    </div>
    <div id="feats-empty" class="feats-empty" hidden>
      <p>Черты не найдены. Измените запрос или сбросьте фильтры.</p>
      <button id="reset-empty-feats" class="reset-button" type="button">Сбросить поиск и фильтры</button>
    </div>
    </div>
      </section>
      <section id="feat-reading" class="feat-reading" aria-label="Подробности черты">
        <button id="back-to-feat-list" class="mobile-back" type="button">← К списку черт</button>
        <div id="feat-details-placeholder" class="feat-details-placeholder">
          <span aria-hidden="true">✦</span>
          <h2>Какую черту выберете?</h2>
          <p>Выберите черту, чтобы посмотреть её требования и эффекты.</p>
        </div>
        <div id="feat-details-content" class="feat-details-content" hidden></div>
      </section>
    </div>
    {sortedFeats.map(feat => <template data-feat-details={feat.id}><FeatDetails feat={feat} /></template>)}
  </div>
</Layout>

<script>
  function initializeFilters() {
    const filterButton = document.getElementById('filter-button');
    const filterPopup = document.getElementById('filter-popup');
    const closeButton = document.querySelector('.close-button');
    /** @type {HTMLInputElement|null} */
    const searchInput = document.getElementById('feat-search');
    const clearSearchButton = document.getElementById('clear-search');
    const featsCounter = document.getElementById('feats-counter');
    const featCards = document.querySelectorAll('.feat-card');
    const triButtons = document.querySelectorAll('.tri-filter');
    const typeButtons = document.querySelectorAll('.tri-filter[data-filter="feat-type"]');
    const abilityButtons = document.querySelectorAll('.tri-filter[data-filter="ability-score"]');
    const extraReqButton = document.querySelector('.tri-filter[data-filter="no-extra-req"]');

    // Read filters from URL (preferred) — supports tri-state via include/exclude params
    function getFiltersFromURL() {
      const params = new URLSearchParams(window.location.search);
      const out: any = {};

      const search = params.get('search');
      if (search) out.search = search;

      // feat-type: includes in `feat-type`, excludes in `feat-type-exclude`
      const ftInc = params.get('feat-type');
      const ftExc = params.get('feat-type-exclude');
      if (ftInc || ftExc) {
        const map: any = {};
        if (ftInc) ftInc.split(',').forEach(v => { if (v) map[v] = 'include'; });
        if (ftExc) ftExc.split(',').forEach(v => { if (v) map[v] = 'exclude'; });
        out['feat-type'] = map;
      }

      // ability-score: includes in `ability-score`, excludes in `ability-score-exclude`
      const abInc = params.get('ability-score');
      const abExc = params.get('ability-score-exclude');
      if (abInc || abExc) {
        const map: any = {};
        if (abInc) abInc.split(',').forEach(v => { if (v) map[v] = 'include'; });
        if (abExc) abExc.split(',').forEach(v => { if (v) map[v] = 'exclude'; });
        out['ability-score'] = map;
      }

      const extra = params.get('no-extra-req');
      if (extra) out['no-extra-req'] = extra;

      return out;
    }

    // Load filters: prefer URL params, fallback to localStorage
    function loadFilters() {
      const urlFilters = getFiltersFromURL();
      if (Object.keys(urlFilters).length > 0) {
        try {
          if (urlFilters.search && searchInput instanceof HTMLInputElement) {
            searchInput.value = urlFilters.search;
          }

          if (urlFilters['feat-type']) {
            const mapping = urlFilters['feat-type'];
            Object.entries(mapping).forEach(([v, s]) => {
              const btn = document.querySelector(`.tri-filter[data-filter="feat-type"][data-value="${v}"]`);
              if (btn instanceof HTMLElement && (s === 'include' || s === 'exclude')) btn.dataset.state = String(s);
            });
          }

          if (urlFilters['ability-score']) {
            const mapping = urlFilters['ability-score'];
            Object.entries(mapping).forEach(([v, s]) => {
              const btn = document.querySelector(`.tri-filter[data-filter="ability-score"][data-value="${v}"]`);
              if (btn instanceof HTMLElement && (s === 'include' || s === 'exclude')) btn.dataset.state = String(s);
            });
          }

          if (urlFilters['no-extra-req'] && extraReqButton instanceof HTMLElement) {
            extraReqButton.dataset.state = urlFilters['no-extra-req'];
          }

          // Apply classes
          triButtons.forEach(b => {
            const el = b instanceof HTMLElement ? b : null;
            const state = el?.dataset.state || 'neutral';
            if (el) {
              el.classList.remove('state-neutral', 'state-include', 'state-exclude');
              el.classList.add(`state-${state}`);
            }
          });

          // Persist URL-driven selection to localStorage
          saveFilters();
          updateFilterCount();
          filterFeats();
          return;
        } catch (e) {
          console.error('Failed to apply filters from URL', e);
        }
      }

      // Fallback: load from localStorage (existing behavior)
      const saved = localStorage.getItem('featFilters');
      if (!saved) return;
      try {
        const filters = JSON.parse(saved);

        // Backwards compatibility: previous format stored arrays under keys
        // New format: object mapping for each filter type, plus single-state values

        // Apply mapping-based filters (feat-type, ability-score)
        Object.keys(filters).forEach(key => {
          const val = filters[key];
          if (key === 'no-extra-req' && extraReqButton instanceof HTMLElement) {
            // If stored as boolean (old), convert: true -> include (only without extra req)
            if (typeof val === 'boolean') {
              extraReqButton.dataset.state = val ? 'include' : 'neutral';
            } else if (typeof val === 'string') {
              extraReqButton.dataset.state = val;
            }
          }

          if (key === 'feat-type' || key === 'ability-score') {
            const mapping = val; // expected object { value: state }
            if (mapping && typeof mapping === 'object') {
              Object.entries(mapping).forEach(([v, s]) => {
                const btn = document.querySelector(`.tri-filter[data-filter="${key}"][data-value="${v}"]`);
                if (btn instanceof HTMLElement && (s === 'include' || s === 'exclude')) btn.dataset.state = String(s);
              });
            } else if (Array.isArray(mapping)) {
              // old format: array of checked values (assume include)
              mapping.forEach((v: string) => {
                const btn = document.querySelector(`.tri-filter[data-filter="${key}"][data-value="${v}"]`);
                if (btn instanceof HTMLElement) btn.dataset.state = 'include';
              });
            }
          }
        });

        // Update classes based on data-state
        triButtons.forEach(b => {
          const el = b instanceof HTMLElement ? b : null;
          const state = el?.dataset.state || 'neutral';
          if (el) {
            el.classList.remove('state-neutral', 'state-include', 'state-exclude');
            el.classList.add(`state-${state}`);
          }
        });

        updateFilterCount();
        filterFeats();
      } catch (e) {
        console.error('Failed to load featFilters', e);
      }
    }

    // Save filters to localStorage
    function saveFilters() {
      const out: any = {};

      // For each filter type, save mapping value->state if state != neutral
      ['feat-type', 'ability-score'].forEach(ft => {
        const map: any = {};
        document.querySelectorAll(`.tri-filter[data-filter="${ft}"]`).forEach(b => {
          if (b instanceof HTMLElement) {
            const val = b.dataset.value;
            const st = b.dataset.state || 'neutral';
            if (st && st !== 'neutral') map[val] = st;
          }
        });
        out[ft] = map;
      });

      // extra req can be stored as string state
      if (extraReqButton instanceof HTMLElement) out['no-extra-req'] = extraReqButton.dataset.state || 'neutral';

      localStorage.setItem('featFilters', JSON.stringify(out));
      // Reflect filters in URL so they can be shared / preserved
      updateURL();
    }

    // Update the current URL to reflect selected filters (no history entry)
    function updateURL() {
      const params = new URLSearchParams();

      const featInc: string[] = [];
      const featExc: string[] = [];
      document.querySelectorAll('.tri-filter[data-filter="feat-type"]').forEach(b => {
        if (!(b instanceof HTMLElement)) return;
        const st = b.dataset.state || 'neutral';
        const val = b.dataset.value;
        if (st === 'include') featInc.push(val);
        if (st === 'exclude') featExc.push(val);
      });
      if (featInc.length) params.set('feat-type', featInc.join(','));
      if (featExc.length) params.set('feat-type-exclude', featExc.join(','));

      const abInc: string[] = [];
      const abExc: string[] = [];
      document.querySelectorAll('.tri-filter[data-filter="ability-score"]').forEach(b => {
        if (!(b instanceof HTMLElement)) return;
        const st = b.dataset.state || 'neutral';
        const val = b.dataset.value;
        if (st === 'include') abInc.push(val);
        if (st === 'exclude') abExc.push(val);
      });
      if (abInc.length) params.set('ability-score', abInc.join(','));
      if (abExc.length) params.set('ability-score-exclude', abExc.join(','));

      const extraState = extraReqButton instanceof HTMLElement ? extraReqButton.dataset.state || 'neutral' : 'neutral';
      if (extraState && extraState !== 'neutral') params.set('no-extra-req', extraState);

      const searchTerm = (searchInput instanceof HTMLInputElement) ? searchInput.value.trim() : '';
      if (searchTerm) params.set('search', searchTerm);

      const queryString = params.toString();
      const pathParts = window.location.pathname.split('/');
      let selectedFeatId: string | null = null;
      if (pathParts[1] === 'feats' && pathParts[2]) {
        try { selectedFeatId = decodeURIComponent(pathParts[2]); } catch { selectedFeatId = pathParts[2]; }
      }
      const basePath = selectedFeatId ? `/feats/${encodeURIComponent(selectedFeatId)}` : '/feats';
      const newUrl = queryString ? `${basePath}?${queryString}` : basePath;
      window.history.replaceState({ ...window.history.state, featId: selectedFeatId }, '', newUrl);
    }

    // Update filter count display
    function updateFilterCount() {
      let cnt = 0;
      triButtons.forEach(b => {
        if (b instanceof HTMLElement) {
          const st = b.dataset.state;
          if (st && st !== 'neutral') cnt++;
        }
      });

      const filterCount = document.getElementById('filter-count');
      if (filterCount) {
        filterCount.textContent = String(cnt);
        filterCount.style.display = cnt > 0 ? 'flex' : 'none';
      }

      if (filterButton) {
        filterButton.classList.toggle('has-filters', cnt > 0);
      }
    }

    function togglePopup() {
      if (filterPopup) {
        const isOpen = filterPopup.classList.toggle('show');
        filterButton?.setAttribute('aria-expanded', String(isOpen));
        document.getElementById('feats-workspace')?.classList.toggle('filters-open', isOpen);
      }
    }

    function closePopup(e: MouseEvent) {
      if (filterPopup && e.target === filterPopup) {
        filterPopup.classList.remove('show');
        filterButton?.setAttribute('aria-expanded', 'false');
        document.getElementById('feats-workspace')?.classList.remove('filters-open');
      }
    }

    function filterFeats() {
      const searchTerm = (searchInput instanceof HTMLInputElement) ? searchInput.value.trim().toLocaleLowerCase('ru') : '';
      // Build include/exclude lists from tri-state buttons
      const typeIncludes: string[] = [];
      const typeExcludes: string[] = [];
      typeButtons.forEach(b => {
        if (b instanceof HTMLElement) {
          const st = b.dataset.state || 'neutral';
          const val = b.dataset.value || '';
          if (st === 'include') typeIncludes.push(val);
          if (st === 'exclude') typeExcludes.push(val);
        }
      });

      const abilityIncludes: string[] = [];
      const abilityExcludes: string[] = [];
      abilityButtons.forEach(b => {
        if (b instanceof HTMLElement) {
          const st = b.dataset.state || 'neutral';
          const val = b.dataset.value || '';
          if (st === 'include') abilityIncludes.push(val);
          if (st === 'exclude') abilityExcludes.push(val);
        }
      });

      const extraState = extraReqButton instanceof HTMLElement ? extraReqButton.dataset.state || 'neutral' : 'neutral';

      let visibleCount = 0;
      const totalCount = featCards.length;

      featCards.forEach(card => {
        const searchableText = card instanceof HTMLElement ? (card.dataset.search || '').toLocaleLowerCase('ru') : '';
        const type = card instanceof HTMLElement ? card.dataset.featType || '' : '';
        const abilities = card instanceof HTMLElement ? ((card.dataset.abilities || '').split(',')) : [];


        const matchesSearch = searchableText.includes(searchTerm);

        // Type matching: excludes have priority, then includes (if any includes specified)
        let matchesType = true;
        if (typeExcludes.length > 0 && typeExcludes.includes(type)) matchesType = false;
        if (matchesType && typeIncludes.length > 0 && !typeIncludes.includes(type)) matchesType = false;

        // Abilities matching: check includes/excludes logic
        const cardAbilities = abilities.map(s => s.trim()).filter(Boolean);
        let matchesAbilities = true;
        if (abilityExcludes.length > 0 && cardAbilities.some(a => abilityExcludes.includes(a))) matchesAbilities = false;
        if (matchesAbilities && abilityIncludes.length > 0) {
          if (!cardAbilities.some(a => abilityIncludes.includes(a))) matchesAbilities = false;
        }

        let isVisible = matchesSearch && matchesType && matchesAbilities;

        // Extra requirements tri-state:
        // include -> show only feats WITHOUT extra requirements
        // exclude -> show only feats WITH extra requirements
        if (isVisible && extraState !== 'neutral') {
          const hasExtra = card instanceof HTMLElement ? card.dataset.hasExtraReq === 'true' : false;
          if (extraState === 'include' && hasExtra) isVisible = false; // want only without extra => hide those with extra
          if (extraState === 'exclude' && !hasExtra) isVisible = false; // want only with extra => hide those without
        }

        if (card instanceof HTMLElement) card.style.display = isVisible ? 'grid' : 'none';

        if (isVisible) {
          visibleCount++;
        }
      });
      
      // Update counter
      if (featsCounter) {
        featsCounter.textContent = `${visibleCount}/${totalCount}`;
      }
      const emptyState = document.getElementById('feats-empty');
      if (emptyState) emptyState.toggleAttribute('hidden', visibleCount > 0);
      
      // Update clear button visibility
      if (clearSearchButton) {
        clearSearchButton.style.display = searchTerm ? 'flex' : 'none';
      }
      
      saveFilters();
      updateFilterCount();
    }

    // Reset all filters UI and saved settings
    function resetFilters() {
      triButtons.forEach(b => {
        if (b instanceof HTMLElement) {
          b.dataset.state = 'neutral';
          b.classList.remove('state-include', 'state-exclude', 'state-neutral');
          b.classList.add('state-neutral');
        }
      });
      if (searchInput instanceof HTMLInputElement) searchInput.value = '';
      localStorage.removeItem('featFilters');
      updateFilterCount();
      updateURL();
      filterFeats();
    }

    filterButton?.addEventListener('click', togglePopup);
    closeButton?.addEventListener('click', togglePopup);
    filterPopup?.addEventListener('click', closePopup);
    if (searchInput instanceof HTMLInputElement) searchInput.addEventListener('input', filterFeats);

    // Clear search functionality
    clearSearchButton?.addEventListener('click', () => {
      if (searchInput instanceof HTMLInputElement) {
        searchInput.value = '';
        filterFeats();
      }
    });

    // Add event listeners for filter checkboxes using event delegation
    // tri-state buttons: handle clicks to cycle states and apply filters
    triButtons.forEach(b => {
      b.addEventListener('click', (e) => {
        if (!(b instanceof HTMLElement)) return;
        const next: Record<string, string> = { neutral: 'include', include: 'exclude', exclude: 'neutral' };
        const cur = b.dataset.state || 'neutral';
        const nv = next[cur] || 'neutral';
        b.dataset.state = nv;
        b.classList.remove('state-neutral', 'state-include', 'state-exclude');
        b.classList.add(`state-${nv}`);
        updateFilterCount();
        saveFilters();
        filterFeats();
      });
    });
    
    // Reset filters button
    const resetButton = document.getElementById('reset-filters');
    resetButton?.addEventListener('click', resetFilters);
    
    // Initialize
    // Ensure triButtons have classes matching initial data-state
    triButtons.forEach(b => {
      if (b instanceof HTMLElement) {
        const state = b.dataset.state || 'neutral';
        b.classList.add(`state-${state}`);
      }
    });

    loadFilters();
    filterFeats(); // Initial count
    document.getElementById('reset-empty-feats')?.addEventListener('click', resetFilters);
  }

  document.addEventListener('DOMContentLoaded', initializeFilters);
</script>

<script>
  function initializeFeatSelection() {
    const workspace = document.getElementById('feats-workspace');
    const listPanel = document.querySelector<HTMLElement>('.feats-list-panel');
    const searchInput = document.getElementById('feat-search') as HTMLInputElement | null;
    const detailPlaceholder = document.getElementById('feat-details-placeholder');
    const detailContent = document.getElementById('feat-details-content');
    const backButton = document.getElementById('back-to-feat-list');
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.feat-card'));
    if (!workspace || !listPanel || !detailPlaceholder || !detailContent) return;

    const templates = new Map<string, HTMLTemplateElement>();
    document.querySelectorAll<HTMLTemplateElement>('template[data-feat-details]').forEach(template => {
      const id = template.dataset.featDetails;
      if (id) templates.set(id, template);
    });
    let selectedId: string | null = null;
    let listScrollY = 0;
    let lastSelectedId: string | null = null;

    function showFeat(id: string | null, moveFocus = false) {
      const template = id ? templates.get(id) : undefined;
      selectedId = template ? id : null;
      detailContent.replaceChildren();
      detailContent.hidden = !selectedId;
      detailPlaceholder.hidden = Boolean(selectedId);
      workspace.classList.toggle('is-reading', Boolean(selectedId));
      cards.forEach(card => {
        const active = card.dataset.featId === selectedId;
        card.classList.toggle('active', active);
        if (active) card.setAttribute('aria-current', 'page');
        else card.removeAttribute('aria-current');
      });

      if (!template || !selectedId) {
        if (moveFocus) {
          window.scrollTo({ top: listScrollY, behavior: 'instant' });
          const lastCard = cards.find(card => card.dataset.featId === lastSelectedId);
          (lastCard || searchInput)?.focus({ preventScroll: true });
        }
        return;
      }

      lastSelectedId = selectedId;
      detailContent.append(template.content.cloneNode(true));
      if (moveFocus && window.matchMedia('(max-width: 760px)').matches) {
        window.scrollTo({ top: 0, behavior: 'instant' });
        const heading = detailContent.querySelector<HTMLElement>('h2');
        heading?.setAttribute('tabindex', '-1');
        heading?.focus({ preventScroll: true });
      }
    }

    function selectFeat(id: string) {
      if (selectedId === id) return;
      if (!selectedId) listScrollY = window.scrollY;
      const fromList = !selectedId;
      history.replaceState({ ...history.state, featId: selectedId, listScrollY }, '');
      const search = window.location.search;
      history.pushState({ featId: id, fromList, listScrollY }, '', `/feats/${encodeURIComponent(id)}${search}`);
      showFeat(id, true);
    }

    function backToList() {
      if (history.state?.fromList) {
        history.back();
        return;
      }
      const listUrl = `/feats${window.location.search}`;
      history.pushState({ featId: null, listScrollY }, '', listUrl);
      showFeat(null, true);
    }

    workspace.addEventListener('click', event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest<HTMLAnchorElement>('a.feat-card');
      if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
      const id = link.dataset.featId;
      if (!id) return;
      event.preventDefault();
      selectFeat(id);
    });
    backButton?.addEventListener('click', backToList);
    window.addEventListener('popstate', event => {
      const state = event.state as { featId?: string | null; listScrollY?: number } | null;
      listScrollY = state?.listScrollY ?? listScrollY;
      let id = state?.featId || null;
      if (!id) {
        const routeId = window.location.pathname.split('/')[2];
        if (routeId) {
          try { id = decodeURIComponent(routeId); } catch { id = routeId; }
        }
      }
      showFeat(id, true);
    });

    history.replaceState({ ...history.state, featId: null, listScrollY: window.scrollY }, '', window.location.href);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeFeatSelection);
  else initializeFeatSelection();
</script>

