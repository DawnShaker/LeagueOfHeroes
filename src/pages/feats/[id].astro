---
import Layout from '../../layouts/Layout.astro';
import FeatDetails from '../../components/feats/FeatDetails.astro';
import { featsData } from '../../data/feats';

export function getStaticPaths() {
  return featsData.map(feat => ({
    params: { id: feat.id },
    props: { feat },
  }));
}

const { feat } = Astro.props;
---

<Layout title={feat.name}>
  <main class="feat-page">
    <a href="/feats" class="back-link">← Назад к чертам</a>
    <div class="feat-page-content">
      <FeatDetails feat={feat} standalone />
    </div>
  </main>
</Layout>

<style>
  .feat-page { max-width: 1000px; margin: 0 auto; }
  .back-link { display: inline-block; margin-bottom: 1rem; color: var(--primary); text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .feat-page-content { padding: clamp(1rem, 4vw, 2rem); border: 1px solid var(--card-border); border-radius: .75rem; background: var(--card-bg); box-shadow: var(--card-shadow); }
</style>
