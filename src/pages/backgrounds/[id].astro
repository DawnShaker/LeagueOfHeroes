---
import Layout from '../../layouts/Layout.astro';
import BackgroundDetails from '../../components/backgrounds/BackgroundDetails.astro';
import { backgroundsData } from '../../data/backgrounds';

export function getStaticPaths() {
  return backgroundsData.map(background => ({
    params: { id: background.id },
    props: { background },
  }));
}

const { background } = Astro.props;
---

<Layout title={background.name}>
  <main class="background-page">
    <a href="/backgrounds" class="back-link">← Назад к предысториям</a>
    <div class="background-content">
      <BackgroundDetails background={background} standalone />
    </div>
  </main>
</Layout>

<style>
  .background-page { max-width: 1000px; margin: 0 auto; }
  .back-link { display: inline-block; margin-bottom: 1rem; color: var(--primary); text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .background-content { padding: clamp(1rem, 4vw, 2rem); border: 1px solid var(--card-border); border-radius: .75rem; background: var(--card-bg); box-shadow: var(--card-shadow); }
</style>
