---
import CreatorSidebar from './CreatorSidebar.astro';
import CharacterPreview from './CharacterPreview.astro';
import NameStep from './steps/NameStep.astro';
import SpeciesStep from './steps/SpeciesStep.astro';
import ClassStep from './steps/ClassStep.astro';
import ClassFeaturesStep from './steps/ClassFeaturesStep.astro';
import BackgroundStep from './steps/BackgroundStep.astro';
import OriginFeatsStep from './steps/OriginFeatsStep.astro';
import SkillsStep from './steps/SkillsStep.astro';
import ExpertiseStep from './steps/ExpertiseStep.astro';
import LanguagesStep from './steps/LanguagesStep.astro';
import ToolsStep from './steps/ToolsStep.astro';
import AbilityStep from './steps/AbilityStep.astro';
import EquipmentStep from './steps/EquipmentShopStep.astro';
import SpellStep from './steps/SpellStep.astro';
import AlignmentStep from './steps/AlignmentStep.astro';
import SummaryStep from './steps/SummaryStep.astro';
import { backgroundsData } from '../../data/backgrounds';
import { featsData } from '../../data/feats';
import { spells } from '../../data/spells';
import { items } from '../../data/items';
import roll20TemplateRaw from '../../data/roll20/blank-2014.json?raw';
import roll20ExportClientUrl from './client/roll20Export.js?url';
import characterStateClientUrl from './client/characterState.js?url';
import allRoll20SpellsRaw from '../../data/roll20/all-spells.json?raw';
import {
  ALL_SKILLS,
  ARTISAN_TOOLS,
  MUSICAL_INSTRUMENTS,
  GAMING_SETS,
  OTHER_TOOLS,
  ALL_TOOLS,
  STANDARD_LANGUAGES,
  RARE_LANGUAGES
} from './config/proficiencies.ts';
import { EQUIPMENT_PACK_CONTENTS } from './config/equipmentPacks.ts';
import { SPELL_LIMITS } from './config/spellLimits.ts';
import { SKILL_ALIASES, CLASS_SKILL_OPTIONS } from './config/skills.ts';
import { GENERIC_BACKGROUND_CHARACTERISTICS } from './config/backgroundCharacteristics.ts';
import { EQUIPMENT_NAME_ALIASES, PACKAGED_EQUIPMENT_NAMES } from './config/equipmentAliases.ts';
import { WEAPON_MASTERY_COUNTS, WEAPON_MASTERY_DESCRIPTIONS, ROGUE_WEAPON_MASTERY_IDS } from './config/weaponMasteries.ts';
import { ROLL20_SKILLS, ROLL20_SKILL_ABILITIES } from './config/roll20Mappings.ts';
import { ALIGNMENTS } from './config/alignments.ts';
import { WEAPON_MASTERY_OPTIONS, BLOOD_CURSE_OPTIONS, buildClassFeatureOptions } from './config/classFeatures.ts';
import { CHARACTER_STORAGE_KEY, CREATOR_STEPS, ABILITY_KEYS, POINT_BUY_COSTS, DEFAULT_CHARACTER_STATE } from './config/creatorState.ts';
import {
  toolOptionsFromDescription,
  languageChoiceCount,
  languageOptionsForSource,
  isCustomLineageEligibleGeneralFeat,
  normalizeSpellName,
  normalizeSpellLevel,
  spellBelongsToClass,
  parseMoneyToCopper,
  parseWeight,
  getEquipmentCategoryGroup
} from './utils/dataPreparation.ts';
import {
  buildBackgroundOptions,
  buildFeatOptions,
  buildCustomLineageGeneralFeatOptions,
  buildFightingStyleOptions,
  buildMagicInitiateSpellOptions,
  buildRoll20RowsByName,
  buildClassSpellOptions,
  buildClassSpellLimits,
  buildEquipmentShopItems
} from './utils/dataBuilders.ts';

interface Props {
  speciesOptions: any[];
  classOptions: any[];
}

const { speciesOptions, classOptions } = Astro.props;
const roll20Template = JSON.parse(roll20TemplateRaw);

let allRoll20SpellsTemplate: any = { character: { attribs: [] } };
try {
  allRoll20SpellsTemplate = JSON.parse(allRoll20SpellsRaw);
} catch (error) {
  console.error('Не удалось прочитать src/data/roll20/all-spells.json. Выбор заклинаний продолжит работать, но карточки заклинаний не будут добавлены в экспорт Roll20.', error);
}




const backgroundOptions = buildBackgroundOptions({
  backgroundsData,
  allTools: ALL_TOOLS,
  artisanTools: ARTISAN_TOOLS,
  musicalInstruments: MUSICAL_INSTRUMENTS,
  gamingSets: GAMING_SETS,
  standardLanguages: STANDARD_LANGUAGES,
  rareLanguages: RARE_LANGUAGES,
  toolOptionsFromDescription,
  languageOptionsForSource,
  languageChoiceCount
});

const featOptions = buildFeatOptions(featsData);



const customLineageGeneralFeatOptions =
  buildCustomLineageGeneralFeatOptions(
    featsData,
    isCustomLineageEligibleGeneralFeat
  );

const allSelectableFeatOptions = [...featOptions, ...customLineageGeneralFeatOptions];

const fightingStyleOptions = buildFightingStyleOptions(featsData);


const weaponMasteryOptions = [...WEAPON_MASTERY_OPTIONS];
const rogueWeaponMasteryIds = [...ROGUE_WEAPON_MASTERY_IDS];



const bloodCurseOptions = [...BLOOD_CURSE_OPTIONS];


const classFeatureOptions = buildClassFeatureOptions(fightingStyleOptions);

const magicInitiateSpellOptions = buildMagicInitiateSpellOptions(spells);



const roll20RowsByName = buildRoll20RowsByName(
  allRoll20SpellsTemplate,
  normalizeSpellName
);



const classSpellOptions = buildClassSpellOptions({
  classOptions,
  spells,
  normalizeSpellLevel,
  normalizeSpellName,
  spellBelongsToClass,
  roll20RowsByName
});

const classSpellLimits = buildClassSpellLimits({
  classOptions,
  spellLimits: SPELL_LIMITS,
  normalizeSpellName
});





const equipmentShopItems = buildEquipmentShopItems({
  items,
  getEquipmentCategoryGroup,
  parseMoneyToCopper,
  parseWeight
});

const creatorOptions = {
  allSkills: [...ALL_SKILLS],
  allTools: [...ALL_TOOLS],
  artisanTools: [...ARTISAN_TOOLS],
  standardLanguages: [...STANDARD_LANGUAGES],
  rareLanguages: [...RARE_LANGUAGES]
};
---

<div class="character-wizard" id="character-wizard">
  <header class="wizard-header">
    <div>
      <span class="wizard-kicker">Кузница героев</span>
      <h1>Создание персонажа</h1>
      <p>Собери героя шаг за шагом. Черновик сохраняется автоматически.</p>
    </div>
    <button type="button" class="button button-secondary" id="reset-character">
      Начать заново
    </button>
  </header>

  <div class="wizard-layout">
    <CreatorSidebar />

    <main class="wizard-main">
      <NameStep />
      <SpeciesStep speciesOptions={speciesOptions} />

      <ClassStep classOptions={classOptions} />
      <ClassFeaturesStep />
      <AlignmentStep />
      <BackgroundStep backgroundOptions={backgroundOptions} />
      <OriginFeatsStep featOptions={featOptions} />
      <SkillsStep />
      <ExpertiseStep />
      <LanguagesStep />
      <ToolsStep />
      <EquipmentStep />

      <AbilityStep />
      <SpellStep />
      <SummaryStep />

      <footer class="wizard-footer">
        <button class="button button-secondary" type="button" id="previous-step">
          ← Назад
        </button>
        <span id="step-counter">Шаг 1 из 5</span>
        <button class="button button-primary" type="button" id="next-step">
          Продолжить →
        </button>
      </footer>
    </main>

    <CharacterPreview />
  </div>
</div>

<script is:inline src={roll20ExportClientUrl}></script>
<script is:inline src={characterStateClientUrl}></script>

<script define:vars={{ speciesOptions, classOptions, backgroundOptions, featOptions, customLineageGeneralFeatOptions, allSelectableFeatOptions, magicInitiateSpellOptions, creatorOptions, roll20Template, classSpellOptions, classSpellLimits, classFeatureOptions, weaponMasteryOptions, rogueWeaponMasteryIds, bloodCurseOptions, WEAPON_MASTERY_COUNTS, WEAPON_MASTERY_DESCRIPTIONS, equipmentShopItems, EQUIPMENT_PACK_CONTENTS, SKILL_ALIASES, CLASS_SKILL_OPTIONS, GENERIC_BACKGROUND_CHARACTERISTICS, EQUIPMENT_NAME_ALIASES, PACKAGED_EQUIPMENT_NAMES, ROLL20_SKILLS, ROLL20_SKILL_ABILITIES, ALIGNMENTS, CHARACTER_STORAGE_KEY, CREATOR_STEPS, ABILITY_KEYS, POINT_BUY_COSTS, DEFAULT_CHARACTER_STATE }}>
  const STORAGE_KEY = CHARACTER_STORAGE_KEY;
  const steps = [...CREATOR_STEPS];
  const abilityKeys = [...ABILITY_KEYS];
  const COST_TABLE = { ...POINT_BUY_COSTS };
  const defaultState = structuredClone(DEFAULT_CHARACTER_STATE);

  let state = structuredClone(defaultState);

  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => Array.from(document.querySelectorAll(selector));
  const escapeHtml = (value) => String(value ?? '').replace(
    /[&<>'"]/g,
    (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[char])
  );

  function normalizeSpellNameClient(value) {
    return String(value || '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е')
      .replace(/\[[^\]]*\]/g, ' ')
      .replace(/[^a-zа-я0-9]+/gi, ' ')
      .trim();
  }

  function getStateModule() {
    const stateModule = window.CharacterCreatorState;
    if (!stateModule) {
      throw new Error('Модуль состояния персонажа не загрузился.');
    }
    return stateModule;
  }

  function loadState() {
    state = getStateModule().loadState(
      STORAGE_KEY,
      defaultState,
      abilityKeys
    );
  }

  function saveState() {
    getStateModule().saveState(STORAGE_KEY, state);
  }

  function findSpecies() {
    return getStateModule().findSpecies(state, speciesOptions);
  }

  function findVariant(species) {
    return getStateModule().findVariant(state, species);
  }

  function findClass() {
    return getStateModule().findClass(state, classOptions);
  }

  function findBackground() {
    return getStateModule().findBackground(state, backgroundOptions);
  }

  function getEffectiveAbilities(species, variant) {
    return getStateModule().getEffectiveAbilities(species, variant);
  }

  function loreToHtml(value, limit = null) {
    const lines = String(value || '')
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean);

    const selected = limit ? lines.slice(0, limit) : lines;

    return selected
      .map((line) =>
        line.startsWith('- ')
          ? `<li>${escapeHtml(line.slice(2))}</li>`
          : `<p>${escapeHtml(line)}</p>`
      )
      .join('');
  }

  function getSizeEntry(species, sizeKey) {
    if (!species?.sizeCalculator) return null;

    const raw = species.sizeCalculator.raw || {};
    if (raw.sizeOptions?.length && sizeKey && raw[sizeKey]) {
      return raw[sizeKey];
    }

    return species.sizeCalculator.base || null;
  }

  function initialisePhysique(species) {
    if (!species?.sizeCalculator) return;

    const raw = species.sizeCalculator.raw || {};
    const base = species.sizeCalculator.base || {};
    const defaultSize =
      state.physique.size ||
      base.size ||
      raw.sizeOptions?.[0] ||
      species.size ||
      null;

    const entry = getSizeEntry(species, defaultSize) || base;
    const heightRange = entry.heightRange || [0, 0];
    const weightRange = entry.weightRange || [0, 0];

    state.physique.size = defaultSize;

    if (state.physique.heightModifier === null) {
      state.physique.heightModifier = Math.round(
        (Number(heightRange[0] || 0) + Number(heightRange[1] || 0)) / 2
      );
    }

    if (state.physique.weightMultiplier === null) {
      state.physique.weightMultiplier = Math.round(
        (Number(weightRange[0] || 0) + Number(weightRange[1] || 0)) / 2
      );
    }
  }

  function calculatePhysique(species) {
    const entry = getSizeEntry(species, state.physique.size);
    if (!entry) return null;

    const baseHeight = entry.baseHeight || { 'футов': 4, 'дюймов': 8 };
    const baseWeight = Number(entry.baseWeight || 0);
    const extraHeight = Number(state.physique.heightModifier || 0);
    const weightMultiplier = Number(state.physique.weightMultiplier || 0);

    const totalInches =
      Number(baseHeight['футов'] || 0) * 12 +
      Number(baseHeight['дюймов'] || 0) +
      extraHeight;

    const feet = Math.floor(totalInches / 12);
    const inches = totalInches % 12;
    const weight = baseWeight + extraHeight * weightMultiplier;

    state.physique.heightInches = totalInches;
    state.physique.weightPounds = weight;

    return {
      entry,
      feet,
      inches,
      totalInches,
      weight
    };
  }

  function rangeProgress(value, min, max) {
    const span = Math.max(1, Number(max) - Number(min));
    return ((Number(value) - Number(min)) / span) * 100;
  }

  function renderSpeciesDetails() {
    const container = $('#species-details');
    const species = findSpecies();

    if (!container) return;

    if (!species) {
      container.innerHTML = `
        <div class="empty-state">
          <span>✦</span>
          <h3>Выбери вид</h3>
          <p>После выбора здесь появятся описание, особенности и параметры героя.</p>
        </div>
      `;
      return;
    }

    const variant = findVariant(species);
    const abilities = getEffectiveAbilities(species, variant);

    initialisePhysique(species);

    const sizeEntry = getSizeEntry(species, state.physique.size);
    const result = calculatePhysique(species);

    const rawSizeData = species.sizeCalculator?.raw || {};
    const heightRange = sizeEntry?.heightRange || [0, 0];
    const weightRange = sizeEntry?.weightRange || [0, 0];

    container.innerHTML = `
      <article class="species-profile">
        <header class="species-hero">
          <div class="species-hero-copy">
            <div class="species-title-row">
              <div>
                <span class="source-label">${escapeHtml(
                  variant?.sourceBook || species.sourceBook || 'Источник не указан'
                )}</span>
                <h2>
                  ${escapeHtml(species.name)}
                  <small>[${escapeHtml(species.nameEn || '')}]</small>
                </h2>
              </div>

              <button class="button button-secondary button-small" type="button" id="change-species">
                Изменить
              </button>
            </div>

            ${
              species.variants?.length
                ? `
                  <label class="variant-field">
                    <span>Подвид или вариант</span>
                    <select id="species-variant-select">
                      <option value="">Базовый вариант</option>
                      ${species.variants
                        .map(
                          (item) => `
                            <option value="${escapeHtml(item.id)}"
                              ${item.id === state.speciesVariant ? 'selected' : ''}>
                              ${escapeHtml(item.name)}
                            </option>
                          `
                        )
                        .join('')}
                    </select>
                  </label>
                `
                : ''
            }
          </div>

          <div class="species-hero-image">
            <img src="${escapeHtml(species.portrait)}" alt="" />
            <span></span>
          </div>
        </header>

        <section class="content-section lore-section">
          <div class="content-section-heading">
            <span class="section-icon">◈</span>
            <div>
              <span class="section-kicker">Наследие</span>
              <h3>Кто такие ${escapeHtml(species.name.toLowerCase())}</h3>
            </div>
          </div>

          <div class="lore-preview">
            ${loreToHtml(variant?.lore || species.lore, 2)}
          </div>

          <details class="full-lore">
            <summary>Показать полное описание</summary>
            <div class="full-lore-content">
              ${
                variant?.lore
                  ? `
                    <h4>Базовое описание</h4>
                    ${loreToHtml(species.lore)}
                    <h4>${escapeHtml(variant.name)}</h4>
                    ${loreToHtml(variant.lore)}
                  `
                  : loreToHtml(species.lore)
              }
            </div>
          </details>
        </section>

        <section class="species-stats">
          <div>
            <span>Тип</span>
            <strong>${escapeHtml(species.type || '—')}</strong>
          </div>
          <div>
            <span>Размер</span>
            <strong>${escapeHtml(state.physique.size || species.size || '—')}</strong>
          </div>
          <div>
            <span>Скорость</span>
            <strong>${escapeHtml(species.speed || '—')} фт.</strong>
          </div>
        </section>

        ${
          species.sizeCalculator && result
            ? `
              <section class="content-section size-section">
                <div class="content-section-heading size-heading">
                  <div class="heading-group">
                    <span class="section-icon">⚄</span>
                    <div>
                      <span class="section-kicker">Телосложение</span>
                      <h3>Рост и вес</h3>
                    </div>
                  </div>

                  <button type="button" class="button button-primary button-small" id="randomise-size">
                    Случайно
                  </button>
                </div>

                ${
                  rawSizeData.sizeOptions?.length
                    ? `
                      <label class="size-select">
                        <span>Размер существа</span>
                        <select id="size-select">
                          ${rawSizeData.sizeOptions
                            .map(
                              (option) => `
                                <option value="${escapeHtml(option)}"
                                  ${option === state.physique.size ? 'selected' : ''}>
                                  ${escapeHtml(option)}
                                </option>
                              `
                            )
                            .join('')}
                        </select>
                      </label>
                    `
                    : ''
                }

                <div class="slider-block">
                  <div class="slider-heading">
                    <div>
                      <span>Рост</span>
                      <small>Добавка к базовому росту вида</small>
                    </div>
                    <strong id="height-modifier-value">+${state.physique.heightModifier}″</strong>
                  </div>

                  <input
                    id="height-slider"
                    type="range"
                    min="${heightRange[0] || 0}"
                    max="${heightRange[1] || 0}"
                    value="${state.physique.heightModifier}"
                    style="--progress:${rangeProgress(
                      state.physique.heightModifier,
                      heightRange[0] || 0,
                      heightRange[1] || 0
                    )}%"
                  />

                  <div class="range-labels">
                    <span>+${heightRange[0] || 0}″</span>
                    <span>+${heightRange[1] || 0}″</span>
                  </div>

                  <div class="result-row">
                    <span>Итоговый рост</span>
                    <strong id="height-result-value">${result.feet}′ ${result.inches}″</strong>
                    <small id="height-result-note">${result.totalInches} дюймов</small>
                  </div>
                </div>

                <div class="slider-block">
                  <div class="slider-heading">
                    <div>
                      <span>Вес</span>
                      <small>Множитель добавочного веса</small>
                    </div>
                    <strong id="weight-multiplier-value">×${state.physique.weightMultiplier}</strong>
                  </div>

                  <input
                    id="weight-slider"
                    type="range"
                    min="${weightRange[0] || 0}"
                    max="${weightRange[1] || 0}"
                    value="${state.physique.weightMultiplier}"
                    style="--progress:${rangeProgress(
                      state.physique.weightMultiplier,
                      weightRange[0] || 0,
                      weightRange[1] || 0
                    )}%"
                  />

                  <div class="range-labels">
                    <span>×${weightRange[0] || 0}</span>
                    <span>×${weightRange[1] || 0}</span>
                  </div>

                  <div class="result-row">
                    <span>Итоговый вес</span>
                    <strong id="weight-result-value">${result.weight} фун.</strong>
                    <small>С учётом выбранного роста</small>
                  </div>
                </div>
              </section>
            `
            : ''
        }

        ${
          isCustomLineageSpecies()
            ? `
              <section class="content-section custom-lineage-section">
                <div class="content-section-heading">
                  <span class="section-icon">✧</span>
                  <div>
                    <span class="section-kicker">Своё происхождение</span>
                    <h3>Выбор особенностей</h3>
                  </div>
                </div>

                <div class="custom-lineage-choices">
                  <section class="custom-lineage-choice-card">
                    <div class="custom-lineage-card-heading"><span>01</span><div><h4>Размер</h4><p>Выберите размер персонажа.</p></div></div>
                    <div class="custom-lineage-option-grid">
                      <label class="custom-lineage-option">
                        <input type="radio" name="custom-lineage-size" value="Маленький" ${state.physique.size === 'Маленький' ? 'checked' : ''} />
                        <span><strong>Маленький</strong><small>Ваш персонаж считается существом Маленького размера.</small></span>
                      </label>
                      <label class="custom-lineage-option">
                        <input type="radio" name="custom-lineage-size" value="Средний" ${state.physique.size !== 'Маленький' ? 'checked' : ''} />
                        <span><strong>Средний</strong><small>Ваш персонаж считается существом Среднего размера.</small></span>
                      </label>
                    </div>
                  </section>

                  <section class="custom-lineage-choice-card">
                    <div class="custom-lineage-card-heading"><span>02</span><div><h4>Выборочная особенность</h4><p>Выберите одну из двух особенностей.</p></div></div>
                    <div class="custom-lineage-option-grid">
                      <label class="custom-lineage-option">
                        <input type="radio" name="custom-lineage-feature" value="darkvision" ${(state.choices['species:customLineageFeature'] || [])[0] === 'darkvision' ? 'checked' : ''} />
                        <span><strong>Тёмное зрение</strong><small>Вы видите в тусклом свете и темноте в пределах 60 футов.</small></span>
                      </label>
                      <label class="custom-lineage-option">
                        <input type="radio" name="custom-lineage-feature" value="skill" ${(state.choices['species:customLineageFeature'] || [])[0] === 'skill' ? 'checked' : ''} />
                        <span><strong>Владение навыком</strong><small>На этапе «Навыки» выберите один навык от вида.</small></span>
                      </label>
                    </div>
                  </section>

                  <div class="custom-lineage-feat-note">
                    <span>03</span><div><strong>Дополнительная черта</strong><p>На этапе «Черты происхождения» откроется отдельная таблица с поиском. В ней можно выбрать черту Происхождения или подходящую Общую черту.</p></div>
                  </div>
                </div>
              </section>
            `
            : ''
        }

        <section class="content-section traits-section">
          <div class="content-section-heading">
            <span class="section-icon">✦</span>
            <div>
              <span class="section-kicker">Особенности</span>
              <h3>Что получает персонаж</h3>
            </div>
          </div>

          <div class="traits-list">
            ${abilities
              .map(
                (ability) => `
                  <article class="trait-card">
                    <h4>${escapeHtml(ability.title || 'Особенность')}</h4>
                    <div>${loreToHtml(ability.description || '')}</div>
                  </article>
                `
              )
              .join('')}
          </div>
        </section>
      </article>
    `;

    bindSpeciesDetailEvents();
    updatePreview();
    saveState();
  }

  function bindSpeciesDetailEvents() {
    const species = findSpecies();
    if (!species) return;

    $('#change-species')?.addEventListener('click', () => {
      $('#species-picker')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    $('#species-variant-select')?.addEventListener('change', (event) => {
      state.speciesVariant = event.target.value || null;
      renderSpeciesDetails();
    });


    $$('[name="custom-lineage-size"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.physique.size = input.value;
      saveState();
      renderSpeciesDetails();
    }));

    $$('[name="custom-lineage-feature"]').forEach((input) => input.addEventListener('change', () => {
      if (!input.checked) return;
      state.choices['species:customLineageFeature'] = [input.value];
      if (input.value !== 'skill') state.choices['species:skill'] = [];
      saveState();
      renderSpeciesDetails();
      updatePreview();
    }));

    $('#size-select')?.addEventListener('change', (event) => {
      state.physique.size = event.target.value;
      state.physique.heightModifier = null;
      state.physique.weightMultiplier = null;
      renderSpeciesDetails();
    });

    function updatePhysiqueControls() {
      const heightSlider = $('#height-slider');
      const weightSlider = $('#weight-slider');
      const result = calculatePhysique(species);
      if (!result) return;

      if (heightSlider) {
        heightSlider.style.setProperty(
          '--progress',
          `${rangeProgress(
            state.physique.heightModifier,
            Number(heightSlider.min),
            Number(heightSlider.max)
          )}%`
        );
      }

      if (weightSlider) {
        weightSlider.style.setProperty(
          '--progress',
          `${rangeProgress(
            state.physique.weightMultiplier,
            Number(weightSlider.min),
            Number(weightSlider.max)
          )}%`
        );
      }

      const heightModifierValue = $('#height-modifier-value');
      const heightResultValue = $('#height-result-value');
      const heightResultNote = $('#height-result-note');
      const weightMultiplierValue = $('#weight-multiplier-value');
      const weightResultValue = $('#weight-result-value');

      if (heightModifierValue) {
        heightModifierValue.textContent = `+${state.physique.heightModifier}″`;
      }
      if (heightResultValue) {
        heightResultValue.textContent = `${result.feet}′ ${result.inches}″`;
      }
      if (heightResultNote) {
        heightResultNote.textContent = `${result.totalInches} дюймов`;
      }
      if (weightMultiplierValue) {
        weightMultiplierValue.textContent = `×${state.physique.weightMultiplier}`;
      }
      if (weightResultValue) {
        weightResultValue.textContent = `${result.weight} фун.`;
      }

      updatePreview();
      saveState();
    }

    $('#height-slider')?.addEventListener('input', (event) => {
      state.physique.heightModifier = Number(event.target.value);
      updatePhysiqueControls();
    });

    $('#weight-slider')?.addEventListener('input', (event) => {
      state.physique.weightMultiplier = Number(event.target.value);
      updatePhysiqueControls();
    });

    $('#randomise-size')?.addEventListener('click', () => {
      const current = getSizeEntry(species, state.physique.size) || {};
      const heightRange = current.heightRange || [0, 0];
      const weightRange = current.weightRange || [0, 0];

      state.physique.heightModifier =
        Math.floor(
          Math.random() *
            (Number(heightRange[1] || 0) - Number(heightRange[0] || 0) + 1)
        ) + Number(heightRange[0] || 0);

      state.physique.weightMultiplier =
        Math.floor(
          Math.random() *
            (Number(weightRange[1] || 0) - Number(weightRange[0] || 0) + 1)
        ) + Number(weightRange[0] || 0);

      const heightSlider = $('#height-slider');
      const weightSlider = $('#weight-slider');

      if (heightSlider) {
        heightSlider.value = String(state.physique.heightModifier);
      }
      if (weightSlider) {
        weightSlider.value = String(state.physique.weightMultiplier);
      }

      updatePhysiqueControls();
    });
  }

