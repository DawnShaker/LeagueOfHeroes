  function normalizeOptions(options) {
    return (options || []).map((option) =>
      typeof option === 'string' ? { value: option, label: option } : option
    );
  }

  const REPEATABLE_ORIGIN_FEATS = new Set(['skilled', 'magic-initiate']);

  function isRepeatableOriginFeat(id) {
    return REPEATABLE_ORIGIN_FEATS.has(String(id || '').toLowerCase());
  }

  function selectedOriginFeatEntries() {
    return getStateModule().selectedOriginFeatEntries(
      state,
      allSelectableFeatOptions
    );
  }

  function clearOriginFeatSourceChoices(source) {
    const prefix = `feat:${source}:`;
    Object.keys(state.choices).forEach((key) => {
      if (key.startsWith(prefix)) delete state.choices[key];
    });
  }

  function selectedOriginFeats() {
    return getStateModule().selectedOriginFeats(
      state,
      allSelectableFeatOptions
    );
  }

  function selectedOriginFeat() {
    return selectedOriginFeats()[0] || null;
  }

  function isHumanSpecies() {
    return getStateModule().isHumanSpecies(state, findSpecies());
  }

  function isCustomLineageSpecies() {
    return getStateModule().isCustomLineageSpecies(
      state,
      findSpecies()
    );
  }

  function speciesGrantsExtraFeat() {
    return isHumanSpecies() || isCustomLineageSpecies();
  }


  function normalizeRuleText(value) {
    return String(value || '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е')
      .replace(/[^a-zа-я0-9]+/gi, ' ')
      .trim();
  }

  const BACKGROUND_SPECIAL_FEAT_RULES = [
    { background: /резчик\s+рун|rune\s+carver/i, featIds: ['rune-shaper'] },
    { background: /найденыш\s+великанов|giant\s+foundling/i, featIds: ['strike-of-the-giants'] },
    { background: /рыцарь\s+соламнии|knight\s+of\s+solamnia/i, featIds: ['squire-of-solamnia'] },
    { background: /маг\s+высшего\s+волшебства|mage\s+of\s+high\s+sorcery/i, featIds: ['initiate-of-high-sorcery'] },
    { background: /планарн(?:ый|ого)\s+философ|planar\s+philosopher/i, featIds: ['scion-of-the-outer-planes'] },
    { background: /студент.*(?:лорхолд|призмари|квандрикс|сильверквилл|визерблум)|(?:lorehold|prismari|quandrix|silverquill|witherbloom)\s+student/i, featIds: ['strixhaven-initiate'] }
  ];

  function backgroundRuleText(background = findBackground()) {
    if (!background) return '';
    const values = [
      background.name,
      background.nameEn,
      background.feat,
      background.originFeat,
      background.feature,
      background.features,
      background.proficiencies?.feat,
      background.proficiencies?.originFeat,
      background.description,
      background.lore
    ];
    return values.map((value) => {
      if (Array.isArray(value)) return value.join(' ');
      if (value && typeof value === 'object') return Object.values(value).join(' ');
      return String(value || '');
    }).join(' ');
  }

  function getBackgroundOriginFeatOptions() {
    const background = findBackground();
    const ruleText = backgroundRuleText(background);
    const normalizedRule = normalizeRuleText(ruleText);
    const options = new Map(featOptions.map((feat) => [feat.id, feat]));

    // Устаревшие и сеттинговые предыстории могут прямо называть особую черту,
    // которая не входит в стандартный список черт происхождения.
    for (const feat of allSelectableFeatOptions) {
      const names = [feat.name, feat.nameEn, feat.id].map(normalizeRuleText).filter(Boolean);
      if (names.some((name) => name.length > 3 && normalizedRule.includes(name))) {
        options.set(feat.id, feat);
      }
    }

    const backgroundName = `${background?.name || ''} ${background?.nameEn || ''}`;
    for (const rule of BACKGROUND_SPECIAL_FEAT_RULES) {
      if (!rule.background.test(backgroundName)) continue;
      for (const featId of rule.featIds) {
        const feat = allSelectableFeatOptions.find((item) => item.id === featId);
        if (feat) options.set(feat.id, feat);
      }
    }

    return [...options.values()];
  }

  function getClassFeatureGroups() {
    const characterClass = findClass();
    const classId = String(characterClass?.id || state.class || '').toLocaleLowerCase('ru');
    const className = `${characterClass?.name || ''} ${characterClass?.nameEn || ''}`.toLocaleLowerCase('ru');
    const groups = [...(classFeatureOptions[state.class] || [])];

    const masteryEntry = Object.entries(WEAPON_MASTERY_COUNTS).find(([key]) =>
      classId === key || classId.includes(key) || className.includes(key)
    );

    if (masteryEntry) {
      const isRogue = classId === 'rogue' || classId.includes('rogue') || /плут/.test(className);
      const allowedMasteryOptions = isRogue
        ? weaponMasteryOptions.filter((option) => rogueWeaponMasteryIds.includes(option.id))
        : weaponMasteryOptions;

      groups.push({
        id: 'weapon-mastery',
        name: 'Оружейные приёмы',
        count: masteryEntry[1],
        description: isRogue
          ? 'Выберите 2 типа оружия, которыми плут владеет: простое оружие либо воинское оружие со свойством «Фехтовальное» или «Лёгкое».'
          : 'Выберите оружие, к которому привязан доступный персонажу оружейный приём.',
        href: '/faq',
        options: allowedMasteryOptions
      });
    }

    const isBloodHunter =
      classId === 'bloodhunter' ||
      /blood[-_\s]?hunter/.test(classId) ||
      /blood[-_\s]?hunter/.test(className) ||
      /кровав(?:ый|ого)\s+охотник/.test(className);

    if (isBloodHunter) {
      groups.push({
        id: 'blood-curse',
        name: 'Проклятая кровь',
        count: 1,
        description: 'Выберите одно известное Проклятие крови.',
        href: '/classes/bloodhunter#feature-проклятая-кровь-1',
        options: bloodCurseOptions
      });
    }

    return groups;
  }

  function getSelectedClassFeatureEffects() {
    const effects = [];
    for (const group of getClassFeatureGroups()) {
      const selected = state.choices[`classFeature:${group.id}`] || [];
      for (const optionId of selected) {
        const option = group.options.find((item) => item.id === optionId);
        if (Array.isArray(option?.effects)) effects.push(...option.effects);
      }
    }
    return effects;
  }

  function getClassFeatureEffects(type) {
    return getSelectedClassFeatureEffects().filter((effect) => effect.type === type);
  }

  function classFeatureExtraCantrips(spellList) {
    return getClassFeatureEffects('extraCantrip')
      .filter((effect) => !effect.spellList || effect.spellList === spellList)
      .reduce((sum, effect) => sum + Number(effect.count || 0), 0);
  }

  function selectedClassFeatureOption(groupId) {
    return state.choices[`classFeature:${groupId}`]?.[0] || null;
  }

  function classFeaturesComplete() {
    return getClassFeatureGroups().every((group) => {
      const selected = state.choices[`classFeature:${group.id}`] || [];
      return selected.length === group.count;
    });
  }

  function renderClassFeatures(message = '') {
    const masteryGroup = getClassFeatureGroups().find((group) => group.id === 'weapon-mastery');
    if (masteryGroup) {
      const allowedIds = new Set(masteryGroup.options.map((option) => option.id));
      const choiceKey = 'classFeature:weapon-mastery';
      const selected = state.choices[choiceKey] || [];
      const validSelected = selected.filter((id) => allowedIds.has(id)).slice(0, masteryGroup.count);
      if (validSelected.length !== selected.length) state.choices[choiceKey] = validSelected;
    }

    const list = $('#class-features-list');
    const empty = $('#class-features-empty');
    const warning = $('#class-features-warning');
    if (!list || !empty || !warning) return;

    const groups = getClassFeatureGroups();
    empty.hidden = groups.length > 0;
    list.hidden = groups.length === 0;

    list.innerHTML = groups.map((group) => {
      const key = `classFeature:${group.id}`;
      const selected = Array.isArray(state.choices[key]) ? state.choices[key] : [];
      state.choices[key] = selected
        .filter((id) => group.options.some((option) => option.id === id))
        .slice(0, group.count);

      const inputType = group.count === 1 ? 'radio' : 'checkbox';

      return `<section class="class-feature-group">
        <div class="class-feature-summary">
          <div>
            <span>Умение класса</span>
            <h3>${group.href ? `<a class="class-feature-group-link" href="${escapeHtml(group.href)}" target="_blank" rel="noopener">${escapeHtml(group.name)} ↗</a>` : escapeHtml(group.name)}</h3>
            ${group.description ? `<p>${escapeHtml(group.description)}</p>` : ''}
          </div>
          <strong>${state.choices[key].length}/${group.count}</strong>
        </div>

        <div class="class-feature-table-wrap">
          <table class="class-feature-table">
            <thead>
              <tr>
                <th>${escapeHtml(group.name)}</th>
                <th>Выбор</th>
              </tr>
            </thead>
            <tbody>
              ${group.options.map((option) => {
                const checked = state.choices[key].includes(option.id);
                const optionTitle = option.href
                  ? `<a href="${escapeHtml(option.href)}" target="_blank" rel="noopener">${escapeHtml(option.name)} ↗</a>`
                  : `<span>${escapeHtml(option.name)}</span>`;
                const detailLabel = option.detail
                  ? group.id === 'weapon-mastery'
                    ? `<small><a class="class-feature-detail-link" href="/faq" target="_blank" rel="noopener">${escapeHtml(option.detail)} ↗</a></small>`
                    : `<small>${escapeHtml(option.detail)}</small>`
                  : '';
                const label = `${optionTitle}${detailLabel}`;

                return `<tr>
                  <td class="class-feature-name">${label}</td>
                  <td>
                    <input
                      class="class-feature-check"
                      type="${inputType}"
                      name="${escapeHtml(key)}"
                      data-class-feature="${escapeHtml(group.id)}"
                      value="${escapeHtml(option.id)}"
                      ${checked ? 'checked' : ''}
                      aria-label="${escapeHtml(option.name)}"
                    >
                  </td>
                </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>
      </section>`;
    }).join('');

    warning.textContent = message;
    warning.hidden = !message;

    $$('[data-class-feature]').forEach((input) => input.addEventListener('change', () => {
      const group = groups.find((item) => item.id === input.dataset.classFeature);
      if (!group) return;

      const key = `classFeature:${group.id}`;

      if (group.count === 1) {
        state.choices[key] = input.checked ? [input.value] : [];
      } else {
        const selected = state.choices[key] || [];

        if (input.checked && selected.length >= group.count) {
          renderClassFeatures(`Для умения «${group.name}» уже выбрано максимальное количество.`);
          return;
        }

        state.choices[key] = input.checked
          ? [...selected, input.value]
          : selected.filter((value) => value !== input.value);
      }

      saveState();
      renderClassFeatures();
    }));
  }

  function renderOriginFeats(message = '') {
    const body = $('#origin-feats-table-body');
    const summary = $('#origin-feats-summary');
    const warning = $('#origin-feats-warning');
    const raceHeader = $('#origin-feats-race-header');
    const customSection = $('#custom-lineage-feats');
    const customBody = $('#custom-lineage-feat-table-body');
    const customSearch = $('#custom-lineage-feat-search');
    const customCounter = $('#custom-lineage-feat-counter');
    if (!body || !summary || !warning) return;

    const speciesBonusFeat = speciesGrantsExtraFeat();
    const customLineage = isCustomLineageSpecies();
    const backgroundSelected = (state.choices['background:originFeat'] || []).slice(0, 1);
    const speciesSelected = speciesBonusFeat ? (state.choices['species:originFeat'] || []).slice(0, 1) : [];

    // Старые сохранения могли содержать одну и ту же неповторяемую черту
    // одновременно от предыстории и от вида. Сохраняем выбор предыстории,
    // а конфликтующий дополнительный выбор сбрасываем.
    if (
      backgroundSelected[0] &&
      speciesSelected[0] &&
      backgroundSelected[0] === speciesSelected[0] &&
      !isRepeatableOriginFeat(backgroundSelected[0])
    ) {
      speciesSelected.length = 0;
    }

    state.choices['background:originFeat'] = backgroundSelected;
    state.choices['species:originFeat'] = speciesSelected;

    summary.innerHTML = `
      <div class="origin-feats-summary-card"><span>Предыстория</span><strong>${backgroundSelected.length}/1</strong></div>
      ${speciesBonusFeat && !customLineage ? `<div class="origin-feats-summary-card"><span>Вид</span><strong>${speciesSelected.length}/1</strong></div>` : ''}
    `;

    if (raceHeader) {
      raceHeader.hidden = !speciesBonusFeat || customLineage;
      raceHeader.textContent = 'От вида';
      raceHeader.title = '';
    }

    const backgroundFeatOptions = getBackgroundOriginFeatOptions();
    body.innerHTML = backgroundFeatOptions.map((feat) => {
      const fromBackground = backgroundSelected.includes(feat.id);
      const fromSpecies = speciesSelected.includes(feat.id);
      const repeatable = isRepeatableOriginFeat(feat.id);
      const backgroundDisabled = fromSpecies && !repeatable;
      const speciesDisabled = fromBackground && !repeatable;
      const backgroundAlreadySelectedLabel = backgroundDisabled
        ? '<small class="origin-feat-already-selected">Уже выбрана своим происхождением</small>'
        : '';
      return `<tr class="${backgroundDisabled ? 'is-disabled' : ''} ${speciesDisabled ? 'is-cross-source-blocked' : ''}">
        <td class="origin-feat-name"><a href="/feats/${encodeURIComponent(feat.id)}" target="_blank" rel="noopener">${escapeHtml(feat.name)}</a><small>${escapeHtml(feat.nameEn || '')}</small>${backgroundAlreadySelectedLabel}</td>
        <td><input class="origin-feat-check" type="checkbox" autocomplete="off" data-origin-feat-source="background" value="${escapeHtml(feat.id)}" ${fromBackground ? 'checked' : ''} ${backgroundDisabled ? 'disabled title="Уже выбрана своим происхождением"' : ''} aria-label="${escapeHtml(feat.name)}: от предыстории"></td>
        ${speciesBonusFeat && !customLineage ? `<td><input class="origin-feat-check" type="checkbox" autocomplete="off" data-origin-feat-source="species" value="${escapeHtml(feat.id)}" ${fromSpecies ? 'checked' : ''} ${speciesDisabled ? 'disabled title="Уже выбрана в другой таблице"' : ''} aria-label="${escapeHtml(feat.name)}: от вида"></td>` : ''}
      </tr>`;
    }).join('');

    const renderCustomLineageTable = () => {
      if (!customSection || !customBody) return;
      customSection.hidden = !customLineage;
      if (!customLineage) return;
      const query = String(customSearch?.value || '').trim().toLocaleLowerCase('ru');
      const normalizeRequirements = (requirements) => {
        if (Array.isArray(requirements)) return requirements.join(' ');
        if (requirements == null) return '';
        return String(requirements);
      };
      const options = allSelectableFeatOptions.filter((feat) => {
        const haystack = `${feat.name || ''} ${feat.nameEn || ''} ${normalizeRequirements(feat.requirements)}`.toLocaleLowerCase('ru');
        return !query || haystack.includes(query);
      });
      if (customCounter) customCounter.textContent = `${speciesSelected.length}/1`;
      customBody.innerHTML = options.map((feat) => {
        const selected = speciesSelected.includes(feat.id);
        const repeatable = isRepeatableOriginFeat(feat.id);
        const selectedByBackground = backgroundSelected.includes(feat.id);
        const disabled = selectedByBackground && !repeatable;
        const isGeneralFeat = feat.type === 'general';
        const requirementItems = Array.isArray(feat.requirements)
          ? feat.requirements
          : feat.requirements
            ? [String(feat.requirements)]
            : [];
        const requirements = isGeneralFeat && requirementItems.length
          ? `<small class="origin-feat-requirements">${escapeHtml(requirementItems.join(' • '))}</small>`
          : '';
        const typeBadge = isGeneralFeat
          ? '<small class="origin-feat-type">Общая черта · повышение характеристик не применяется</small>'
          : '<small class="origin-feat-type origin-feat-type-origin">Черта происхождения</small>';
        const alreadySelectedLabel = disabled
          ? '<small class="origin-feat-already-selected">Уже выбрана от предыстории</small>'
          : '';
        return `<tr class="${isGeneralFeat ? 'origin-feat-general-row' : ''} ${selected ? 'is-selected' : ''} ${disabled ? 'is-disabled' : ''}">
          <td class="origin-feat-name"><a href="/feats/${encodeURIComponent(feat.id)}" target="_blank" rel="noopener">${escapeHtml(feat.name)}</a><small>${escapeHtml(feat.nameEn || '')}</small>${typeBadge}${requirements}${alreadySelectedLabel}</td>
          <td><input class="origin-feat-check" type="checkbox" autocomplete="off" data-origin-feat-source="species" value="${escapeHtml(feat.id)}" ${selected ? 'checked' : ''} ${disabled ? 'disabled title="Уже выбрана в другой таблице"' : ''} aria-label="${escapeHtml(feat.name)}: от Своего происхождения"></td>
        </tr>`;
      }).join('') || '<tr><td colspan="2" class="origin-feat-empty">По вашему запросу ничего не найдено.</td></tr>';
      bindOriginFeatInputs();
    };

    const selectOriginFeat = (source, value) => {
      const key = source === 'species' ? 'species:originFeat' : 'background:originFeat';
      const otherKey = source === 'species' ? 'background:originFeat' : 'species:originFeat';
      const current = state.choices[key]?.[0] || '';

      if ((state.choices[otherKey] || []).includes(value) && !isRepeatableOriginFeat(value)) {
        renderOriginFeats('Одну и ту же черту нельзя выбрать дважды. Исключение: «Одарённый» и «Посвящённый в магию».');
        return;
      }

      if (current) clearOriginFeatSourceChoices(source);

      // Единственный источник истины — state. DOM никогда не переключаем вручную.
      // Повторный клик по уже выбранной черте снимает выбор; клик по другой заменяет его.
      state.choices[key] = current === value ? [] : [value];
      state.choices['feat:skills'] = [];
      state.choices['feat:tools'] = [];
      state.choices['feat:languages'] = [];

      saveState();
      renderOriginFeats();
      updatePreview();
    };

    const bindOriginFeatContainer = (container) => {
      if (!container) return;

      // Используем click + preventDefault, чтобы браузер не успевал сам
      // поставить несколько галочек до перерисовки. Выбор вычисляется только из state.
      container.onclick = (event) => {
        const target = event.target;
        const input = target instanceof Element
          ? target.closest('[data-origin-feat-source]')
          : null;
        if (!(input instanceof HTMLInputElement)) return;

        event.preventDefault();
        event.stopPropagation();
        selectOriginFeat(input.dataset.originFeatSource, input.value);
      };

      container.onchange = null;
    };

    const bindOriginFeatInputs = () => {
      bindOriginFeatContainer(body);
      bindOriginFeatContainer(customBody);
    };

    warning.textContent = message;
    warning.hidden = !message;
    bindOriginFeatInputs();
    renderCustomLineageTable();
    if (customSearch) {
      // По той же причине не сохраняем старое замыкание поиска.
      customSearch.oninput = renderCustomLineageTable;
    }
    renderOriginFeatExtraChoices();
  }

  function renderOriginFeatExtraChoices() {
    const container = $('#origin-feats-extra-choices');
    if (!container) return;
    const magicEntries = selectedOriginFeatEntries().filter((entry) => entry.id === 'magic-initiate');
    const activeSources = new Set(magicEntries.map((entry) => entry.source));
    ['background', 'species'].forEach((source) => {
      if (!activeSources.has(source)) clearOriginFeatSourceChoices(source);
    });
    if (!magicEntries.length) {
      container.innerHTML = '';
      return;
    }
    const sourceNames = { background: 'от предыстории', species: 'от расы' };
    const choices = [];
    for (const entry of magicEntries) {
      choices.push({ id:`feat:${entry.source}:magic-list`, title:'Список заклинаний', description:'Выберите список Жреца, Друида или Волшебника. Заклинания из него появятся на этапе «Заклинания».', count:1, options:[{value:'cleric',label:'Жрец'},{value:'druid',label:'Друид'},{value:'wizard',label:'Волшебник'}], source:`Черта: ${entry.feat.name} (${sourceNames[entry.source]})` });
      choices.push({ id:`feat:${entry.source}:spell-ability`, title:'Заклинательная характеристика', description:'Выберите характеристику для заклинаний этой черты.', count:1, options:['Интеллект','Мудрость','Харизма'], source:`Черта: ${entry.feat.name} (${sourceNames[entry.source]})` });
    }
    renderBackgroundChoiceCards(container, choices);
  }

  function originFeatsComplete() {
    const backgroundId = state.choices['background:originFeat']?.[0];
    const speciesId = state.choices['species:originFeat']?.[0];
    const basicComplete = Boolean(backgroundId)
      && (!speciesGrantsExtraFeat() || Boolean(speciesId))
      && !(backgroundId && speciesId && backgroundId === speciesId && !isRepeatableOriginFeat(backgroundId));
    if (!basicComplete) return false;
    return selectedOriginFeatEntries()
      .filter((entry) => entry.id === 'magic-initiate')
      .every((entry) =>
        (state.choices[`feat:${entry.source}:magic-list`] || []).length === 1
        && (state.choices[`feat:${entry.source}:spell-ability`] || []).length === 1
      );
  }

  function renderBackgroundChoiceCards(container, choices) {
    if (!container) return;
    if (!choices.length) {
      container.innerHTML = '';
      return;
    }

    container.innerHTML = `
      <div class="inline-choice-title">
        <span class="section-kicker">Обязательные выборы</span>
        <h3>Заверши обязательные выборы</h3>
        <p>Выбранные значения сохраняются автоматически.</p>
      </div>
      <div class="pending-choices">
        ${choices.map((choice) => {
          const selected = Array.isArray(state.choices[choice.id]) ? state.choices[choice.id] : [];
          const options = normalizeOptions(choice.options);
          const isCharacteristicChoice = ['background:traits','background:ideal','background:bond','background:flaw'].includes(choice.id);
          return `
            <section class="pending-choice-card ${isCharacteristicChoice ? 'is-characteristic-list' : ''}">
              <div class="pending-choice-head">
                <div><span>${escapeHtml(choice.source)}</span><h3>${escapeHtml(choice.title)}</h3></div>
                <div class="choice-head-actions">
                  ${choice.randomizable ? `<button type="button" class="choice-random-button" data-random-choice="${escapeHtml(choice.id)}">Случайно</button>` : ''}
                  <strong>${selected.length}/${choice.count}</strong>
                </div>
              </div>
              <p>${escapeHtml(choice.description || '')}</p>
              <div class="${isCharacteristicChoice ? 'characteristic-option-list' : 'dynamic-option-grid'}">
                ${options.map((option, optionIndex) => {
                  const alignmentMarker = String(option.label || '').match(/\(([^)]+)\)\s*$/)?.[1] || '';
                  return `
                  <label class="${isCharacteristicChoice ? 'characteristic-option-row' : 'dynamic-option'} ${option.disabled ? 'is-disabled' : ''}" ${option.reason ? `title="${escapeHtml(option.reason)}"` : ''}>
                    <input type="${choice.count > 1 ? 'checkbox' : 'radio'}"
                      name="${escapeHtml(choice.id)}"
                      value="${escapeHtml(option.value)}"
                      data-background-choice="${escapeHtml(choice.id)}"
                      ${selected.includes(option.value) ? 'checked' : ''}
                      ${option.disabled ? 'disabled' : ''}>
                    ${isCharacteristicChoice ? `<span class="characteristic-number">${optionIndex + 1}</span>` : ''}
                    <span class="characteristic-option-copy">${escapeHtml(option.label)}</span>
                    ${alignmentMarker ? `<em class="alignment-requirement">${escapeHtml(alignmentMarker)}</em>` : ''}
                    ${option.disabled ? '<small>Недоступно</small>' : ''}
                  </label>`;
                }).join('')}
              </div>
              <div class="choice-error" data-choice-error="${escapeHtml(choice.id)}"></div>
            </section>
          `;
        }).join('')}
      </div>`;

    $$('[data-random-choice]').forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.randomChoice;
      const choice = choices.find((item) => item.id === id);
      if (!choice) return;
      const available = normalizeOptions(choice.options).filter((option) => !option.disabled);
      const shuffled = [...available].sort(() => Math.random() - 0.5);
      state.choices[id] = shuffled.slice(0, choice.count).map((option) => option.value);
      saveState();
      renderBackgroundDetails();
    }));

    $$('[data-background-choice]').forEach((input) => input.addEventListener('change', () => {
      const id = input.dataset.backgroundChoice;
      const choice = choices.find((item) => item.id === id);
      let selected = Array.isArray(state.choices[id]) ? [...state.choices[id]] : [];

      if (input.type === 'radio') selected = input.checked ? [input.value] : [];
      else if (input.checked) {
        if (selected.length >= choice.count) {
          input.checked = false;
          const error = $(`[data-choice-error="${id}"]`);
          if (error) error.textContent = `Можно выбрать только ${choice.count}.`;
          return;
        }
        if (!selected.includes(input.value)) selected.push(input.value);
      } else selected = selected.filter((value) => value !== input.value);

      state.choices[id] = selected;
      saveState();
      if (input.closest('#origin-feats-extra-choices')) renderOriginFeats();
      else renderBackgroundDetails();
    }));
  }


  function characteristicText(item, labelKey) {
    if (typeof item === 'string') return item;
    return item?.[labelKey] || item?.trait || item?.ideal || item?.bond || item?.flaw || item?.result || String(item || '');
  }

  function hasUsefulCharacteristics(items, labelKey) {
    return Array.isArray(items) && items.some((item) => {
      const text = characteristicText(item, labelKey).trim();
      return text && text !== '-';
    });
  }

  function alignmentTagsForCurrentCharacter() {
    const map = {
      'lawful-good': ['закон', 'добр'],
      'neutral-good': ['нейтрал', 'добр'],
      'chaotic-good': ['хаот', 'добр'],
      'lawful-neutral': ['закон', 'нейтрал'],
      'true-neutral': ['нейтрал'],
      'chaotic-neutral': ['хаот', 'нейтрал'],
      'lawful-evil': ['закон', 'зл'],
      'neutral-evil': ['нейтрал', 'зл'],
      'chaotic-evil': ['хаот', 'зл']
    };
    return map[state.alignment] || [];
  }

  function optionAllowedByAlignment(text) {
    const normalized = String(text || '').toLocaleLowerCase('ru').replace(/ё/g, 'е');
    const marker = normalized.match(/\(([^)]+)\)\s*$/)?.[1] || '';
    if (!marker || /любой|любое/.test(marker)) return true;
    const alignmentWords = ['закон', 'хаот', 'добр', 'зл', 'нейтрал'];
    const required = alignmentWords.filter((word) => marker.includes(word));
    if (!required.length) return true;
    const active = alignmentTagsForCurrentCharacter();
    return required.some((word) => active.includes(word));
  }

  function characteristicOptions(background, key, labelKey) {
    const own = background?.characteristics?.[key] || [];
    const source = hasUsefulCharacteristics(own, labelKey)
      ? own.filter((item) => characteristicText(item, labelKey).trim() !== '-')
      : GENERIC_BACKGROUND_CHARACTERISTICS[key] || [];
    return source.map((item) => {
      const text = characteristicText(item, labelKey);
      const allowed = optionAllowedByAlignment(text);
      return {
        value: text,
        label: text,
        disabled: !allowed,
        reason: allowed ? '' : `Недоступно для мировоззрения «${ALIGNMENTS[state.alignment] || 'не выбрано'}»`
      };
    });
  }


  function renderBackgroundDetails() {
    const container = $('#background-details');
    const background = findBackground();
    if (!container) return;

    if (!background) {
      container.innerHTML = `<div class="empty-state background-empty-state"><span>✧</span><h3>Выбери предысторию</h3><p>После выбора здесь появятся история, владения и все доступные настройки.</p></div>`;
      return;
    }

    const choices = [];

    if (background.variants?.table?.length) choices.push({ id:'background:variant', title:background.variants.title || 'Вариант предыстории', description:background.variants.description || '', count:1, options:background.variants.table.map((item)=>item.result), source:`Предыстория: ${background.name}` });
    choices.push({ id:'background:traits', title:'Черты характера', description:'Выберите две черты характера.', count:2, randomizable:true, options:characteristicOptions(background,'personalityTraits','trait'), source:`Предыстория: ${background.name}` });
    choices.push({ id:'background:ideal', title:'Идеал', description:'Выберите один идеал.', count:1, randomizable:true, options:characteristicOptions(background,'ideals','ideal'), source:`Предыстория: ${background.name}` });
    choices.push({ id:'background:bond', title:'Привязанность', description:'Выберите одну привязанность.', count:1, randomizable:true, options:characteristicOptions(background,'bonds','bond'), source:`Предыстория: ${background.name}` });
    choices.push({ id:'background:flaw', title:'Слабость', description:'Выберите одну слабость.', count:1, randomizable:true, options:characteristicOptions(background,'flaws','flaw'), source:`Предыстория: ${background.name}` });


    container.innerHTML = `
      <article class="background-profile">
        <header class="background-hero"><div><span class="source-label">${escapeHtml(background.sourceBook || 'Предыстория')}</span><div class="background-title-row"><h2>${escapeHtml(background.name)} <small>[${escapeHtml(background.nameEn || '')}]</small></h2><button class="button button-secondary button-small" type="button" id="change-background">Изменить</button></div><p>${escapeHtml(String(background.lore || '').split('\n').filter(Boolean)[0] || '')}</p></div><span class="background-rune">✧</span></header>
        <section class="content-section lore-section"><div class="content-section-heading"><span class="section-icon">◈</span><div><span class="section-kicker">Прошлая жизнь</span><h3>История персонажа</h3></div></div><div class="lore-preview">${loreToHtml(background.lore, 2)}</div><details class="full-lore"><summary>Показать полное описание</summary><div class="full-lore-content">${loreToHtml(background.lore)}</div></details></section>
        <section class="background-stats"><div><span>Навыки</span><strong>${escapeHtml(background.skills || '—')}</strong></div><div><span>Инструменты</span><strong>${escapeHtml(background.tools || '—')}</strong></div><div><span>Черта</span><strong>Выбирается на следующем этапе</strong></div></section>
        <section class="content-section background-rewards"><div class="content-section-heading"><span class="section-icon">✦</span><div><span class="section-kicker">Наследие прошлого</span><h3>Снаряжение и особенности</h3></div></div><div class="background-reward-grid"><article><span>Снаряжение</span><strong>${escapeHtml(background.equipment || '—')}</strong></article><article><span>Выбранный вариант</span><strong>${escapeHtml(state.choices['background:variant']?.[0] || '—')}</strong></article></div></section>
        ${background.spellTable ? `<section class="content-section background-spells"><div class="content-section-heading"><span class="section-icon">✺</span><div><span class="section-kicker">Магия</span><h3>${escapeHtml(background.spellTable.name || 'Заклинания')}</h3></div></div><p>${escapeHtml(background.spellTable.description || '')}</p><div class="spell-table-list">${(background.spellTable.spells || []).map((row)=>`<p><strong>${escapeHtml(row.level || '')}</strong><span>${escapeHtml((row.spells || []).join(', '))}</span></p>`).join('')}</div></section>` : ''}
        <section class="content-section background-choices-section"><div id="background-rule-choices"></div></section>
      </article>`;

    renderBackgroundChoiceCards($('#background-rule-choices'), choices);
    $('#change-background')?.addEventListener('click', () => $('#background-picker')?.scrollIntoView({ behavior:'smooth', block:'start' }));
    updatePreview();
    saveState();
  }

  function updatePreview() {
    const species = findSpecies();
    const variant = findVariant(species);
    const characterClass = findClass();
    const background = findBackground();

    $('#preview-name').textContent = state.name.trim() || 'Безымянный герой';
    $('#preview-species').textContent =
      [species?.name, variant?.name].filter(Boolean).join(' — ') || '—';

    const previewClass = $('#preview-class');
    if (previewClass) previewClass.textContent = characterClass?.name || '—';

    const previewBackground = $('#preview-background');
    if (previewBackground) previewBackground.textContent = background?.name || '—';

    const portrait = $('#preview-portrait');
    if (portrait) {
      const nextPortrait = characterClass?.portrait || species?.portrait || '/images/classes/fighter.png';
      if (portrait.getAttribute('src') !== nextPortrait) {
        portrait.src = nextPortrait;
      }
    }

    $('#preview-physique').textContent =
      state.physique.heightInches && state.physique.weightPounds
        ? `${Math.floor(state.physique.heightInches / 12)}′ ${
            state.physique.heightInches % 12
          }″ · ${state.physique.weightPounds} фун.`
        : '—';

    $$('.species-card').forEach((card) => {
      card.classList.toggle('is-selected', card.dataset.speciesId === state.species);
    });

    $$('.class-card').forEach((card) => {
      card.classList.toggle('is-selected', card.dataset.classId === state.class);
    });

    $$('.background-card').forEach((card) => {
      card.classList.toggle('is-selected', card.dataset.backgroundId === state.background);
    });

    saveState();
  }


  const modifier = (score) => getStateModule().modifier(score);
  const formatModifier = (value) => value >= 0 ? `+${value}` : String(value).replace('-', '−');
  const usedPointBuy = () => getStateModule().usedPointBuy(state, COST_TABLE);
  const usedBackgroundBonus = () => getStateModule().usedBackgroundBonus(state);
  const totalScore = (key) => getStateModule().totalScore(state, key);

  function renderAbilities(message = '') {
    const point = $('#point-buy-remaining'); if (point) point.textContent = String(27 - usedPointBuy());
    const bonus = $('#background-bonus-remaining'); if (bonus) bonus.textContent = String(3 - usedBackgroundBonus());
    abilityKeys.forEach((key) => {
      const item = state.abilities[key], total = totalScore(key);
      const base = $(`[data-base-value="${key}"]`); if (base) base.textContent = String(item.base);
      const bon = $(`[data-bonus-value="${key}"]`); if (bon) bon.textContent = item.bonus ? `+${item.bonus}` : '0';
      const totalEl = $(`[data-total-value="${key}"]`); if (totalEl) totalEl.textContent = String(total);
      const mod = $(`[data-modifier="${key}"]`); if (mod) mod.textContent = formatModifier(modifier(total));
    });
    const warning = $('#ability-warning'); if (warning) { warning.textContent = message; warning.hidden = !message; }
  }
  function changeBase(key, change) {
    const current = state.abilities[key].base, next = current + change;
    if (next < 8 || next > 15) return;
    const nextCost = usedPointBuy() - COST_TABLE[current] + COST_TABLE[next];
    if (nextCost > 27) return renderAbilities('Недостаточно очков Point Buy. Максимум — 27.');
    state.abilities[key].base = next; renderAbilities(); saveState();
  }
  function changeBonus(key, change) {
    const current = state.abilities[key].bonus, next = current + change;
    if (next < 0 || next > 2) return;
    if (usedBackgroundBonus() - current + next > 3) return renderAbilities('Все 3 очка бонуса предыстории уже распределены.');
    state.abilities[key].bonus = next; renderAbilities(); saveState();
  }

  function getMagicInitiateEntries() {
    return selectedOriginFeatEntries()
      .filter((entry) => entry.id === 'magic-initiate')
      .map((entry) => ({
        ...entry,
        listId: state.choices[`feat:${entry.source}:magic-list`]?.[0] || null,
        ability: state.choices[`feat:${entry.source}:spell-ability`]?.[0] || null
      }));
  }

  function ensureSpellSourceState() {
    if (!state.spells || typeof state.spells !== 'object') state.spells = {};
    if (!state.spells.sources || typeof state.spells.sources !== 'object') state.spells.sources = {};
    if (!Array.isArray(state.spells.cantrips)) state.spells.cantrips = [];
    if (!Array.isArray(state.spells.level1)) state.spells.level1 = [];
  }

  function spellByName(name, level = null) {
    const normalized = normalizeSpellNameClient(name);
    const pools = Object.values(classSpellOptions).flat();
    return pools.find((spell) => normalizeSpellNameClient(spell.name) === normalized && (!level || spell.level === level)) || null;
  }

  function uniqueSpells(items) {
    return Array.from(new Map(items.filter(Boolean).map((spell) => [`${spell.level}:${spell.id}`, spell])).values())
      .sort((a,b)=>String(a.name).localeCompare(String(b.name),'ru'));
  }

  function getSpeciesSpellSource() {
    const species = findSpecies();
    if (!species) return null;

    const variant = findVariant(species);
    const abilities = getEffectiveAbilities(species, variant);
    const abilityText = abilities
      .map((ability) => `${ability?.title || ''} ${ability?.description || ''}`)
      .join(' ')
      .toLocaleLowerCase('ru');

    const allCantrips = uniqueSpells(Object.values(classSpellOptions)
      .flat()
      .filter((spell) => spell.level === 'cantrip'));

    // В расовых описаниях заклинания часто записаны обычным текстом.
    // Берём только формулировки «знаете/изучаете заговор», чтобы не
    // подтягивать заклинания 3-го и 5-го уровней из таблиц происхождения.
    const explicitlyKnown = allCantrips.filter((spell) => {
      const name = String(spell.name || '').toLocaleLowerCase('ru');
      return abilityText.includes(`знаете заговор ${name}`)
        || abilityText.includes(`изучаете заговор ${name}`)
        || abilityText.includes(`знаете заговором ${name}`)
        || abilityText.includes(`изучаете заговором ${name}`);
    });

    const speciesName = `${species.id || ''} ${species.name || ''} ${species.nameEn || ''}`;
    const isTiefling = /tiefling|тифлинг/i.test(speciesName);

    if (isTiefling && !variant) {
      const tieflingLineages = [
        {
          spell: spellByName('Ядовитые брызги', 'cantrip'),
          choiceLabel: 'Происхождение Бездны',
          choiceDescription: 'Сопротивление урону ядом'
        },
        {
          spell: spellByName('Леденящее прикосновение', 'cantrip'),
          choiceLabel: 'Хтоническое происхождение',
          choiceDescription: 'Сопротивление урону некротической энергией'
        },
        {
          spell: spellByName('Огненный снаряд', 'cantrip'),
          choiceLabel: 'Инфернальное происхождение',
          choiceDescription: 'Сопротивление урону огнём'
        }
      ];
      const lineageCantrips = uniqueSpells(tieflingLineages.map(({ spell, choiceLabel, choiceDescription }) =>
        spell ? { ...spell, choiceLabel, choiceDescription } : null
      ));
      const thaumaturgy = spellByName('Чудотворство', 'cantrip');

      return {
        id: 'species-tiefling-lineage',
        category: 'Вид',
        title: 'Тифлинг — происхождение исчадия',
        description: 'Выбор заговора одновременно определяет происхождение исчадия и соответствующее сопротивление. Чудотворство получено автоматически.',
        limits: { cantrip: 1, level1: 0 },
        fixed: uniqueSpells([thaumaturgy]),
        options: lineageCantrips
      };
    }

    if (!explicitlyKnown.length) return null;

    return {
      id: `species-${species.id || 'selected'}`,
      category: 'Вид',
      title: [species.name, variant?.name].filter(Boolean).join(' — '),
      description: 'Заклинания и заговоры, автоматически полученные от выбранного вида.',
      limits: { cantrip: 0, level1: 0 },
      fixed: explicitlyKnown,
      options: []
    };
  }

  function magicInitiateSourceLabel(listId) {
    return ({ cleric: 'ПВМ_Ж', druid: 'ПВМ_Д', wizard: 'ПВМ_В' })[listId] || 'ПВМ';
  }

  function withSpellAvailability(spells, label) {
    return (spells || []).filter(Boolean).map((spell) => ({
      ...spell,
      availabilityLabel: label
    }));
  }

  function getSpellSources() {
    ensureSpellSourceState();
    const sources = [];
    const rawBase = classSpellLimits[state.class] || { cantrips:0, level1:0 };
    const base = { ...rawBase, cantrips: Number(rawBase.cantrips || 0) + classFeatureExtraCantrips(state.class) };
    const background = findBackground();
    const className = findClass()?.name || 'Класс';
    let classOptions = withSpellAvailability(classSpellOptions[state.class] || [], `Класс: ${className}`);
    const backgroundLevel1Names = (background?.spellTable?.spells || [])
      .filter((row) => /1/.test(String(row.level || '')))
      .flatMap((row) => row.spells || []);
    const backgroundAdded = uniqueSpells(withSpellAvailability(
      backgroundLevel1Names.map((name)=>spellByName(name,'1')),
      `Предыстория: ${background?.name || 'не указана'}`
    ));
    classOptions = uniqueSpells([...classOptions, ...backgroundAdded]);
    if (Number(base.cantrips||0) || Number(base.level1||0)) sources.push({
      id:'class', category:'Класс', title:className, spellLabel:`Класс: ${className}`, description:backgroundAdded.length ? `Список класса дополнен заклинаниями предыстории «${background?.name}».` : 'Заклинания, доступные выбранному классу на 1 уровне.',
      limits:{cantrip:Number(base.cantrips||0), level1:Number(base.level1||0)}, options:classOptions
    });

    const speciesSource = getSpeciesSpellSource();
    if (speciesSource) {
      const label = `Вид: ${speciesSource.title}`;
      sources.push({
        ...speciesSource,
        spellLabel: label,
        fixed: withSpellAvailability(speciesSource.fixed || [], label),
        options: withSpellAvailability(speciesSource.options || [], label)
      });
    }

    for (const entry of getMagicInitiateEntries()) {
      if (!entry.listId) continue;
      const sourceLabel = magicInitiateSourceLabel(entry.listId);
      sources.push({ id:`feat-${entry.source}`, category:'Черта', title:`${entry.feat.name}: ${entry.listId}`, spellLabel:sourceLabel, description:`Заклинательная характеристика: ${entry.ability || 'не выбрана'}.`, limits:{cantrip:2,level1:1}, options:uniqueSpells(withSpellAvailability(magicInitiateSpellOptions[entry.listId] || [], sourceLabel)) });
    }

    const feats = selectedOriginFeatEntries();
    const hasFeat = (id) => feats.some((entry)=>entry.id===id);
    if (hasFeat('scion-of-the-outer-planes')) {
      const names=['Малая иллюзия','Леденящее прикосновение','Священное пламя','Указание','Волшебная рука'];
      sources.push({id:'feat-scion',category:'Черта',title:'Наследник внешних планов',spellLabel:'Черта: Наследник внешних планов',description:'Выберите заговор, соответствующий выбранному плану.',limits:{cantrip:1,level1:0},options:uniqueSpells(names.map((n)=>spellByName(n,'cantrip')))});
    }
    if (hasFeat('initiate-of-high-sorcery')) {
      const lunar=['Диссонирующий шёпот','Псевдожизнь','Сглаз','Луч болезни','Сверкающие брызги','Маскировка','Падение пёрышком','Скороход','Понимание языков','Обнаружение зла и добра','Защита от зла и добра','Щит'];
      sources.push({id:'feat-high-sorcery',category:'Черта',title:'Посвящённый в Высшее волшебство',spellLabel:'Черта: Посвящённый в Высшее волшебство',description:'Выберите 1 заговор волшебника и 2 заклинания выбранной луны.',limits:{cantrip:1,level1:2},options:uniqueSpells([...(classSpellOptions.wizard||[]).filter((s)=>s.level==='cantrip'),...lunar.map((n)=>spellByName(n,'1'))])});
    }
    if (hasFeat('rune-shaper')) {
      const runeNames=['Маскировка','Опутывание','Цветной шарик','Псевдожизнь','Приказ','Усыпление','Сглаз','Лечение ран'];
      sources.push({id:'feat-rune-shaper',category:'Черта',title:'Ваятель рун',spellLabel:'Черта: Ваятель рун',description:'Понимание языков известно автоматически; выберите 1 руническое заклинание.',limits:{cantrip:0,level1:1},fixed:uniqueSpells([spellByName('Понимание языков','1')]),options:uniqueSpells(runeNames.map((n)=>spellByName(n,'1')))});
    }
    if (hasFeat('strixhaven-initiate')) {
      const bgName=String(background?.name||'');
      const college=/Лорхолд/i.test(bgName)?'Лорхолд':/Призмари/i.test(bgName)?'Призмари':/Квандрикс/i.test(bgName)?'Квандрикс':/Сильверквилл/i.test(bgName)?'Сильверквилл':/Визерблум/i.test(bgName)?'Визерблум':null;
      const cfg={
        'Лорхолд':[['Свет','Священное пламя','Чудотворство'],['cleric','wizard']],
        'Призмари':[['Огненный снаряд','Фокусы','Луч холода'],['bard','sorcerer']],
        'Квандрикс':[['Искусство друидов','Указание','Волшебная рука'],['druid','wizard']],
        'Сильверквилл':[['Священное пламя','Чудотворство','Злая насмешка'],['bard','cleric']],
        'Визерблум':[['Искусство друидов','Уход за умирающим','Леденящее прикосновение'],['druid','wizard']]
      }[college] || [[],[]];
      const opts=[...cfg[0].map((n)=>spellByName(n,'cantrip')),...cfg[1].flatMap((id)=>(classSpellOptions[id]||[]).filter((s)=>s.level==='1'))];
      sources.push({id:'feat-strixhaven',category:'Черта',title:`Поступивший в Стриксхейвен${college?` (${college})`:''}`,spellLabel:`Предыстория: ${background?.name || (college ? `Студент ${college}` : 'Стриксхейвен')}`,description:'Выберите 2 заговора факультета и 1 заклинание 1 уровня из разрешённых списков.',limits:{cantrip:2,level1:1},options:uniqueSpells(opts)});
    }
    const invocation = selectedClassFeatureOption('eldritch-invocation');
    if (invocation === 'pact-of-the-tome') {
      const allSpellOptions = uniqueSpells(Object.values(classSpellOptions).flat());
      sources.push({
        id: 'class-feature-pact-tome',
        category: 'Умение класса',
        title: 'Договор гримуара',
        spellLabel: 'Умение класса: Договор гримуара',
        description: 'Выберите 3 заговора и 2 ритуальных заклинания 1 уровня для Книги теней.',
        limits: { cantrip: 3, level1: 2 },
        options: allSpellOptions
      });
    }
    if (invocation === 'pact-of-the-chain') {
      const familiar = spellByName('Поиск фамильяра', '1');
      if (familiar) sources.push({
        id: 'class-feature-pact-chain', category: 'Умение класса', title: 'Договор цепи', spellLabel: 'Умение класса: Договор цепи',
        description: 'Заклинание «Поиск фамильяра» получено от Таинственного воззвания.',
        limits: { cantrip: 0, level1: 0 }, fixed: [familiar], options: []
      });
    }
    if (invocation === 'armor-of-shadows') {
      const mageArmor = spellByName('Доспех мага', '1');
      if (mageArmor) sources.push({
        id: 'class-feature-armor-shadows', category: 'Умение класса', title: 'Доспехи теней', spellLabel: 'Умение класса: Доспехи теней',
        description: 'Вы можете накладывать «Доспех мага» на себя без траты ячейки заклинаний.',
        limits: { cantrip: 0, level1: 0 }, fixed: [mageArmor], options: []
      });
    }
    return sources;
  }

  function syncLegacySpellBuckets() {
    ensureSpellSourceState();
    const sources=getSpellSources();
    const all=[];
    for (const source of sources) {
      const selected=state.spells.sources[source.id] || {cantrip:[],level1:[]};
      all.push(...(source.fixed||[]), ...source.options.filter((spell)=>{ const bucketKey = spell.level === '1' ? 'level1' : spell.level; return (selected[bucketKey]||[]).includes(spell.id); }));
    }
    state.spells.cantrips=uniqueSpells(all.filter((s)=>s.level==='cantrip')).map((s)=>s.id);
    state.spells.level1=uniqueSpells(all.filter((s)=>s.level==='1')).map((s)=>s.id);
  }

  function getSpellLimits() {
    return getSpellSources().reduce((acc,source)=>({cantrips:acc.cantrips+source.limits.cantrip,level1:acc.level1+source.limits.level1}),{cantrips:0,level1:0});
  }

  function getClassSpells() { return uniqueSpells(getSpellSources().flatMap((source)=>[...(source.options||[]),...(source.fixed||[])])); }


  function skillsMentioned(value) {
    const text = String(value || '').toLocaleLowerCase('ru').replace(/ё/g, 'е');
    return creatorOptions.allSkills.filter((skill) => (SKILL_ALIASES[skill] || [skill.toLocaleLowerCase('ru')]).some((alias) => text.includes(alias)));
  }


  function selectedSkilledFeatCount() {
    return selectedOriginFeats().filter((feat) => {
      const id = String(feat?.id || '').toLocaleLowerCase('ru');
      const name = String(feat?.name || '').toLocaleLowerCase('ru');
      return id === 'skilled' || /одар[её]нн|умелост/.test(name);
    }).length;
  }

  function skilledSharedChoiceLimit() {
    return selectedSkilledFeatCount() * 3;
  }

  function skilledSharedSelectedCount() {
    const skills = Array.isArray(state.choices['feat:skills']) ? state.choices['feat:skills'] : [];
    const tools = Array.isArray(state.choices['feat:tools']) ? state.choices['feat:tools'] : [];
    return new Set([...skills, ...tools]).size;
  }

  function getFeatSkillConfiguration() {
    const feats = selectedOriginFeats();
    if (!feats.length) return { key: 'feat:skills', count: 0, allowed: [] };
    let count = 0;
    const allowed = new Set();
    for (const feat of feats) {
      const featText = [feat.name, ...(feat.effects || [])].join(' ');
      const mentioned = skillsMentioned(featText);
      const normalizedId = String(feat.id || '').toLowerCase();
      const normalizedName = String(feat.name || '').toLocaleLowerCase('ru');
      if (normalizedId === 'skilled' || /одар[её]нн|умелост/.test(normalizedName)) {
        count += 3;
        creatorOptions.allSkills.forEach((skill) => allowed.add(skill));
        continue;
      }
      const countMatch = featText.match(/(?:владение|выберите|получаете)[^.!?]{0,70}?(\d+)\s+(?:люб(?:ым|ыми)?\s+)?навык/i);
      const hasChoice = /навык[^.!?]{0,45}(?:на выбор|любой|любых)/i.test(featText);
      const featCount = countMatch ? Number(countMatch[1]) : (mentioned.length ? mentioned.length : (hasChoice ? 1 : 0));
      count += featCount;
      (mentioned.length && !hasChoice ? mentioned : (featCount ? creatorOptions.allSkills : [])).forEach((skill) => allowed.add(skill));
    }
    return {
      key: 'feat:skills',
      count,
      allowed: [...allowed],
      sharedSkilledLimit: skilledSharedChoiceLimit()
    };
  }

  function getSkillConfiguration() {
    const characterClass = findClass();
    const background = findBackground();
    const species = findSpecies();
    const variant = findVariant(species);
    const classDescription = characterClass?.proficiencies?.skills?.description || '';
    const backgroundDescription = background?.skills || '';
    const speciesFeatures = getEffectiveAbilities(species, variant);

    const classCount = Number(characterClass?.proficiencies?.skills?.count || 0);
    const backgroundCount = Number(background?.skillCount || 0);

    // Учитываем только те особенности вида, которые действительно дают владение навыком.
    // Простое упоминание навыка в описании особенности больше не считается владением.
    const speciesSkillFeatures = speciesFeatures.filter((feature) => {
      const text = `${feature?.title || ''} ${feature?.description || ''}`.toLocaleLowerCase('ru').replace(/ё/g, 'е');
      return /(?:владеете|владение|получаете владение|обучены|выберите)[^.!?]{0,90}навык|навык[^.!?]{0,70}(?:владение|на выбор|любой)/i.test(text);
    });
    const speciesSkillText = speciesSkillFeatures.map((feature) => `${feature?.title || ''} ${feature?.description || ''}`).join(' ');
    const speciesMatches = skillsMentioned(speciesSkillText);

    // Поддерживаем как цифры, так и словесные количества:
    // «владение одним навыком», «двумя навыками» и т. п.
    const speciesCountMatch = speciesSkillText.match(
      /(?:владение|выберите|получаете|владеете|получаете владение)[^.!?]{0,90}?(\d+|один|одним|одного|одну|два|двумя|двух|три|тремя|трёх)\s+(?:люб(?:ым|ыми|ого)?\s+)?(?:навык|навыком|навыками|навыка|навыков)/i
    );

    const speciesCountWords = {
      один: 1,
      одним: 1,
      одного: 1,
      одну: 1,
      два: 2,
      двумя: 2,
      двух: 2,
      три: 3,
      тремя: 3,
      трёх: 3
    };

    const parsedSpeciesCount = speciesCountMatch
      ? Number(speciesCountMatch[1]) || speciesCountWords[String(speciesCountMatch[1]).toLocaleLowerCase('ru')] || 0
      : 0;

    const speciesHasChoice =
      /(?:выберите|на выбор|люб(?:ой|ого|ым))[^.!?]{0,90}(?:навык|навыком|навыка)|(?:навык|навыком|навыка)[^.!?]{0,70}(?:на выбор|любой|любого)/i.test(speciesSkillText)
      || /(?:владение|получаете владение)[^.!?]{0,70}(?:одним|одного|1)\s+навык/i.test(speciesSkillText);

    let speciesCount = parsedSpeciesCount || (speciesHasChoice ? 1 : speciesMatches.length);
    if (isCustomLineageSpecies()) {
      speciesCount = (state.choices['species:customLineageFeature'] || [])[0] === 'skill' ? 1 : 0;
    }

    const classMatches = skillsMentioned(classDescription);
    const explicitClassOptions = CLASS_SKILL_OPTIONS[String(state.class || '').toLowerCase()];
    const classAllowed = Array.isArray(explicitClassOptions) ? explicitClassOptions : classMatches;
    const backgroundAllowed = skillsMentioned(backgroundDescription);

    return {
      class: { key: 'class:skills', count: classCount, allowed: classAllowed },
      background: { key: 'background:skills', count: backgroundCount, allowed: backgroundAllowed.length ? backgroundAllowed : (backgroundCount ? creatorOptions.allSkills : []) },
      species: { key: 'species:skill', count: speciesCount, allowed: isCustomLineageSpecies() ? (speciesCount ? creatorOptions.allSkills : []) : (speciesMatches.length && !speciesHasChoice ? speciesMatches : (speciesCount ? creatorOptions.allSkills : [])) },
      feat: getFeatSkillConfiguration()
    };
  }

  function renderSkills(message = '') {
    const body = $('#skills-table-body');
    const summary = $('#skills-summary');
    const warning = $('#skills-warning');
    if (!body || !summary || !warning) return;
    const config = getSkillConfiguration();
    const sources = [
      ['class', 'Класс'], ['background', 'Предыстория'], ['species', 'Вид'], ['feat', 'Черта']
    ];

    for (const [source] of sources) {
      const item = config[source];
      const current = Array.isArray(state.choices[item.key]) ? state.choices[item.key] : [];
      const filtered = current.filter((skill) => item.allowed.includes(skill));
      state.choices[item.key] = source === 'feat' && item.sharedSkilledLimit
        ? filtered.slice(0, item.sharedSkilledLimit)
        : filtered.slice(0, item.count);
    }

    summary.innerHTML = sources.map(([source, label]) => {
      const item = config[source];
      const selected = state.choices[item.key] || [];
      const shownCount = source === 'feat' && item.sharedSkilledLimit
        ? skilledSharedSelectedCount()
        : selected.length;
      const shownLimit = source === 'feat' && item.sharedSkilledLimit
        ? item.sharedSkilledLimit
        : item.count;
      return `<div class="skills-summary-card"><span>${label}</span><strong>${shownCount}/${shownLimit}</strong></div>`;
    }).join('');

    body.innerHTML = creatorOptions.allSkills.map((skill) => {
      const cells = sources.map(([source]) => {
        const item = config[source];
        const selected = (state.choices[item.key] || []).includes(skill);
        const available = item.allowed.includes(skill) && item.count > 0;
        if (!available) {
          return '<td class="skill-unavailable"><span class="skill-unavailable-mark" aria-hidden="true">—</span></td>';
        }
        return `<td><input class="skill-source-check" type="checkbox" data-skill-source="${source}" value="${escapeHtml(skill)}" ${selected ? 'checked' : ''} aria-label="${escapeHtml(skill)}: ${source}"></td>`;
      }).join('');
      return `<tr><td class="skill-name">${escapeHtml(skill)}</td>${cells}</tr>`;
    }).join('');

    warning.textContent = message;
    warning.hidden = !message;

    $$('[data-skill-source]').forEach((input) => input.addEventListener('change', () => {
      const source = input.dataset.skillSource;
      const skill = input.value;
      const item = config[source];
      for (const [otherSource] of sources) {
        const other = config[otherSource];
        state.choices[other.key] = (state.choices[other.key] || []).filter((value) => value !== skill);
      }
      if (input.checked) {
        const selected = state.choices[item.key] || [];
        if (source === 'feat' && item.sharedSkilledLimit) {
          if (skilledSharedSelectedCount() >= item.sharedSkilledLimit) {
            renderSkills(`Черта «Одарённый» уже дала ${item.sharedSkilledLimit} владения навыками или инструментами.`);
            return;
          }
        } else if (selected.length >= item.count) {
          renderSkills(`Для источника «${sources.find(([id]) => id === source)?.[1]}» уже выбрано максимальное количество навыков.`);
          return;
        }
        state.choices[item.key] = [...selected, skill];
      }
      saveState();
      renderSkills();
    }));
  }

  function skillsComplete() {
    const config = getSkillConfiguration();
    return ['class', 'background', 'species', 'feat'].every((source) => {
      if (source === 'feat' && config.feat.sharedSkilledLimit) {
        return skilledSharedSelectedCount() === config.feat.sharedSkilledLimit;
      }
      return (state.choices[config[source].key] || []).length === config[source].count;
    });
  }


  function getKnownSkills() {
    return [...new Set([
      ...(state.choices['class:skills'] || []),
      ...(state.choices['background:skills'] || []),
      ...(state.choices['species:skill'] || []),
      ...(state.choices['feat:skills'] || [])
    ])];
  }

  function getExpertiseConfiguration() {
    const characterClass = findClass();
    const classId = String(characterClass?.id || state.class || '').toLocaleLowerCase('ru');
    const className = `${characterClass?.name || ''} ${characterClass?.nameEn || ''}`.toLocaleLowerCase('ru');
    const isRogue = classId === 'rogue' || classId === 'плут' || /(?:^|\\s)плут(?:$|\\s)|rogue/.test(className);
    return {
      key: 'class:expertise',
      count: isRogue ? 2 : 0,
      allowed: isRogue ? getKnownSkills() : []
    };
  }

  function renderExpertise(message = '') {
    const root = $('#expertise-options');
    const empty = $('#expertise-empty');
    const summary = $('#expertise-summary');
    const warning = $('#expertise-warning');
    if (!root || !empty || !summary || !warning) return;

    const config = getExpertiseConfiguration();
    const current = Array.isArray(state.choices[config.key]) ? state.choices[config.key] : [];
    state.choices[config.key] = current.filter((skill) => config.allowed.includes(skill)).slice(0, config.count);

    const hasChoice = config.count > 0;
    empty.hidden = hasChoice;
    root.hidden = !hasChoice;
    summary.hidden = !hasChoice;

    if (!hasChoice) {
      root.innerHTML = '';
      warning.hidden = true;
      return;
    }

    summary.innerHTML = `<span>Компетентность</span><strong>${state.choices[config.key].length}/${config.count}</strong>`;
    root.innerHTML = config.allowed.map((skill) => {
      const checked = state.choices[config.key].includes(skill);
      const recommended = ['Ловкость рук', 'Скрытность'].includes(skill);
      return `<label class="expertise-option ${checked ? 'is-selected' : ''}">
        <input type="checkbox" data-expertise-skill value="${escapeHtml(skill)}" ${checked ? 'checked' : ''}>
        <span><strong>${escapeHtml(skill)}</strong>${recommended ? '<small>Рекомендуется плуту</small>' : '<small>Навык, которым вы владеете</small>'}</span>
      </label>`;
    }).join('') || '<p class="expertise-no-skills">Сначала выберите навыки, которыми владеет персонаж.</p>';

    warning.textContent = message;
    warning.hidden = !message;

    $$('[data-expertise-skill]').forEach((input) => input.addEventListener('change', () => {
      const selected = state.choices[config.key] || [];
      if (input.checked) {
        if (selected.length >= config.count) {
          renderExpertise(`Можно выбрать только ${config.count} навыка с компетентностью.`);
          return;
        }
        state.choices[config.key] = [...selected, input.value];
      } else {
        state.choices[config.key] = selected.filter((skill) => skill !== input.value);
      }
      saveState();
      renderExpertise();
    }));
  }

  function expertiseComplete() {
    const config = getExpertiseConfiguration();
    return (state.choices[config.key] || []).length === config.count;
  }

  function languageNumberFromText(value) {
    const text = String(value ?? '').toLocaleLowerCase('ru');
    if (/\b(?:3|три|трёх|тремя)\b/.test(text)) return 3;
    if (/\b(?:2|два|две|двух|двумя)\b/.test(text)) return 2;
    return 1;
  }

  function parseLanguageSource(value) {
    const text = String(value ?? '');
    const lower = text.toLocaleLowerCase('ru').replace(/ё/g, 'е');
    const allLanguages = [...creatorOptions.standardLanguages, ...creatorOptions.rareLanguages];

    // Название языка учитывается только в предложении, где действительно говорится
    // о знании, выборе или доступности языка. Это не позволяет словам вроде
    // «Бездны» в названии наследия тифлинга случайно открыть язык Бездны.
    const languageSentences = text
      .split(/[.!?;\n]+/)
      .map((sentence) => sentence.trim())
      .filter((sentence) => /язык|владеете|владение|вы знаете|известен вам|доступн/i.test(sentence));
    const languageRulesText = languageSentences.join('. ');
    const languageRulesLower = languageRulesText.toLocaleLowerCase('ru').replace(/ё/g, 'е');
    const mentioned = allLanguages.filter((language) =>
      languageRulesLower.includes(language.toLocaleLowerCase('ru').replace(/ё/g, 'е'))
    );

    const availabilityOnly = /среди доступных языков.{0,80}(?:к выбору|для выбора)|доступн(?:ым|ые|ых).{0,40}язык/i.test(languageRulesText);

    let bonusChoices = 0;
    const explicitBonus = languageRulesText.match(/(?:ещ[её]|дополнительно)\s+(один|1|два|2|три|3)\s+язык[^.!?]{0,35}(?:на выбор|из таблицы)/i);
    if (explicitBonus) bonusChoices = languageNumberFromText(explicitBonus[1]);
    else if (!availabilityOnly) {
      const chooseMatch = languageRulesText.match(/(?:выберите|можете выбрать|получаете владение)\s+(один|1|два|2|три|3)\s+(?:дополнительн(?:ый|ых)\s+)?язык/i);
      if (chooseMatch) bonusChoices = languageNumberFromText(chooseMatch[1]);
    }

    const fixed = [];
    for (const language of mentioned) {
      const escaped = language.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const knownPattern = new RegExp(`(?:вы знаете|известен вам|получаете владение(?: языком)?|владеете)\\s+(?:языком\\s+)?${escaped}`, 'i');
      if (knownPattern.test(languageRulesText) && !availabilityOnly) fixed.push(language);
    }

    if (/вы знаете\s+воровской жаргон/i.test(languageRulesText) && !fixed.includes('Воровской жаргон')) {
      fixed.push('Воровской жаргон');
    }

    const unlockedRare = mentioned.filter((language) => creatorOptions.rareLanguages.includes(language));
    const allowAnyRare = /редк|экзотическ|любой язык|любого языка/i.test(languageRulesText);

    return {
      bonusChoices,
      fixed: [...new Set(fixed)],
      unlockedRare: allowAnyRare ? [...creatorOptions.rareLanguages] : [...new Set(unlockedRare)]
    };
  }

  const musicalToolNames = ['Виола','Волынка','Барабан','Лира','Лютня','Рожок','Свирель','Флейта','Цимбалы','Шалмей'];
  const gamingToolNames = ['Драконьи шахматы','Игральные карты','Кости','Ставка трёх драконов'];

  function clientToolOptionsFromDescription(value) {
    const text = String(value ?? '').toLocaleLowerCase('ru');
    if (!text.trim()) return [];

    const options = new Set();
    const hasArtisan = /ремеслен|artisan/.test(text);
    const hasMusical = /музыкальн|инструмент[^.!?]{0,70}музык/.test(text);
    const hasGaming = /игров|набор[^.!?]{0,70}игр/.test(text);
    const hasAny = /люб(?:ой|ого|ым|ыми)\s+(?:инструмент|набор)|инструмент\s+по\s+вашему\s+выбору/.test(text);

    if (hasAny && !hasArtisan && !hasMusical && !hasGaming) {
      return [...creatorOptions.allTools];
    }
    if (hasArtisan) creatorOptions.artisanTools.forEach((tool) => options.add(tool));
    if (hasMusical) musicalToolNames.forEach((tool) => options.add(tool));
    if (hasGaming) gamingToolNames.forEach((tool) => options.add(tool));

    creatorOptions.allTools
      .filter((tool) => text.includes(tool.toLocaleLowerCase('ru')))
      .forEach((tool) => options.add(tool));

    return options.size ? [...options] : [...creatorOptions.allTools];
  }

  function sourceTextForLanguages(source) {
    const characterClass = findClass();
    const background = findBackground();
    const species = findSpecies();
    const variant = findVariant(species);
    const feats = selectedOriginFeats();
    if (source === 'class') return `${characterClass?.proficiencies?.languages?.description || ''} ${characterClass?.languages || ''}`;
    if (source === 'background') return `${background?.languageText || ''}`;
    if (source === 'species') return getEffectiveAbilities(species, variant).map((item) => `${item?.title || ''} ${item?.description || ''}`).join(' ');
    return feats.map((feat) => `${feat?.name || ''} ${(feat?.effects || []).join(' ')}`).join(' ');
  }

  function getLanguageConfiguration() {
    const config = {};
    for (const source of ['class','background','species','feat']) {
      const parsed = parseLanguageSource(sourceTextForLanguages(source));
      const characterClass = findClass();
      if (source === 'class' && /^(rogue|плут)$/i.test(String(characterClass?.id || characterClass?.name || ''))) {
        if (!parsed.fixed.includes('Воровской жаргон')) parsed.fixed.push('Воровской жаргон');
        parsed.bonusChoices = Math.max(parsed.bonusChoices, 1);
        if (!parsed.unlockedRare.includes('Воровской жаргон')) parsed.unlockedRare.push('Воровской жаргон');
      }
      config[source] = {
        key: `${source}:languages`,
        bonusChoices: parsed.bonusChoices,
        fixed: parsed.fixed,
        unlockedRare: parsed.unlockedRare
      };
    }
    return config;
  }

  function sourceTextForTools(source) {
    const characterClass = findClass(); const background = findBackground(); const species = findSpecies(); const variant = findVariant(species); const feats = selectedOriginFeats();
    if (source === 'class') return `${characterClass?.proficiencies?.tools?.description || ''} ${characterClass?.tools || ''}`;
    if (source === 'background') return `${background?.tools || ''}`;
    if (source === 'species') return getEffectiveAbilities(species, variant).map((item) => `${item?.title || ''} ${item?.description || ''}`).join(' ');
    return feats.map((feat) => `${feat?.name || ''} ${(feat?.effects || []).join(' ')}`).join(' ');
  }

  function numberWordToValue(value) {
    const normalized = String(value || '').toLocaleLowerCase('ru');
    return ({ один:1, одно:1, одним:1, одну:1, два:2, две:2, тремя:3, три:3, четыре:4 })[normalized] || Number(normalized) || 0;
  }

  function toolChoiceCount(text) {
    const value = String(text || '');
    const normalized = value.toLocaleLowerCase('ru');
    const matches = [...normalized.matchAll(/(?:выберите|получаете владение|владение|владеете)?[^.!?]{0,55}?(\d+|один|одно|одним|одну|два|две|три|тремя|четыре)\s+(?:люб(?:ой|ого|ым|ыми)?\s+)?(?:музыкальн(?:ым|ыми)?\s+)?(?:инструмент(?:ом|ами|а|ов)?|набор(?:ом|ами|а|ов)?)/gi)];
    if (matches.length) return Math.max(...matches.map((match) => numberWordToValue(match[1])));
    return /инструмент|набор для|игров(?:ой|ого) набор|транспорт/i.test(value) ? 1 : 0;
  }

  function getToolConfiguration() {
    const characterClass = findClass();
    const config = {};

    for (const source of ['class','background','species','feat']) {
      const text = sourceTextForTools(source);
      let count = toolChoiceCount(text);
      let allowed = clientToolOptionsFromDescription(text);

      // По правилам конструктора любая выбранная предыстория даёт
      // одно владение любым инструментом независимо от старого текста данных.
      if (source === 'background') {
        count = findBackground() ? 1 : 0;
        allowed = [...creatorOptions.allTools];
      }

      // У классов список может содержать несколько отдельных владений.
      // Например, изобретатель получает два фиксированных инструмента и один на выбор.
      if (source === 'class' && Array.isArray(characterClass?.proficiencies?.tools)) {
        const entries = characterClass.proficiencies.tools.map((entry) => String(entry || ''));
        let total = 0;
        const classAllowed = new Set();
        for (const entry of entries) {
          const entryOptions = clientToolOptionsFromDescription(entry);
          entryOptions.forEach((tool) => classAllowed.add(tool));
          total += toolChoiceCount(entry);
        }
        count = total;
        allowed = [...classAllowed];
      }

      if (source === 'feat' && /ремесленник|crafter/i.test(text)) {
        count = 3;
        allowed = [...creatorOptions.artisanTools];
      }

      if (source === 'feat' && skilledSharedChoiceLimit() > 0) {
        count = Math.max(count, skilledSharedChoiceLimit());
        allowed = [...new Set([...allowed, ...creatorOptions.allTools])];
      }

      let fixed = [];

      // Артифактор: два фиксированных владения и один инструмент ремесленника на выбор.
      if (source === 'class' && /^(artificer|артифактор|артификатор|изобретатель)$/i.test(String(characterClass?.id || characterClass?.name || '').trim())) {
        fixed = ['Воровские инструменты', 'Инструменты ремонтника'];
        count = 3;
        allowed = [...new Set([...fixed, ...creatorOptions.artisanTools])];
      }

      // Монах выбирает владение одним инструментом ремесленника
      // или одним музыкальным инструментом. Этот выбор затем используется
      // и в его готовом стартовом наборе.
      if (source === 'class' && /^(monk|монах)$/i.test(String(characterClass?.id || characterClass?.name || '').trim())) {
        fixed = [];
        count = 1;
        allowed = [...new Set([...creatorOptions.artisanTools, ...musicalToolNames])];
      }

      // Бард получает владение тремя музыкальными инструментами на выбор.
      if (source === 'class' && /^(bard|бард)$/i.test(String(characterClass?.id || characterClass?.name || '').trim())) {
        fixed = [];
        count = 3;
        allowed = [...musicalToolNames];
      }

      config[source] = { key: `${source}:tools`, count, allowed, fixed };
    }
    return config;
  }

  function sourceLabel(source) {
    return ({ class:'Класс', background:'Предыстория', species:'Вид', feat:'Черта' })[source] || source;
  }

  function renderLanguagesTable(message = '') {
    const body = $('#languages-table-body');
    const summary = $('#languages-summary');
    const warning = $('#languages-warning');
    if (!body || !summary || !warning) return;

    const config = getLanguageConfiguration();
    const sources = ['class','background','species','feat'];
    const fixedLanguages = [...new Set(['Общий', ...sources.flatMap((source) => config[source].fixed || [])])];
    const bonusChoices = sources.reduce((sum, source) => sum + Math.max(0, Number(config[source].bonusChoices || 0)), 0);
    const totalKnownLimit = Math.max(3 + bonusChoices, fixedLanguages.length);
    const selectableLimit = Math.max(0, totalKnownLimit - fixedLanguages.length);
    const selectedKey = 'languages:selected';
    const fixedKey = 'languages:fixed';
    const allStandard = creatorOptions.standardLanguages.filter((language) => language !== 'Общий');

    const rareSourceMap = new Map();
    for (const language of creatorOptions.rareLanguages) {
      const availableSources = sources.filter((source) => (config[source].unlockedRare || []).includes(language));
      if (availableSources.length || fixedLanguages.includes(language)) rareSourceMap.set(language, availableSources);
    }

    const allowedLanguages = [...allStandard, ...rareSourceMap.keys()].filter((language) => !fixedLanguages.includes(language));
    const selected = Array.isArray(state.choices[selectedKey]) ? state.choices[selectedKey] : [];
    state.choices[selectedKey] = [...new Set(selected.filter((language) => allowedLanguages.includes(language)))].slice(0, selectableLimit);
    state.choices[fixedKey] = fixedLanguages;

    for (const source of sources) state.choices[`${source}:languages`] = [];

    const knownCount = fixedLanguages.length + state.choices[selectedKey].length;
    summary.innerHTML = `
      <div class="language-summary-card"><span>Известные</span><strong>${knownCount}/${totalKnownLimit}</strong></div>
    `;

    const rows = [
      ...fixedLanguages.map((language) => ({ language, fixed: true, rare: creatorOptions.rareLanguages.includes(language), availableSources: [] })),
      ...allStandard.filter((language) => !fixedLanguages.includes(language)).map((language) => ({ language, fixed: false, rare: false, availableSources: [] })),
      ...[...rareSourceMap.entries()]
        .filter(([language]) => !fixedLanguages.includes(language))
        .map(([language, availableSources]) => ({ language, fixed: false, rare: true, availableSources }))
    ];

    body.innerHTML = rows.map((row) => {
      const sourceNote = row.fixed
        ? `<small class="standard-language-note">Известен автоматически${row.language === 'Общий' ? ' каждому персонажу' : ''}</small>`
        : row.rare
          ? `<small class="rare-language-note">Редкий язык · доступен от: ${row.availableSources.map(sourceLabel).join(', ')}</small>`
          : '<small class="standard-language-note">Базовый язык</small>';
      const checked = row.fixed || state.choices[selectedKey].includes(row.language);
      const disabled = row.fixed ? 'disabled' : '';
      const control = `<label class="language-source-choice ${row.fixed ? 'language-common-choice' : ''}"><input type="checkbox" data-language-choice value="${escapeHtml(row.language)}" ${checked ? 'checked' : ''} ${disabled}><span>${row.fixed ? 'Известен' : 'Выбрать'}</span></label>`;
      return `<tr class="${row.rare ? 'rare-language-row' : ''}"><td class="choice-name"><strong>${escapeHtml(row.language)}</strong>${sourceNote}</td><td><div class="language-source-options">${control}</div></td></tr>`;
    }).join('');

    warning.textContent = message;
    warning.hidden = !message;

    $$('[data-language-choice]').forEach((input) => input.addEventListener('change', () => {
      const value = input.value;
      const current = state.choices[selectedKey] || [];
      if (input.checked) {
        if (current.length >= selectableLimit) {
          renderLanguagesTable(`Уже известно максимальное количество языков: ${totalKnownLimit}.`);
          return;
        }
        state.choices[selectedKey] = [...current, value];
      } else {
        state.choices[selectedKey] = current.filter((entry) => entry !== value);
      }
      saveState();
      renderLanguagesTable();
    }));
  }

  function renderToolsTable(message = '') {
    const body = $('#tools-table-body');
    const summary = $('#tools-summary');
    const warning = $('#tools-warning');
    if (!body || !summary || !warning) return;

    const config = getToolConfiguration();
    const sources = [['class','Класс'],['background','Предыстория'],['species','Вид'],['feat','Черта']];

    for (const [source] of sources) {
      const item = config[source];
      const fixed = Array.isArray(item.fixed) ? item.fixed : [];
      const current = Array.isArray(state.choices[item.key]) ? state.choices[item.key] : [];
      const selectable = current.filter((value) => item.allowed.includes(value) && !fixed.includes(value));
      state.choices[item.key] = source === 'feat' && skilledSharedChoiceLimit() > 0
        ? [...fixed, ...selectable].slice(0, skilledSharedChoiceLimit())
        : [...fixed, ...selectable].slice(0, item.count);
    }

    const fixedByAnySource = new Set(sources.flatMap(([source]) => config[source].fixed || []));

    summary.innerHTML = sources.map(([source,label]) => {
      const sharedLimit = source === 'feat' ? skilledSharedChoiceLimit() : 0;
      const selectedCount = sharedLimit ? skilledSharedSelectedCount() : (state.choices[config[source].key] || []).length;
      const limit = sharedLimit || config[source].count;
      return `<div class="choice-summary-card"><span>${label}</span><strong>${selectedCount}/${limit}</strong></div>`;
    }).join('');
    body.innerHTML = creatorOptions.allTools.map((option) => `<tr><td class="choice-name">${escapeHtml(option)}</td>${sources.map(([source]) => {
      const item=config[source];
      const fixed=(item.fixed||[]).includes(option);
      const selectedElsewhere=sources.some(([otherSource])=>otherSource!==source&&(state.choices[config[otherSource].key]||[]).includes(option));
      const available=item.count>0&&item.allowed.includes(option)&&(!selectedElsewhere||fixed);
      const checked=(state.choices[item.key]||[]).includes(option);
      return available ? `<td><input type="checkbox" data-tools-source="${source}" value="${escapeHtml(option)}" ${checked?'checked':''} ${fixed?'disabled data-fixed-tool="true"':''}></td>` : '<td class="choice-unavailable">—</td>';
    }).join('')}</tr>`).join('');

    warning.textContent = message;
    warning.hidden = !message;

    $$('[data-tools-source]').forEach((input) => input.addEventListener('change', () => {
      const source=input.dataset.toolsSource, value=input.value, item=config[source];
      if (input.dataset.fixedTool === 'true') return;
      for (const [otherSource] of sources) {
        const other=config[otherSource];
        if ((other.fixed || []).includes(value)) continue;
        state.choices[other.key]=(state.choices[other.key]||[]).filter((entry)=>entry!==value);
      }
      if (input.checked) {
        const selected=state.choices[item.key]||[];
        if (source === 'feat' && skilledSharedChoiceLimit() > 0) {
          if (skilledSharedSelectedCount() >= skilledSharedChoiceLimit()) {
            renderToolsTable(`Черта «Одарённый» уже дала ${skilledSharedChoiceLimit()} владения навыками или инструментами.`);
            return;
          }
        } else if(selected.length>=item.count){
          renderToolsTable(`Для источника уже выбрано максимальное количество.`);
          return;
        }
        state.choices[item.key]=[...selected,value];
      }
      if (source === 'class' && /^(monk|монах)$/i.test(String(findClass()?.id || findClass()?.name || '').trim())) {
        state.equipment.initializedFor = '';
      }

      saveState();
      renderToolsTable();
    }));
  }

  function renderChoiceTable(kind, message = '') {
    if (kind === 'languages') renderLanguagesTable(message);
    else renderToolsTable(message);
  }

  function choiceTableComplete(kind) {
    if (kind === 'languages') {
      const config = getLanguageConfiguration();
      const sources = ['class', 'background', 'species', 'feat'];

      const fixed = [
        ...new Set([
          'Общий',
          ...sources.flatMap((source) => config[source].fixed || [])
        ])
      ];

      const bonusChoices = sources.reduce(
        (sum, source) =>
          sum + Math.max(0, Number(config[source].bonusChoices || 0)),
        0
      );

      const total = Math.max(3 + bonusChoices, fixed.length);
      const selected = Array.isArray(state.choices['languages:selected'])
        ? state.choices['languages:selected']
        : [];

      return fixed.length + selected.length === total;
    }

    const config = getToolConfiguration();

    return ['class', 'background', 'species', 'feat'].every((source) => {
      if (source === 'feat' && skilledSharedChoiceLimit() > 0) {
        return skilledSharedSelectedCount() === skilledSharedChoiceLimit();
      }
      return (state.choices[config[source].key] || []).length === config[source].count;
    });
  }


  function normalizeEquipmentName(value) {
    return String(value || '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е')
      .replace(/<[^>]*>/g, ' ')
      .replace(/[()[\]{}]/g, ' ')
      .replace(/[.,;:]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function equipmentTextValue(value) {
    if (typeof value === 'string' || typeof value === 'number') return String(value);
    if (value && typeof value === 'object') {
      return String(value.name ?? value.label ?? value.item ?? value.title ?? value.text ?? '');
    }
    return '';
  }

  function equipmentDisplayText(value) {
    const container = document.createElement('div');
    container.innerHTML = equipmentTextValue(value);
    return String(container.textContent || container.innerText || '')
      .replace(/\s+/g, ' ')
      .trim();
  }



  function parseEquipmentEntry(value) {
    let explicitQuantity = 1;
    let rawName = '';

    if (value && typeof value === 'object') {
      explicitQuantity = Math.max(
        1,
        Number(value.quantity ?? value.count ?? value.amount ?? value.qty ?? 1) || 1
      );
      rawName = equipmentTextValue(value);
    } else {
      rawName = equipmentTextValue(value);
    }

    const text = rawName.trim();
    if (!text) return null;

    // Стартовые наборы классов содержат ссылки на точные страницы предметов.
    // Сначала используем id из href: отображаемое название может быть описательным
    // (например, «Магическая фокусировка (боевой посох)»), поэтому поиск только
    // по тексту приводил к неверным совпадениям или пропуску предмета.
    const hrefMatch = text.match(/href=["']\/items\/([^"'#?]+)["']/i);
    if (hrefMatch) {
      const linkedId = decodeURIComponent(hrefMatch[1]).replace(/^\/+|\/+$/g, '');
      const linkedItem = equipmentShopItems.find((candidate) => String(candidate.id) === linkedId);
      if (linkedItem) {
        const linkedCount = text.replace(/<[^>]*>/g, ' ').trim().match(/^(\d+)\s*[×xх]?\s+/i);
        return {
          id: linkedItem.id,
          quantity: linkedCount ? Math.max(1, Number(linkedCount[1])) : explicitQuantity,
          source: 'starting'
        };
      }
    }

    const countMatch = text.match(/^(\d+)\s*[×xх]?\s+(.+)$/i);
    rawName = countMatch ? countMatch[2] : text;

    let normalized = normalizeEquipmentName(rawName);
    normalized = EQUIPMENT_NAME_ALIASES[normalized] || normalized;

    const isPackagedItem = PACKAGED_EQUIPMENT_NAMES.includes(normalized);
    const quantity = isPackagedItem
      ? 1
      : countMatch
        ? Math.max(1, Number(countMatch[1]))
        : explicitQuantity;

    const exact = equipmentShopItems.find(
      (candidate) => normalizeEquipmentName(candidate.name) === normalized
    );
    if (exact) return { id: exact.id, quantity, source: 'starting' };

    const withoutPackageAmount = normalized
      .replace(/\b\d+\s*(футов|фута|фут|шт|штук|зарядов)\b/g, '')
      .replace(/\s+/g, ' ')
      .trim();

    const safeAlias = equipmentShopItems.find((candidate) => {
      const candidateName = normalizeEquipmentName(candidate.name);
      const candidateWithoutNumber = candidateName
        .replace(/\b\d+\b/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      return candidateName === withoutPackageAmount
        || candidateWithoutNumber === withoutPackageAmount
        || candidateName.startsWith(`${withoutPackageAmount} `);
    });

    return safeAlias ? { id: safeAlias.id, quantity, source: 'starting' } : null;
  }

  function parseStartingEquipmentText(value) {
    const text = equipmentTextValue(value);
    if (!text.trim()) return [];

    return text
      .replace(/\n/g, ',')
      .split(/[,;]|\s+и\s+/i)
      .map((part) => parseEquipmentEntry(part))
      .filter(Boolean);
  }

  function rawEquipmentVariantItems(variant) {
    if (Array.isArray(variant?.items)) return variant.items;
    if (Array.isArray(variant?.equipment)) return variant.equipment;
    if (Array.isArray(variant)) return variant;
    return [];
  }

  function isGoldOnlyEquipmentVariant(variant) {
    const items = rawEquipmentVariantItems(variant);
    const text = [
      equipmentTextValue(variant),
      ...items.map((item) => equipmentTextValue(item))
    ].join(' ');

    const hasMoney = /(?:^|\s)\d+(?:[.,]\d+)?\s*(?:зм|gp|см|sp|мм|cp|эм|ep|пм|pp)(?:\s|$)/i.test(text);
    const hasRecognizedItem = items.some((item) => Boolean(parseEquipmentEntry(item)));

    return hasMoney && !hasRecognizedItem;
  }

  function getClassEquipmentVariants() {
    const characterClass = findClass();
    const rawVariants = Array.isArray(characterClass?.equipment?.default)
      ? characterClass.equipment.default
      : [];

    const variants = rawVariants.map((variant, originalIndex) => {
      const rawItems = rawEquipmentVariantItems(variant);
      const parsedItems = rawItems
        .map((item) => parseEquipmentEntry(item))
        .filter(Boolean);
      const goldOnly = isGoldOnlyEquipmentVariant(variant);
      const variantMoneyCopper = moneyTextToCopper([
        equipmentTextValue(variant?.name ?? variant?.label ?? variant?.choice),
        ...rawItems.map((item) => equipmentTextValue(item))
      ].join(' '));
      const choiceName = String(variant?.choice ?? variant?.name ?? variant?.label ?? String.fromCharCode(1040 + originalIndex));

      return {
        originalIndex,
        label: goldOnly
          ? `Закупиться самостоятельно — ${formatCopper(variantMoneyCopper)}`
          : `Готовый набор ${choiceName}`,
        rawItems,
        parsedItems,
        goldOnly,
        variantMoneyCopper
      };
    }).filter((variant) => variant.goldOnly || variant.parsedItems.length > 0);

    if (variants.length) return variants;

    const fallback = parseStartingEquipmentText(
      characterClass?.startingEquipment
      ?? characterClass?.equipmentText
      ?? ''
    );

    return fallback.length
      ? [{ originalIndex: 0, label: 'Готовый стартовый набор', rawItems: [], parsedItems: fallback, goldOnly: false, variantMoneyCopper: 0 }]
      : [];
  }

  function getSelectedClassEquipmentVariant() {
    const variants = getClassEquipmentVariants();
    const index = Math.min(
      Math.max(0, Number(state.equipment.classVariantIndex || 0)),
      Math.max(0, variants.length - 1)
    );
    return variants[index] || null;
  }

  function moneyTextToCopper(value) {
    let total = 0;
    for (const match of String(value ?? '').matchAll(/(\d+(?:[.,]\d+)?)\s*(мм|см|эм|зм|пм|cp|sp|ep|gp|pp)/gi)) {
      const amount = Number(String(match[1]).replace(',', '.')) || 0;
      const unit = String(match[2]).toLocaleLowerCase('ru');
      const rates = { мм:1, cp:1, см:10, sp:10, эм:50, ep:50, зм:100, gp:100, пм:1000, pp:1000 };
      total += Math.round(amount * (rates[unit] || 0));
    }
    return total;
  }

  function getSelectedClassVariantMoneyCopper() {
    return Math.max(0, Number(getSelectedClassEquipmentVariant()?.variantMoneyCopper || 0));
  }

  function isGoldEquipmentMode() {
    return Boolean(getSelectedClassEquipmentVariant()?.goldOnly);
  }

  function getSelectedMonkStartingToolEntry() {
    const characterClass = findClass();
    const classKey = String(characterClass?.id || characterClass?.name || '').trim();
    if (!/^(monk|монах)$/i.test(classKey)) return null;

    const selectedTool = (state.choices['class:tools'] || [])[0];
    if (!selectedTool) return null;

    const normalizedSelected = normalizeEquipmentName(selectedTool);
    const item = equipmentShopItems.find((candidate) => {
      const names = [
        candidate.name,
        candidate.nameEn,
        String(candidate.name || '').replace(/^Инструменты\s+/i, ''),
        String(candidate.name || '').replace(/^Набор\s+/i, '')
      ].map(normalizeEquipmentName);

      return names.includes(normalizedSelected)
        || names.some((name) => name && (
          name.includes(normalizedSelected)
          || normalizedSelected.includes(name)
        ));
    });

    return item ? { id: item.id, quantity: 1, source: 'starting' } : null;
  }

  function getClassStartingEquipment() {
    const variant = getSelectedClassEquipmentVariant();
    if (variant?.goldOnly) return [];

    const equipment = [...(variant?.parsedItems || [])];
    const rawText = (variant?.rawItems || [])
      .map((item) => equipmentDisplayText(item))
      .join(' ');

    if (/инструмент(?:ы)?\s+ремесленника\s+или\s+музыкальн(?:ый|ого)\s+инструмент[^.!?]{0,90}выбрали\s+ранее/i.test(rawText)) {
      const selectedTool = getSelectedMonkStartingToolEntry();
      if (selectedTool && !equipment.some((entry) => entry.id === selectedTool.id)) {
        equipment.push(selectedTool);
      }
    }

    return equipment;
  }

  function getBackgroundStartingEquipment() {
    const background = findBackground();
    return parseStartingEquipmentText(background?.equipment ?? '');
  }

  function equipmentStartingKey() {
    const classToolChoice = (state.choices['class:tools'] || []).join(',');
    return `${state.class || ''}:${state.background || ''}:${Number(state.equipment.classVariantIndex || 0)}:${classToolChoice}`;
  }

  function getStartingGoldCopper() {
    const characterClass = findClass();
    let total = findBackground() ? 5000 : 0;

    const classMoneySources = [
      characterClass?.startingGold,
      characterClass?.gold,
      characterClass?.equipment?.gold
    ];

    for (const source of classMoneySources) {
      for (const match of String(source ?? '').matchAll(/(\d+(?:[.,]\d+)?)\s*(мм|см|эм|зм|пм|cp|sp|ep|gp|pp)/gi)) {
        const amount = Number(String(match[1]).replace(',', '.')) || 0;
        const unit = String(match[2]).toLocaleLowerCase('ru');
        const rates = { мм:1, cp:1, см:10, sp:10, эм:50, ep:50, зм:100, gp:100, пм:1000, pp:1000 };
        total += Math.round(amount * (rates[unit] || 0));
      }
    }

    total += getSelectedClassVariantMoneyCopper();
    return total;
  }

  function ensureStartingEquipment() {
    const key = equipmentStartingKey();
    if (!state.class && !state.background) return;
    if (state.equipment.initializedFor === key) return;

    const combined = [
      ...getClassStartingEquipment(),
      ...getBackgroundStartingEquipment()
    ];
    const inventory = [];

    for (const entry of combined) {
      const existing = inventory.find((item) => item.id === entry.id);
      if (existing) existing.quantity += entry.quantity;
      else inventory.push({ ...entry });
    }

    state.equipment = {
      initializedFor: key,
      inventory,
      goldCopper: getStartingGoldCopper(),
      classVariantIndex: Number(state.equipment.classVariantIndex || 0),
      purchaseConfirmed: false,
      version: 7
    };
    saveState();
  }

  function formatCopper(copper) {
    const value = Math.max(0, Math.round(Number(copper) || 0));
    const gp = Math.floor(value / 100);
    const sp = Math.floor((value % 100) / 10);
    const cp = value % 10;
    return [gp ? `${gp} зм` : '', sp ? `${sp} см` : '', cp || (!gp && !sp) ? `${cp} мм` : ''].filter(Boolean).join(' ');
  }


  const EQUIPMENT_PACK_CONTENTS_UI = EQUIPMENT_PACK_CONTENTS;

  function normalizeEquipmentPackKey(value) {
    return String(value ?? '')
      .toLocaleLowerCase('ru')
      .replace(/ё/g, 'е')
      .replace(/<[^>]+>/g, ' ')
      .replace(/[()«»"'↗]/g, ' ')
      .replace(/[_–—-]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  const NORMALIZED_EQUIPMENT_PACK_CONTENTS = new Map(
    Object.entries(EQUIPMENT_PACK_CONTENTS_UI).map(([key, contents]) => [
      normalizeEquipmentPackKey(key),
      contents
    ])
  );

  const EQUIPMENT_PACK_ALIASES = {
    'scholars pack': 'набор ученого',
    'scholar pack': 'набор ученого',
    'scholar s pack': 'набор ученого',
    'scholar’s pack': 'набор ученого',
    'scholar-pack': 'набор ученого',
    'набор учёного': 'набор ученого',
    'набор ученого 2024': 'набор ученого'
  };

  function equipmentPackContents(itemOrName) {
    const item = itemOrName && typeof itemOrName === 'object' ? itemOrName : null;
    const hrefSlug = String(item?.href || '').match(/\/items\/([^/?#]+)/i)?.[1] || '';
    const candidates = [
      item?.id,
      item?.name,
      item?.nameEn,
      hrefSlug ? decodeURIComponent(hrefSlug) : '',
      itemOrName && typeof itemOrName !== 'object' ? itemOrName : ''
    ]
      .map(normalizeEquipmentPackKey)
      .filter(Boolean);

    for (const rawCandidate of candidates) {
      const candidate = normalizeEquipmentPackKey(
        EQUIPMENT_PACK_ALIASES[rawCandidate] || rawCandidate
      );

      const exact = NORMALIZED_EQUIPMENT_PACK_CONTENTS.get(candidate);
      if (exact) return exact;

      const matchedEntry = [...NORMALIZED_EQUIPMENT_PACK_CONTENTS.entries()].find(([packKey]) =>
        candidate === packKey
        || candidate.startsWith(`${packKey} `)
        || candidate.includes(packKey)
        || packKey.includes(candidate)
      );

      if (matchedEntry) return matchedEntry[1];
    }

    return null;
  }

  function getEquipmentInventoryDetailed() {
    return (state.equipment.inventory || []).map((entry) => {
      const item = equipmentShopItems.find((candidate) => candidate.id === entry.id);
      return item ? { ...entry, item } : null;
    }).filter(Boolean);
  }


  function restoreStartingEquipment() {
    const combined = [
      ...getClassStartingEquipment(),
      ...getBackgroundStartingEquipment()
    ];

    const inventory = [];
    for (const entry of combined) {
      const existing = inventory.find((item) => item.id === entry.id);
      if (existing) existing.quantity += entry.quantity;
      else inventory.push({ ...entry, source: 'starting' });
    }

    state.equipment = {
      initializedFor: equipmentStartingKey(),
      inventory,
      goldCopper: getStartingGoldCopper(),
      classVariantIndex: Number(state.equipment.classVariantIndex || 0),
      purchaseConfirmed: false,
      version: 7
    };

    saveState();
  }

  function sellAllEquipment() {
    let proceeds = 0;

    for (const entry of getEquipmentInventoryDetailed()) {
      proceeds += Math.max(0, Number(entry.item.costCopper || 0)) * Math.max(1, Number(entry.quantity || 1));
    }

    state.equipment.inventory = [];
    state.equipment.goldCopper = Math.max(0, Number(state.equipment.goldCopper || 0)) + proceeds;
    state.equipment.initializedFor = equipmentStartingKey();
    saveState();

    return proceeds;
  }

  function renderEquipment(message = '') {
    ensureStartingEquipment();
    const inventory = $('#equipment-inventory');
    const shop = $('#equipment-shop');
    const gold = $('#equipment-gold');
    const weight = $('#equipment-weight');
    const warning = $('#equipment-warning');
    const sellAllButton = $('#equipment-sell-all');
    const confirmButton = $('#equipment-confirm-purchase');
    const repurchaseButton = $('#equipment-repurchase');
    const equipmentActions = $('#equipment-actions');
    const shopPanel = $('#equipment-shop-panel');
    const modeNote = $('#equipment-mode-note');
    const equipmentLayout = $('#equipment-layout');
    const variantSection = $('#equipment-variant-section');
    const variantsContainer = $('#equipment-variants');
    if (!inventory || !shop || !gold || !weight || !warning) return;

    const variants = getClassEquipmentVariants();
    if (variantSection && variantsContainer) {
      variantSection.hidden = variants.length <= 1;
      variantsContainer.innerHTML = variants.map((variant, index) => {
        const description = variant.goldOnly
          ? `Получите ${formatCopper(variant.variantMoneyCopper)} и купите всё необходимое самостоятельно.`
          : variant.rawItems.length
            ? variant.rawItems.map((item) => equipmentDisplayText(item)).filter(Boolean).join(', ')
            : variant.parsedItems.map((entry) => {
                const item = equipmentShopItems.find((candidate) => candidate.id === entry.id);
                return item ? `${entry.quantity > 1 ? `${entry.quantity} × ` : ''}${item.name}` : '';
              }).filter(Boolean).join(', ');

        return `<label class="equipment-variant-card ${variant.goldOnly ? 'is-gold' : ''}" data-equipment-variant-index="${index}">
          <input type="radio" name="equipment-class-variant" value="${index}" ${Number(state.equipment.classVariantIndex || 0) === index ? 'checked' : ''}>
          <span>
            <strong>${escapeHtml(variant.label)}</strong>
            <small>${escapeHtml(description)}</small>
          </span>
        </label>`;
      }).join('');

      variantsContainer.onclick = (event) => {
        const target = event.target;
        const card = target?.closest?.('[data-equipment-variant-index]');
        if (!card) return;

        const nextIndex = Number(card.dataset.equipmentVariantIndex || 0);
        if (nextIndex === Number(state.equipment.classVariantIndex || 0)) return;

        state.equipment.classVariantIndex = nextIndex;
        state.equipment.initializedFor = '';
        state.equipment.purchaseConfirmed = false;
        restoreStartingEquipment();
        renderEquipment('Выбран новый стартовый набор.');
      };
    }

    const goldMode = isGoldEquipmentMode();
    const purchaseConfirmed = goldMode && Boolean(state.equipment.purchaseConfirmed);
    if (shopPanel) shopPanel.hidden = !goldMode || purchaseConfirmed;
    if (equipmentLayout) equipmentLayout.classList.toggle('is-inventory-only', !goldMode || purchaseConfirmed);
    if (equipmentActions) equipmentActions.hidden = !goldMode;
    if (sellAllButton) sellAllButton.hidden = purchaseConfirmed;
    if (confirmButton) confirmButton.hidden = !goldMode || purchaseConfirmed;
    if (repurchaseButton) repurchaseButton.hidden = !purchaseConfirmed;
    if (modeNote) {
      modeNote.innerHTML = !goldMode
        ? `<strong>Готовый набор.</strong> Снаряжение уже добавлено в инвентарь. Магазин скрыт.`
        : purchaseConfirmed
          ? `<strong>Закупка подтверждена.</strong> Выбранное снаряжение сохранено. Для изменения нажмите «Перезакупиться».`
          : `<strong>Самостоятельная закупка.</strong> Купите необходимые предметы и затем подтвердите закупку.`;
    }

    const detailed = getEquipmentInventoryDetailed();
    gold.textContent = formatCopper(state.equipment.goldCopper);
    weight.textContent = `${detailed.reduce((sum, entry) => sum + Number(entry.item.weight || 0) * entry.quantity, 0).toFixed(1)} фнт.`;

    inventory.innerHTML = detailed.length ? detailed.map((entry) => {
      const packContents = equipmentPackContents(entry.item);
      const packDetails = packContents ? `
        <details class="equipment-pack-details">
          <summary>Показать содержимое <span>${packContents.length}</span></summary>
          <ul>${packContents.map((part) => `<li>${escapeHtml(part)}</li>`).join('')}</ul>
        </details>` : '';

      return `
      <article class="equipment-inventory-row ${packContents ? 'has-pack' : ''}">
        <div class="equipment-inventory-main">
          <a href="${entry.item.href}" target="_blank" rel="noopener">${escapeHtml(entry.item.name)} ↗</a>
          <small>${escapeHtml(entry.source === 'starting' ? 'Стартовое снаряжение' : 'Куплено')}</small>
          ${packDetails}
        </div>
        <div class="equipment-quantity">
          ${goldMode && !purchaseConfirmed ? `<button type="button" data-equipment-remove="${escapeHtml(entry.item.id)}">−</button>` : ''}
          <strong>${entry.quantity}</strong>
          ${goldMode && !purchaseConfirmed ? `<button type="button" data-equipment-add="${escapeHtml(entry.item.id)}">+</button>` : ''}
        </div>
      </article>`;
    }).join('') : '<p class="equipment-empty">Инвентарь пуст.</p>';

    const query = String($('#equipment-search')?.value || '').trim().toLocaleLowerCase('ru');
    const category = String($('#equipment-category')?.value || 'all');
    const filtered = equipmentShopItems
      .filter((item) => !query || `${item.name} ${item.nameEn}`.toLocaleLowerCase('ru').includes(query))
      .filter((item) => category === 'all' || item.categoryGroup === category);

    shop.innerHTML = filtered.map((item) => {
      const affordable = item.costCopper > 0 && state.equipment.goldCopper >= item.costCopper;
      const owned = Number(state.equipment.inventory.find((entry) => entry.id === item.id)?.quantity || 0);
      return `<tr>
        <td><a href="${item.href}" target="_blank" rel="noopener">${escapeHtml(item.name)} ↗</a><small>${escapeHtml(item.category)}</small></td>
        <td>${owned > 0 ? `<span class="equipment-owned-count">${owned}</span>` : '—'}</td>
        <td>${escapeHtml(item.cost)}</td>
        <td>${item.weight} фнт.</td>
        <td><button class="equipment-buy" type="button" data-equipment-buy="${escapeHtml(item.id)}" ${affordable ? '' : 'disabled'}>Купить</button></td>
      </tr>`;
    }).join('');

    warning.textContent = message;
    warning.hidden = !message;

    if (sellAllButton) {
      sellAllButton.disabled = detailed.length === 0;
      sellAllButton.onclick = () => {
        const proceeds = sellAllEquipment();
        renderEquipment(
          proceeds > 0
            ? `Всё снаряжение продано за ${formatCopper(proceeds)}.`
            : 'В инвентаре нет предметов для продажи.'
        );
      };
    }

    if (confirmButton) {
      confirmButton.onclick = () => {
        state.equipment.purchaseConfirmed = true;
        saveState();
        renderEquipment('Закупка подтверждена. Снаряжение сохранено.');
      };
    }

    if (repurchaseButton) {
      repurchaseButton.onclick = () => {
        restoreStartingEquipment();
        state.equipment.purchaseConfirmed = false;
        saveState();
        renderEquipment('Закупка сброшена. Выберите снаряжение заново.');
      };
    }

    $$('[data-equipment-buy]').forEach((button) => button.addEventListener('click', () => {
      const item = equipmentShopItems.find((candidate) => candidate.id === button.dataset.equipmentBuy);
      if (!item || item.costCopper <= 0 || state.equipment.goldCopper < item.costCopper) return;
      state.equipment.goldCopper -= item.costCopper;
      const existing = state.equipment.inventory.find((entry) => entry.id === item.id);
      if (existing) existing.quantity += 1;
      else state.equipment.inventory.push({ id: item.id, quantity: 1, source: 'purchased' });
      saveState();
      renderEquipment();
    }));

    $$('[data-equipment-add]').forEach((button) => button.addEventListener('click', () => {
      const item = equipmentShopItems.find((candidate) => candidate.id === button.dataset.equipmentAdd);
      if (!item || item.costCopper <= 0 || state.equipment.goldCopper < item.costCopper) {
        renderEquipment('Недостаточно золота.');
        return;
      }
      state.equipment.goldCopper -= item.costCopper;
      const existing = state.equipment.inventory.find((entry) => entry.id === item.id);
      if (existing) existing.quantity += 1;
      saveState();
      renderEquipment();
    }));

    $$('[data-equipment-remove]').forEach((button) => button.addEventListener('click', () => {
      const entry = state.equipment.inventory.find((item) => item.id === button.dataset.equipmentRemove);
      const shopItem = equipmentShopItems.find((item) => item.id === button.dataset.equipmentRemove);
      if (!entry || !shopItem) return;
      entry.quantity -= 1;

      // Кнопка «−» продаёт одну единицу предмета за полную стоимость.
      // Для стартовых предметов цена тоже возвращается.
      state.equipment.goldCopper += Math.max(0, Number(shopItem.costCopper || 0));

      if (entry.quantity <= 0) {
        state.equipment.inventory = state.equipment.inventory.filter((item) => item !== entry);
      }

      saveState();
      renderEquipment(
        shopItem.costCopper > 0
          ? `Продано: ${shopItem.name} за ${formatCopper(shopItem.costCopper)}.`
          : `Удалено: ${shopItem.name}. У предмета нет указанной цены.`
      );
    }));
  }

  function isSpellcasterAtLevelOne() { return getSpellSources().length > 0; }

  const spellSearchQueries = {};

  function renderSpells(message = '') {
    const picker = $('#spell-picker');
    const nonCaster = $('#spell-non-caster');
    const root = $('#spell-sources');
    if (!picker || !nonCaster || !root) return;

    ensureSpellSourceState();
    const sources = getSpellSources();
    picker.hidden = !sources.length;
    nonCaster.hidden = !!sources.length;
    if (!sources.length) return;

    for (const source of sources) {
      const existing = state.spells.sources[source.id] || { cantrip: [], level1: [] };
      existing.cantrip = (existing.cantrip || []).filter((id) =>
        source.options.some((spell) => spell.id === id && spell.level === 'cantrip')
      );
      existing.level1 = (existing.level1 || []).filter((id) =>
        source.options.some((spell) => spell.id === id && spell.level === '1')
      );
      state.spells.sources[source.id] = existing;
    }

    for (const id of Object.keys(state.spells.sources)) {
      if (!sources.some((source) => source.id === id)) delete state.spells.sources[id];
    }

    // Одно и то же заклинание нельзя получать или выбирать повторно из разных источников.
    // Автоматически полученные заклинания имеют приоритет над ручным выбором.
    const fixedSpellOwners = new Map();
    for (const source of sources) {
      for (const spell of source.fixed || []) {
        if (!fixedSpellOwners.has(spell.id)) fixedSpellOwners.set(spell.id, source.id);
      }
    }

    const selectedSpellOwners = new Map();
    for (const source of sources) {
      const buckets = state.spells.sources[source.id] || { cantrip: [], level1: [] };
      for (const bucketKey of ['cantrip', 'level1']) {
        buckets[bucketKey] = (buckets[bucketKey] || []).filter((spellId) => {
          // Если заклинание уже выдано автоматически, ручной выбор удаляется.
          if (fixedSpellOwners.has(spellId)) return false;
          // При старом сохранении с дублями оставляем выбор у первого источника.
          if (selectedSpellOwners.has(spellId)) return false;
          selectedSpellOwners.set(spellId, source.id);
          return true;
        });
      }
      state.spells.sources[source.id] = buckets;
    }

    const spellOwner = (spellId) => fixedSpellOwners.get(spellId) || selectedSpellOwners.get(spellId) || null;
    const sourceTitleById = (sourceId) => sources.find((item) => item.id === sourceId)?.title || 'другой источник';

    const cards = (source, bucketKey, spellLevel, query) => {
      const selected = state.spells.sources[source.id]?.[bucketKey] || [];
      const available = source.options
        .filter((spell) => spell.level === spellLevel)
        .filter((spell) => !query || String(spell.name).toLocaleLowerCase('ru').includes(query));

      return available.map((spell) => {
        const isSelected = selected.includes(spell.id);
        const ownerId = spellOwner(spell.id);
        const isUnavailable = Boolean(ownerId && ownerId !== source.id);
        const unavailableText = isUnavailable
          ? `Уже получено или выбрано из источника «${sourceTitleById(ownerId)}»`
          : '';

        return `
        <div class="spell-card ${isSelected ? 'is-selected' : ''} ${isUnavailable ? 'is-unavailable' : ''}" ${unavailableText ? `title="${escapeHtml(unavailableText)}"` : ''}>
          <input type="checkbox"
            data-spell-source="${escapeHtml(source.id)}"
            data-spell-level="${bucketKey}"
            value="${escapeHtml(spell.id)}"
            ${isSelected ? 'checked' : ''}
            ${isUnavailable ? 'disabled aria-disabled="true"' : ''}>
          <div class="spell-name-copy">
            ${spell.choiceLabel ? `<span class="spell-choice-label">${escapeHtml(spell.choiceLabel)}</span>` : ''}
            <a class="spell-name-link" href="/spells/${encodeURIComponent(spell.id)}" target="_blank" rel="noopener noreferrer">${escapeHtml(spell.name)}</a>
            <small class="spell-availability-source">${escapeHtml(spell.availabilityLabel || source.spellLabel || `${source.category}: ${source.title}`)}</small>
            ${spell.choiceDescription ? `<small class="spell-choice-description">${escapeHtml(spell.choiceDescription)}</small>` : ''}
          </div>
          <span class="spell-open-icon">↗</span>
        </div>`;
      }).join('') || '<p class="empty-copy">Нет доступных заклинаний.</p>';
    };

    root.innerHTML = sources.map((source) => {
      const selected = state.spells.sources[source.id] || { cantrip: [], level1: [] };
      const query = String(spellSearchQueries[source.id] || '').trim().toLocaleLowerCase('ru');
      const hasCantrips = Number(source.limits.cantrip || 0) > 0;
      const hasLevel1 = Number(source.limits.level1 || 0) > 0;
      // Для видов список вариантов обычно короткий и связан с наследием,
      // поэтому отдельный поиск только перегружает карточку.
      const showSourceSearch = String(source.category || '').trim().toLocaleLowerCase('ru') !== 'вид'
        && (hasCantrips || hasLevel1);
      const fixed = (source.fixed || []).length
        ? `<div class="spell-fixed"><strong>Автоматически получены:</strong>${source.fixed.map((spell) => `<p><span>${escapeHtml(spell.name)}</span><small class="spell-availability-source">${escapeHtml(spell.availabilityLabel || source.spellLabel || `${source.category}: ${source.title}`)}</small></p>`).join('')}</div>`
        : '';

      const cantripSection = hasCantrips ? `
        <section class="spell-section">
          <div class="spell-section-heading">
            <div><span>Магия без ячеек</span><h4>Заговоры</h4></div>
            <strong>${selected.cantrip.length}/${source.limits.cantrip}</strong>
          </div>
          <div class="spell-grid">${cards(source, 'cantrip', 'cantrip', query)}</div>
        </section>` : '';

      const level1Section = hasLevel1 ? `
        <section class="spell-section">
          <div class="spell-section-heading">
            <div><span>Магия первого круга</span><h4>Заклинания 1 уровня</h4></div>
            <strong>${selected.level1.length}/${source.limits.level1}</strong>
          </div>
          <div class="spell-grid">${cards(source, 'level1', '1', query)}</div>
        </section>` : '';

      return `
        <section class="spell-source">
          <header class="spell-source-title">
            <div>
              <span>${escapeHtml(source.category)}</span>
              <h3>${escapeHtml(source.title)}</h3>
              <p>${escapeHtml(source.description || '')}</p>
            </div>
          </header>
          <div class="spell-source-body">
            <div class="spell-toolbar">
              <div class="spell-limit-summary">
                ${hasCantrips ? `<strong>Заговоры ${selected.cantrip.length}/${source.limits.cantrip}</strong>` : ''}
                ${hasLevel1 ? `<strong>1 уровень ${selected.level1.length}/${source.limits.level1}</strong>` : ''}
              </div>
              ${showSourceSearch ? `<label class="spell-search-field">
                <span>Поиск в источнике</span>
                <input type="search" data-spell-search="${escapeHtml(source.id)}" value="${escapeHtml(spellSearchQueries[source.id] || '')}" placeholder="Начни вводить название…" autocomplete="off">
              </label>` : ''}
            </div>
            ${fixed}
            <div class="spell-columns ${hasCantrips && hasLevel1 ? '' : 'is-single'}">
              ${cantripSection}${level1Section}
            </div>
          </div>
        </section>`;
    }).join('');

    syncLegacySpellBuckets();
    const warning = $('#spell-warning');
    if (warning) {
      warning.textContent = message;
      warning.hidden = !message;
    }

    $$('[data-spell-search]').forEach((input) => input.addEventListener('input', () => {
      spellSearchQueries[input.dataset.spellSearch] = input.value;
      renderSpells();
      const restored = document.querySelector(`[data-spell-search="${CSS.escape(input.dataset.spellSearch)}"]`);
      if (restored) {
        restored.focus();
        const end = restored.value.length;
        restored.setSelectionRange(end, end);
      }
    }));

    $$('[data-spell-source]').forEach((input) => input.addEventListener('change', () => {
      const source = sources.find((item) => item.id === input.dataset.spellSource);
      if (!source) return;
      const level = input.dataset.spellLevel;
      const limit = source.limits[level];
      const bucket = state.spells.sources[source.id][level];

      if (input.checked) {
        if (bucket.length >= limit) {
          input.checked = false;
          return renderSpells(`Источник «${source.title}»: можно выбрать только ${limit}.`);
        }
        if (!bucket.includes(input.value)) bucket.push(input.value);
      } else {
        state.spells.sources[source.id][level] = bucket.filter((id) => id !== input.value);
      }

      syncLegacySpellBuckets();
      saveState();
      renderSpells();
    }));
  }

  function renderAlignment() { $$('.alignment-card').forEach((button) => button.classList.toggle('is-selected', button.dataset.alignment === state.alignment)); }
  function renderSummary() {
    const species = findSpecies(), variant = findVariant(species), characterClass = findClass(), background = findBackground();
    const labels = {strength:'СИЛ',dexterity:'ЛОВ',constitution:'ТЕЛ',intelligence:'ИНТ',wisdom:'МДР',charisma:'ХАР'};
    const languages = [...new Set([...(state.choices['languages:fixed'] || ['Общий']), ...(state.choices['languages:selected'] || [])])];
    const skills = [...(state.choices['class:skills'] || []), ...(state.choices['background:skills'] || []), ...(state.choices['species:skill'] || []), ...(state.choices['feat:skills'] || [])];
    const root = $('#final-sheet'); if (!root) return;
    root.innerHTML = `<div class="final-identity"><span>Персонаж 1 уровня</span><h3>${escapeHtml(state.name || 'Безымянный герой')}</h3><p>${escapeHtml([[species?.name, variant?.name].filter(Boolean).join(' — '), characterClass?.name, background?.name].filter(Boolean).join(' · ') || 'Выбор не завершён')}</p></div><div class="final-stats">${abilityKeys.map((key) => `<div><span>${labels[key]}</span><strong>${totalScore(key)}</strong><small>${formatModifier(modifier(totalScore(key)))}</small></div>`).join('')}</div><div class="final-details"><p><strong>Рост и вес:</strong> ${state.physique.heightInches ? `${Math.floor(state.physique.heightInches/12)}′ ${state.physique.heightInches%12}″ · ${state.physique.weightPounds} фун.` : '—'}</p><p><strong>Мировоззрение:</strong> ${escapeHtml(ALIGNMENTS[state.alignment] || '—')}</p><p><strong>Языки:</strong> ${escapeHtml([...new Set(languages)].join(', '))}</p><p><strong>Навыки:</strong> ${escapeHtml(skills.join(', ') || '—')}</p><p><strong>Компетентность:</strong> ${escapeHtml((state.choices['class:expertise'] || []).join(', ') || '—')}</p><p><strong>Черта происхождения:</strong> ${escapeHtml(selectedOriginFeats().map((feat) => feat.name).join(', ') || '—')}</p><p><strong>Заговоры:</strong> ${escapeHtml(getClassSpells().filter((spell) => state.spells.cantrips.includes(spell.id)).map((spell) => spell.name).join(', ') || '—')}</p><p><strong>Заклинания 1 уровня:</strong> ${escapeHtml(getClassSpells().filter((spell) => state.spells.level1.includes(spell.id)).map((spell) => spell.name).join(', ') || '—')}</p><p><strong>Черты характера:</strong> ${escapeHtml((state.choices['background:traits'] || []).join(' / ') || '—')}</p><p><strong>Идеал:</strong> ${escapeHtml(state.choices['background:ideal']?.[0] || '—')}</p><p><strong>Привязанность:</strong> ${escapeHtml(state.choices['background:bond']?.[0] || '—')}</p><p><strong>Слабость:</strong> ${escapeHtml(state.choices['background:flaw']?.[0] || '—')}</p></div>`;
  }

  function showStep(index) {
    state.step = Math.max(0, Math.min(steps.length - 1, index));

    $$('.wizard-step').forEach((section) => {
      section.classList.toggle(
        'is-active',
        section.dataset.step === steps[state.step]
      );
    });

    $$('.sidebar-step').forEach((button, buttonIndex) => {
      button.classList.toggle('is-active', buttonIndex === state.step);
      button.classList.toggle('is-complete', buttonIndex < state.step);
    });

    $('#previous-step').disabled = state.step === 0;
    $('#next-step').hidden = state.step === steps.length - 1;
    $('#next-step').disabled = false;
    $('#step-counter').textContent = `Шаг ${state.step + 1} из ${steps.length}`;

    if (steps[state.step] === 'species') {
      renderSpeciesDetails();
    }

    if (steps[state.step] === 'class') {
      renderClassDetails();
    }

    if (steps[state.step] === 'class-features') { renderClassFeatures(); }

    if (steps[state.step] === 'background') { renderBackgroundDetails(); }
    if (steps[state.step] === 'origin-feats') { renderOriginFeats(); }
    if (steps[state.step] === 'skills') { renderSkills(); }
    if (steps[state.step] === 'expertise') { renderExpertise(); }
    if (steps[state.step] === 'languages') { renderChoiceTable('languages'); }
    if (steps[state.step] === 'tools') { renderChoiceTable('tools'); }
    if (steps[state.step] === 'equipment') { renderEquipment(); }
    if (steps[state.step] === 'abilities') { renderAbilities(); }
    if (steps[state.step] === 'spells') { renderSpells(); }
    if (steps[state.step] === 'alignment') { renderAlignment(); }
    if (steps[state.step] === 'summary') { renderSummary(); }

    saveState();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  loadState();

  const nameInput = $('#character-name');
  if (nameInput) {
    nameInput.value = state.name;
    nameInput.addEventListener('input', (event) => {
      state.name = event.target.value;
      updatePreview();
    });
  }

  $$('.species-card').forEach((card) => {
    card.addEventListener('click', () => {
      state.species = card.dataset.speciesId;
      state.choices['species:skill'] = [];
      state.choices['species:originFeat'] = [];
      state.choices['species:customLineageFeature'] = [];
      state.choices['feat:skills'] = [];
      state.speciesVariant = null;
      state.physique = structuredClone(defaultState.physique);
      renderSpeciesDetails();
      updatePreview();
    });
  });

  $('#species-search')?.addEventListener('input', (event) => {
    const query = event.target.value.trim().toLocaleLowerCase('ru');

    $$('.species-card').forEach((card) => {
      card.hidden = !card.dataset.searchText
        .toLocaleLowerCase('ru')
        .includes(query);
    });
  });

  $$('.class-card').forEach((card) => {
    card.addEventListener('click', () => {
      state.class = card.dataset.classId;
      state.choices['class:skills'] = [];
      state.choices['class:expertise'] = [];
      Object.keys(state.choices).filter((key) => key.startsWith('classFeature:')).forEach((key) => delete state.choices[key]);
      state.spells = { cantrips: [], level1: [], sources: {} };
      state.equipment.initializedFor = '';
      renderClassDetails();
      updatePreview();
    });
  });

  $('#class-search')?.addEventListener('input', (event) => {
    const query = event.target.value.trim().toLocaleLowerCase('ru');
    $$('.class-card').forEach((card) => {
      card.hidden = !card.dataset.searchText.toLocaleLowerCase('ru').includes(query);
    });
  });


  $$('.background-card').forEach((card) => {
    card.addEventListener('click', () => {
      state.background = card.dataset.backgroundId;
      const keptOriginFeat = [...(state.choices['background:originFeat'] || [])];
      state.choices['background:skills'] = [];
      Object.keys(state.choices).filter((id) => (id.startsWith('background:') && id !== 'background:originFeat') || id.startsWith('feat:')).forEach((id) => delete state.choices[id]);
      state.choices['background:originFeat'] = keptOriginFeat;
      state.equipment.initializedFor = '';
      renderBackgroundDetails();
      updatePreview();
    });
  });

  $('#background-search')?.addEventListener('input', (event) => {
    const query = event.target.value.trim().toLocaleLowerCase('ru');
    $$('.background-card').forEach((card) => {
      card.hidden = !card.dataset.searchText.toLocaleLowerCase('ru').includes(query);
    });
  });

  $('#equipment-search')?.addEventListener('input', () => renderEquipment());
  $('#equipment-category')?.addEventListener('change', () => renderEquipment());

  $$('.sidebar-step').forEach((button, index) => {
    button.addEventListener('click', () => {
      showStep(index);
    });
  });

  $('#previous-step')?.addEventListener('click', () => {
    showStep(state.step - 1);
  });

  $('#next-step')?.addEventListener('click', () => {
    if (steps[state.step] === 'species' && !state.species) {
      alert('Сначала выберите вид.');
      return;
    }

    if (steps[state.step] === 'species' && isCustomLineageSpecies() && !(state.choices['species:customLineageFeature'] || [])[0]) {
      alert('Выберите размер и выборочную особенность «Своего происхождения».');
      return;
    }

    if (steps[state.step] === 'class' && !state.class) {
      alert('Сначала выберите класс.');
      return;
    }

    if (steps[state.step] === 'class-features' && !classFeaturesComplete()) {
      alert('Завершите обязательные выборы умений класса.');
      return;
    }

    if (steps[state.step] === 'background' && !state.background) {
      alert('Сначала выберите предысторию.');
      return;
    }

    if (steps[state.step] === 'origin-feats' && !originFeatsComplete()) {
      alert(speciesGrantsExtraFeat() ? 'Выберите одну черту от предыстории и одну дополнительную черту от вида.' : 'Выберите одну черту происхождения от предыстории.');
      return;
    }

    if (steps[state.step] === 'skills' && !skillsComplete()) {
      alert('Выберите положенное количество навыков от каждого источника.');
      return;
    }

    if (steps[state.step] === 'expertise' && !expertiseComplete()) {
      alert('Выберите 2 навыка с компетентностью из тех, которыми владеет плут.');
      return;
    }

    if (steps[state.step] === 'background') {
      const incomplete = Array.from(document.querySelectorAll('#background-rule-choices .pending-choice-card')).some((card) => {
        const values = (card.querySelector('.choice-head-actions > strong')?.textContent || '0/0').split('/').map(Number);
        return values[0] !== values[1];
      });
      if (incomplete) {
        alert('Завершите все обязательные выборы предыстории.');
        return;
      }
    }

    if (steps[state.step] === 'abilities' && (usedPointBuy() !== 27 || usedBackgroundBonus() !== 3)) { alert('Распределите все 27 очков Point Buy и все 3 очка бонуса предыстории.'); return; }
    if (steps[state.step] === 'spells' && isSpellcasterAtLevelOne()) { const incomplete=getSpellSources().find((source)=>{const selected=state.spells.sources?.[source.id]||{cantrip:[],level1:[]};return selected.cantrip.length!==source.limits.cantrip||selected.level1.length!==source.limits.level1}); if(incomplete){const selected=state.spells.sources?.[incomplete.id]||{cantrip:[],level1:[]};alert(`Заполните источник «${incomplete.title}»: заговоры ${selected.cantrip.length}/${incomplete.limits.cantrip}, заклинания 1 уровня ${selected.level1.length}/${incomplete.limits.level1}.`);return;} }
    if (steps[state.step] === 'alignment' && !state.alignment) { alert('Выберите мировоззрение.'); return; }
    showStep(state.step + 1);
  });


  $$('[data-base-action]').forEach((button) => button.addEventListener('click', () => changeBase(button.dataset.stat, button.dataset.baseAction === 'increase' ? 1 : -1)));
  $$('[data-bonus-action]').forEach((button) => button.addEventListener('click', () => changeBonus(button.dataset.stat, button.dataset.bonusAction === 'increase' ? 1 : -1)));
  $$('.alignment-card').forEach((button) => button.addEventListener('click', () => {
    state.alignment = button.dataset.alignment;
    const background = findBackground();
    if (background) {
      const configs = [
        ['background:traits', 'personalityTraits', 'trait'],
        ['background:ideal', 'ideals', 'ideal'],
        ['background:bond', 'bonds', 'bond'],
        ['background:flaw', 'flaws', 'flaw']
      ];
      configs.forEach(([choiceId, key, labelKey]) => {
        const allowed = new Set(characteristicOptions(background, key, labelKey).filter((option) => !option.disabled).map((option) => option.value));
        state.choices[choiceId] = (state.choices[choiceId] || []).filter((value) => allowed.has(value));
      });
    }
    renderAlignment();
    saveState();
  }));
  $('#edit-character')?.addEventListener('click', () => showStep(1));
  function safeFileName(value) {
    return (String(value || 'character').trim().replace(/[^a-zа-яё0-9_-]+/gi, '-') || 'character');
  }

  function downloadJson(payload, suffix = '') {
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${safeFileName(state.name)}${suffix}.json`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 0);
  }

  function createDraftPayload() {
    const finalAbilities = Object.fromEntries(
      abilityKeys.map((key) => [key, {
        ...state.abilities[key],
        total: totalScore(key),
        modifier: modifier(totalScore(key))
      }])
    );

    return {
      schema: 'league-character-draft-v6',
      createdAt: new Date().toISOString(),
      ...state,
      abilities: finalAbilities
    };
  }

  function extractNumber(value, fallback = 0) {
    if (typeof value === 'number' && Number.isFinite(value)) return value;
    const match = String(value ?? '').match(/-?\d+/);
    return match ? Number(match[0]) : fallback;
  }

  function getHitDieSize(characterClass) {
    const source = characterClass?.hitDice ?? characterClass?.hitPoints ?? '';

    // В данных классов hitDice чаще всего хранится числом: 6, 8, 10 или 12.
    if (typeof source === 'number' && Number.isFinite(source)) {
      return source;
    }

    const text = String(source).trim();
    const diceMatch = text.match(/d\s*(\d+)/i);
    if (diceMatch) return Number(diceMatch[1]);

    const numericMatch = text.match(/^(6|8|10|12)$/);
    if (numericMatch) return Number(numericMatch[1]);

    return 8;
  }

  function getSpeciesSpeed(species) {
    const source = species?.speed;
    if (typeof source === 'number') return String(source);
    if (source && typeof source === 'object') {
      const walking = source.walk ?? source.walking ?? source.speed ?? Object.values(source)[0];
      const parsed = extractNumber(walking, 30);
      return String(parsed || 30);
    }
    return String(extractNumber(source, 30) || 30);
  }



  function buildRoll20Payload() {
    const exporter = window.CharacterCreatorRoll20;
    if (!exporter?.buildPayload) {
      throw new Error('Модуль экспорта Roll20 не загрузился.');
    }

    return exporter.buildPayload({
      roll20Template,
      state,
      findSpecies,
      findVariant,
      findClass,
      findBackground,
      ALIGNMENTS,
      modifier,
      totalScore,
      getHitDieSize,
      getSpeciesSpeed,
      selectedOriginFeats,
      getEffectiveAbilities,
      normalizeEquipmentName,
      equipmentShopItems,
      abilityKeys,
      ROLL20_SKILLS,
      ROLL20_SKILL_ABILITIES,
      creatorOptions,
      getClassFeatureGroups,
      WEAPON_MASTERY_DESCRIPTIONS,
      EQUIPMENT_PACK_CONTENTS,
      getClassSpells,
      getSpellSources
    });
  }

  $('#download-draft')?.addEventListener('click', () => {
    downloadJson(createDraftPayload(), '-draft');
  });

  $('#download-roll20')?.addEventListener('click', () => {
    try {
      downloadJson(buildRoll20Payload(), '-roll20');
    } catch (error) {
      console.error(error);
      alert('Не удалось подготовить файл Roll20. Откройте консоль браузера для подробностей.');
    }
  });

  $('#reset-character')?.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    state = structuredClone(defaultState);

    if (nameInput) nameInput.value = '';

    renderSpeciesDetails();
    renderClassDetails();
    renderBackgroundDetails();
    updatePreview();
    showStep(0);
  });

  updatePreview();
  showStep(Number.isInteger(state.step) ? state.step : 0);
</script>

