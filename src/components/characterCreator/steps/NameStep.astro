<section class="wizard-step" data-step="identity">
  <div class="step-heading">
    <span>Глава первая</span>
    <h2>Назови своего героя</h2>
    <p>
      Имя можно изменить позднее. Черновик автоматически сохраняется в этом браузере.
    </p>
  </div>

  <label class="name-field">
    <span>Имя персонажа</span>
    <input
      id="character-name"
      type="text"
      maxlength="60"
      placeholder="Например: Боб"
      autocomplete="off"
    />
  </label>

  <section class="profile-section" aria-labelledby="profile-appearance-title">
    <div class="profile-section-heading">
      <span>Облик героя</span>
      <h3 id="profile-appearance-title">Основные сведения</h3>
      <p>Эти поля необязательны: их можно заполнить сейчас или вернуться к ним позднее.</p>
    </div>

    <div class="profile-compact-grid">
      <label>
        <span>Возраст</span>
        <input id="character-age" data-character-profile="age" type="text" maxlength="80" placeholder="Например: 27 лет" autocomplete="off" />
      </label>
      <label>
        <span>Размер</span>
        <input id="character-size" data-character-profile="size" type="text" maxlength="80" placeholder="Например: Средний" autocomplete="off" />
      </label>
      <label>
        <span>Цвет глаз</span>
        <input id="character-eyes" data-character-profile="eyes" type="text" maxlength="120" placeholder="Например: янтарный" autocomplete="off" />
      </label>
      <label>
        <span>Цвет кожи, перьев или чешуи</span>
        <input id="character-skin" data-character-profile="skin" type="text" maxlength="120" placeholder="Например: медно-красный" autocomplete="off" />
      </label>
      <label>
        <span>Цвет волос, перьев или чешуи</span>
        <input id="character-hair" data-character-profile="hair" type="text" maxlength="120" placeholder="Например: чёрный" autocomplete="off" />
      </label>
    </div>
  </section>

  <section class="profile-section profile-notes" aria-labelledby="profile-notes-title">
    <div class="profile-section-heading">
      <span>Летопись героя</span>
      <h3 id="profile-notes-title">Описание персонажа</h3>
    </div>

    <div class="profile-notes-grid">
      <label>
        <span>Внешность персонажа</span>
        <textarea data-character-profile="appearance" rows="6" maxlength="3000" placeholder="Как персонаж выглядит и какое первое впечатление производит?"></textarea>
      </label>
      <label>
        <span>Союзники и организации</span>
        <textarea data-character-profile="allies" rows="6" maxlength="3000" placeholder="Союзники, отряды, гильдии, церкви и другие связи. Выбранные божество, покровитель и клятва добавятся сюда автоматически при экспорте."></textarea>
      </label>
      <label class="profile-backstory">
        <span>Предыстория персонажа</span>
        <textarea data-character-profile="backstory" rows="8" maxlength="6000" placeholder="Кем герой был до начала приключений и как встал на этот путь?"></textarea>
      </label>
    </div>
  </section>
</section>

