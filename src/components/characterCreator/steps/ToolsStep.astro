<section class="wizard-step" data-step="tools">
  <div class="choice-heading"><span class="wizard-kicker">Глава восьмая</span><h2>Выбери владения инструментами</h2><p>Любая предыстория даёт одно владение любым инструментом. Класс, вид и черты могут давать дополнительные владения. Один инструмент нельзя получить дважды.</p></div>
  <div class="choice-warning" id="tools-warning" hidden></div>
  <div class="choice-wrap"><div class="choice-inner">
    <div class="choice-summary-row"><div class="choice-summary-spacer"></div><div class="choice-summary" id="tools-summary"></div></div>
    <table class="choice-table"><thead><tr><th>Инструмент</th><th>От класса</th><th>От предыстории</th><th>От вида</th><th>От черты</th></tr></thead><tbody id="tools-table-body"></tbody></table>
  </div></div>
</section>

<style>
  .choice-heading{margin-bottom:1.15rem}.choice-heading h2{margin:.35rem 0 .55rem;font-family:Georgia,serif;font-size:clamp(1.9rem,3.5vw,3rem)}.choice-heading p{margin:0;max-width:780px;opacity:.68}
  .choice-warning{margin-bottom:.8rem;padding:.75rem .9rem;border:1px solid color-mix(in srgb,#ef4444 55%,var(--card-border));border-radius:.6rem;background:color-mix(in srgb,#ef4444 10%,transparent)}
  .choice-warning.is-info{border-color:color-mix(in srgb,var(--wizard-gold) 55%,var(--card-border));background:color-mix(in srgb,var(--wizard-gold) 10%,transparent)}
  .choice-wrap{overflow-x:auto;border:1px solid color-mix(in srgb,var(--wizard-gold) 35%,var(--card-border));border-radius:.8rem;background:color-mix(in srgb,var(--background) 92%,#000)}
  .choice-inner{min-width:820px}.choice-summary-row{display:grid;grid-template-columns:28% 72%;border-bottom:1px solid color-mix(in srgb,var(--wizard-gold) 30%,var(--card-border));background:color-mix(in srgb,var(--card-bg) 88%,#000)}
  .choice-summary-spacer{min-height:72px;border-right:1px solid color-mix(in srgb,var(--card-border) 55%,transparent)}.choice-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  :global(.choice-summary-card){min-height:72px;padding:.65rem .5rem;display:flex;flex-direction:column;align-items:center;justify-content:center;border-right:1px solid color-mix(in srgb,var(--card-border) 55%,transparent)}
  :global(.choice-summary-card span){font-size:.68rem;text-transform:uppercase;letter-spacing:.07em;opacity:.72}:global(.choice-summary-card strong){margin-top:.3rem;color:var(--wizard-gold-light);font-family:Georgia,serif;font-size:1.1rem}:global(.choice-summary-card small){margin-top:.2rem;font-size:.62rem;line-height:1.25;opacity:.62;text-align:center}
  .choice-table{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed}.choice-table th,.choice-table :global(td){height:42px;padding:.5rem .75rem;border-bottom:1px solid color-mix(in srgb,var(--card-border) 72%,transparent);border-right:1px solid color-mix(in srgb,var(--card-border) 55%,transparent);text-align:center}
  .choice-table th:first-child,.choice-table :global(td:first-child){width:28%;text-align:left}.choice-table th:last-child,.choice-table :global(td:last-child){border-right:0}.choice-table th{background:color-mix(in srgb,var(--card-bg) 88%,#000);color:var(--wizard-gold-light);font-size:.76rem;text-transform:uppercase}
  .choice-table :global(tbody tr:nth-child(odd)){background:color-mix(in srgb,var(--card-bg) 34%,transparent)}.choice-table :global(tbody tr:nth-child(even)){background:color-mix(in srgb,var(--card-bg) 14%,transparent)}.choice-table :global(tbody tr:hover){background:color-mix(in srgb,var(--wizard-gold) 13%,var(--card-bg));box-shadow:inset 4px 0 0 var(--wizard-gold)}
  .choice-table :global(.choice-name){font-weight:800;padding-left:1rem}.choice-table :global(input){width:1.25rem;height:1.25rem;accent-color:var(--wizard-gold);cursor:pointer}.choice-table :global(.choice-unavailable){opacity:.35}
  @media(max-width:760px){.choice-inner{min-width:680px}.choice-summary-row{grid-template-columns:34% 66%}.choice-table th:first-child,.choice-table :global(td:first-child){width:34%}}
</style>
