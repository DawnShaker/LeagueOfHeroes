---
interface Props { backgroundOptions: any[]; }
const { backgroundOptions } = Astro.props;
---

<section class="wizard-step" data-step="background">
  <div class="background-step-heading" id="background-picker">
    <span class="wizard-kicker">Глава пятая</span>
    <h2>Выбери предысторию</h2>
    <p>Предыстория рассказывает, кем герой был до начала приключений, и определяет часть его владений и снаряжения.</p>
  </div>
  <label class="background-search-field">
    <span>Поиск предыстории</span>
    <input id="background-search" type="search" placeholder="Солдат, мудрец, преступник…" autocomplete="off" />
  </label>
  <div class="background-grid" id="background-grid">
    {backgroundOptions.map((item: any) => (
      <button class="background-card" type="button" data-background-id={item.id} data-search-text={`${item.name} ${item.nameEn}`}>
        <span class="background-card-rune">✧</span>
        <span class="background-card-copy"><strong>{item.name}</strong><small>{item.nameEn}</small></span>
      </button>
    ))}
  </div>
  <div id="background-details"></div>
</section>

<style>
  .background-step-heading { margin-bottom: 1.5rem; }
  .background-step-heading h2 { margin: .35rem 0 .6rem; font-family: Georgia, serif; font-size: clamp(1.9rem, 3.5vw, 3rem); }
  .background-step-heading p { max-width: 720px; margin: 0; opacity: .68; }
  .background-search-field { display: grid; gap: .45rem; max-width: 600px; margin-bottom: .9rem; }
  .background-search-field > span { color: var(--wizard-gold); font-size: .7rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .background-search-field input { width: 100%; padding: .9rem 1rem; border: 1px solid var(--card-border); border-radius: .58rem; background: var(--background); color: var(--text); font: inherit; outline: none; }
  .background-search-field input:focus { border-color: var(--wizard-gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--wizard-gold) 16%, transparent); }
  .background-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: .65rem; max-height: 430px; overflow-y: auto; padding: .2rem .35rem .2rem .15rem; scrollbar-gutter: stable; }
  .background-card { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: .7rem; min-height: 82px; padding: .75rem; border: 1px solid var(--card-border); border-radius: .65rem; background: var(--background); color: var(--text); text-align: left; cursor: pointer; transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease; }
  .background-card:hover { transform: translateY(-2px); border-color: var(--wizard-gold); }
  .background-card.is-selected { border-color: var(--wizard-gold-light); box-shadow: 0 0 0 2px color-mix(in srgb, var(--wizard-gold) 28%, transparent); }
  .background-card-rune { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid color-mix(in srgb, var(--wizard-gold) 40%, var(--card-border)); border-radius: 50%; color: var(--wizard-gold-light); background: color-mix(in srgb, var(--wizard-gold) 8%, transparent); font-size: 1.45rem; }
  .background-card-copy { display: grid; gap: .2rem; min-width: 0; }
  .background-card-copy strong { overflow: hidden; color: var(--wizard-gold-light); font-family: Georgia, serif; font-size: 1rem; text-overflow: ellipsis; white-space: nowrap; }
  .background-card-copy small { overflow: hidden; opacity: .55; text-overflow: ellipsis; white-space: nowrap; }
  #background-details { margin-top: 1.25rem; }
  @media (max-width: 520px) { .background-grid { grid-template-columns: 1fr; } }
</style>
