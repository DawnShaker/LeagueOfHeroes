---
import '../styles/tokenEditor.css';
const borders = [
  { id: 'none', name: 'Без рамки', image: null },
  { id: 'preset-1', name: 'Круглая', image: '/images/borders/preset1.svg' },
  { id: 'preset-2', name: 'Двойная', image: '/images/borders/preset2.svg' },
  { id: 'preset-3', name: 'Декоративная', image: '/images/borders/preset3.svg' },
  { id: 'preset-4', name: 'Стальная', image: '/images/borders/preset4.svg' },
  { id: 'preset-5', name: 'Руническая', image: '/images/borders/preset5.svg' },
  { id: 'preset-6', name: 'Пламенная', image: '/images/borders/preset6.svg' },
  { id: 'preset-7', name: 'Лесная', image: '/images/borders/preset7.svg' },
  { id: 'preset-8', name: 'Некромантская', image: '/images/borders/preset8.svg' },
  { id: 'preset-9', name: 'Золотая', image: '/images/borders/preset9.svg' },
  { id: 'preset-10', name: 'Тактическая', image: '/images/borders/preset10.svg' },
];
---

<div class="token-editor" data-token-editor>
  <section class="token-preview-panel" aria-labelledby="token-preview-title">
    <div class="token-preview-heading">
      <h2 id="token-preview-title">Предпросмотр</h2>
      <div class="token-history" role="group" aria-label="История изменений">
        <button type="button" id="token-undo" disabled aria-label="Отменить действие" title="Отменить (Ctrl / ⌘ + Z)">↶</button>
        <button type="button" id="token-redo" disabled aria-label="Повторить действие" title="Повторить (Ctrl / ⌘ + Shift + Z)">↷</button>
      </div>
    </div>
    <div class="token-canvas-wrap" id="token-drop-zone">
      <canvas id="token-canvas" width="512" height="512" tabindex="0" aria-label="Предпросмотр токена. Перетаскивайте портрет; Ctrl и Shift с мышью меняют масштаб и поворот. Alt перетаскивает рамку." aria-describedby="token-canvas-help">Для редактирования токена нужен браузер с поддержкой Canvas.</canvas>
      <div class="token-empty" id="token-empty">
        <span class="token-empty-icon" aria-hidden="true">＋</span>
        <strong>Добавьте портрет персонажа</strong>
        <p>Перетащите изображение сюда<br />или вставьте его из буфера обмена.</p>
        <button type="button" class="token-button-primary" data-upload-art>Выбрать изображение</button>
        <span class="token-muted">PNG, JPG, WebP, GIF, SVG · до 20 МБ</span>
      </div>
      <div class="token-drop-hint" aria-hidden="true">Отпустите файл, чтобы загрузить портрет</div>
    </div>
    <p id="token-canvas-help" class="token-help">Перетаскивайте портрет для кадрирования. Ctrl + перетаскивание меняет масштаб, Shift + перетаскивание — поворот; Alt + перетаскивание двигает рамку. Колесо мыши с Ctrl или Shift тоже меняет масштаб или поворот.</p>
    <div class="token-feedback">
      <p id="token-status" role="status" aria-live="polite">Выберите изображение, чтобы начать.</p>
      <p id="token-error" role="alert" hidden></p>
      <button type="button" id="token-retry-draft" hidden>Повторить сохранение</button>
      <p id="token-draft-status" class="token-muted" role="status" aria-live="polite"></p>
    </div>
    <noscript><p>Включите JavaScript, чтобы загрузить изображение и создать токен.</p></noscript>
  </section>

  <div class="token-settings">
    <section class="token-card" aria-labelledby="token-image-title">
      <h2 id="token-image-title"><span aria-hidden="true">1</span> Изображение</h2>
      <input id="token-image-file" class="token-file-input" type="file" tabindex="-1" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" aria-label="Загрузить портрет" />
      <div class="token-image-actions">
        <button type="button" data-upload-art>Выбрать изображение</button>
        <span id="token-image-name" class="token-muted">Изображение не выбрано</span>
      </div>
      <fieldset id="token-image-controls" disabled>
        <legend class="token-sr-only">Настройка кадра</legend>
        <div class="token-field">
          <div class="token-field-heading"><label for="token-scale">Масштаб</label><div class="token-number"><input id="token-scale-number" type="number" min="10" max="500" step="1" value="100" aria-label="Масштаб в процентах" /><span aria-hidden="true">%</span></div></div>
          <input id="token-scale" type="range" min="10" max="500" step="1" value="100" aria-label="Масштаб" />
          <button type="button" class="token-text-button" id="token-reset-scale">Сбросить масштаб</button>
        </div>
        <div class="token-field">
          <div class="token-field-heading"><label for="token-rotation">Поворот</label><div class="token-number"><input id="token-rotation-number" type="number" min="-180" max="180" step="1" value="0" aria-label="Поворот в градусах" /><span aria-hidden="true">°</span></div></div>
          <input id="token-rotation" type="range" min="-180" max="180" step="1" value="0" aria-label="Поворот" />
          <button type="button" class="token-text-button" id="token-reset-rotation">Сбросить поворот</button>
        </div>
        <div class="token-field">
          <div class="token-field-heading"><label for="token-size">Размер токена</label><div class="token-number"><input id="token-size-number" type="number" min="25" max="100" step="1" value="100" aria-label="Размер токена в процентах" /><span aria-hidden="true">%</span></div></div>
          <input id="token-size" type="range" min="25" max="100" step="1" value="100" aria-label="Размер токена" />
        </div>
        <div class="token-action-grid">
          <button type="button" id="token-center">По центру</button>
          <button type="button" id="token-fill">Заполнить круг</button>
          <button type="button" id="token-fit">Вписать целиком</button>
          <button type="button" id="token-reset">Сбросить кадр</button>
        </div>
      </fieldset>
    </section>

    <section class="token-card" aria-labelledby="token-border-title">
      <h2 id="token-border-title"><span aria-hidden="true">2</span> Рамка и фон</h2>
      <div class="token-border-grid" role="group" aria-label="Выбор рамки">
        {borders.map(border => (
          <button type="button" class="token-border-option" data-border={border.id} aria-pressed={border.id === 'none' ? 'true' : 'false'}>
            <span class="token-border-thumb">{border.image ? <img src={border.image} alt="" width="72" height="72" /> : <span class="token-no-border" aria-hidden="true"></span>}</span>
            <span>{border.name}</span>
          </button>
        ))}
        <button type="button" class="token-border-option" id="token-custom-border" data-border="custom" aria-pressed="false">
          <span class="token-border-thumb"><img id="token-custom-thumb" alt="" width="72" height="72" hidden /><span id="token-custom-plus" aria-hidden="true">＋</span></span>
          <span>Своя рамка</span>
        </button>
      </div>
      <input id="token-border-file" class="token-file-input" type="file" tabindex="-1" accept="image/svg+xml,image/png" aria-label="Загрузить свою рамку PNG или SVG" />
      <div id="token-custom-options" hidden>
        <p id="token-border-name" class="token-muted"></p>
        <button type="button" id="token-replace-border" class="token-text-button">Заменить свою рамку</button>
        <label id="token-recolor-label" class="token-check" hidden><input id="token-recolor" type="checkbox" /> Перекрасить SVG</label>
        <p class="token-help">PNG или SVG до 5 МБ. Нужна рамка с прозрачным центром; круглое окно портрета — 400 px в макете 512 × 512.</p>
      </div>
      <fieldset id="token-frame-controls" disabled>
        <legend>Положение и размер рамки</legend>
        <div class="token-field"><div class="token-field-heading"><label for="token-frame-scale">Масштаб</label><div class="token-number"><input id="token-frame-scale-number" type="number" min="25" max="200" step="1" value="100" aria-label="Масштаб рамки в процентах" /><span aria-hidden="true">%</span></div></div><input id="token-frame-scale" type="range" min="25" max="200" step="1" value="100" aria-label="Масштаб рамки" /></div>
        <div class="token-field"><div class="token-field-heading"><label for="token-frame-rotation">Поворот</label><div class="token-number"><input id="token-frame-rotation-number" type="number" min="-180" max="180" step="1" value="0" aria-label="Поворот рамки в градусах" /><span aria-hidden="true">°</span></div></div><input id="token-frame-rotation" type="range" min="-180" max="180" step="1" value="0" aria-label="Поворот рамки" /></div>
        <div class="token-field"><div class="token-field-heading"><label for="token-frame-x">Смещение по горизонтали</label><div class="token-number"><input id="token-frame-x-number" type="number" min="-128" max="128" step="1" value="0" aria-label="Смещение рамки по горизонтали" /><span aria-hidden="true">px</span></div></div><input id="token-frame-x" type="range" min="-128" max="128" step="1" value="0" aria-label="Смещение рамки по горизонтали" /></div>
        <div class="token-field"><div class="token-field-heading"><label for="token-frame-y">Смещение по вертикали</label><div class="token-number"><input id="token-frame-y-number" type="number" min="-128" max="128" step="1" value="0" aria-label="Смещение рамки по вертикали" /><span aria-hidden="true">px</span></div></div><input id="token-frame-y" type="range" min="-128" max="128" step="1" value="0" aria-label="Смещение рамки по вертикали" /></div>
        <button type="button" class="token-text-button" id="token-reset-frame">Сбросить рамку</button>
      </fieldset>
      <div id="token-frame-fill" hidden>
        <div class="token-field"><label for="token-border-fill-mode">Заливка рамки</label><select id="token-border-fill-mode"><option value="solid">Сплошной цвет</option><option value="gradient">Градиент</option><option value="texture">Текстура</option><option value="original">Исходные цвета</option></select></div>
        <label class="token-color-field" id="token-border-color-label"><span>Цвет рамки</span><input id="token-border-color" type="color" value="#ffffff" /></label>
        <div id="token-gradient-controls" hidden>
          <div id="token-gradient-stops" class="token-gradient-stops">
            {Array.from({ length: 5 }, (_, index) => <label class="token-color-field" data-gradient-stop={index} hidden><span>Цвет {index + 1}</span><input id={`token-gradient-color-${index}`} type="color" value={index === 0 ? '#ffffff' : '#64748b'} /></label>)}
          </div>
          <div class="token-inline-actions"><button type="button" id="token-gradient-add">Добавить цвет</button><button type="button" id="token-gradient-remove">Убрать цвет</button></div>
          <div class="token-field"><div class="token-field-heading"><label for="token-gradient-angle">Направление</label><span id="token-gradient-angle-value" class="token-muted">0°</span></div><input id="token-gradient-angle" type="range" min="0" max="360" step="1" value="0" aria-label="Направление градиента" /></div>
        </div>
        <div id="token-texture-controls" hidden>
          <div class="token-field"><label for="token-texture-kind">Тип текстуры</label><select id="token-texture-kind"><option value="stone">Камень</option><option value="noise">Шум</option><option value="stripes">Полосы</option><option value="dots">Точки</option><option value="scales">Чешуя</option></select></div>
          <canvas id="token-texture-preview" width="256" height="112" aria-label="Предпросмотр генерируемой текстуры"></canvas>
          <div class="token-field"><div class="token-field-heading"><label for="token-texture-scale">Размер узора</label><span id="token-texture-scale-value" class="token-muted">32</span></div><input id="token-texture-scale" type="range" min="8" max="80" step="1" value="32" aria-label="Размер узора текстуры" /></div>
          <div class="token-field"><div class="token-field-heading"><label for="token-texture-contrast">Контраст</label><span id="token-texture-contrast-value" class="token-muted">55%</span></div><input id="token-texture-contrast" type="range" min="0" max="100" step="1" value="55" aria-label="Контраст текстуры" /></div>
          <div class="token-field"><div class="token-field-heading"><label for="token-texture-x">Смещение текстуры по горизонтали</label><span id="token-texture-x-value" class="token-muted">0 px</span></div><input id="token-texture-x" type="range" min="-128" max="128" step="1" value="0" aria-label="Смещение текстуры по горизонтали относительно рамки" /></div>
          <div class="token-field"><div class="token-field-heading"><label for="token-texture-y">Смещение текстуры по вертикали</label><span id="token-texture-y-value" class="token-muted">0 px</span></div><input id="token-texture-y" type="range" min="-128" max="128" step="1" value="0" aria-label="Смещение текстуры по вертикали относительно рамки" /></div>
        </div>
      </div>
      <div class="token-field">
        <label for="token-background">Фон внутри токена</label>
        <select id="token-background"><option value="transparent">Прозрачный</option><option value="color">Цветной</option></select>
        <label class="token-color-field" id="token-bg-color-label" hidden><span>Цвет фона</span><input id="token-bg-color" type="color" value="#1e293b" /></label>
        <p class="token-help">Шахматная подложка показывает прозрачность и не попадает в PNG.</p>
      </div>
    </section>

    <section class="token-card token-export" aria-labelledby="token-export-title">
      <h2 id="token-export-title"><span aria-hidden="true">3</span> Экспорт</h2>
      <div class="token-field"><label for="token-export-size">Размер PNG</label><select id="token-export-size"><option value="512">512 × 512 px</option><option value="1024">1024 × 1024 px</option><option value="1536">1536 × 1536 px</option></select></div>
      <div class="token-field"><label for="token-filename">Имя файла</label><div class="token-filename"><input id="token-filename" type="text" value="token" maxlength="80" autocomplete="off" /><span>.png</span></div></div>
      <div class="token-download-bar"><button type="button" id="token-download" class="token-button-primary" disabled>Скачать PNG</button><span id="token-export-summary" class="token-muted">512 × 512 px · прозрачный фон</span></div>
      <div class="token-clear-row"><button type="button" id="token-clear" class="token-text-button" disabled>Очистить редактор</button><button type="button" id="token-restore" hidden>Отменить очистку</button></div>
      <p class="token-help">Изображения обрабатываются на вашем устройстве. Черновик сохраняется в этом браузере.</p>
    </section>
  </div>
</div>

<script>
  import { initializeTokenEditor } from '../scripts/tokenEditor';
  const root = document.querySelector<HTMLElement>('[data-token-editor]');
  if (root) initializeTokenEditor(root);
</script>
