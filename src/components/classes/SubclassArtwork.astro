---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Subclass } from '../../types/class';

interface Props {
  subclass: Subclass;
}

const { subclass } = Astro.props;
const artwork = subclass.artwork;
if (!artwork) throw new Error(`Missing artwork metadata for subclass ${subclass.id}`);
const originals = import.meta.glob<{ default: ImageMetadata }>('../../../public/images/subclasses/*.png');
const loadOriginal = originals[`../../../public${artwork.src}`];
if (!loadOriginal) throw new Error(`Missing artwork for subclass ${subclass.id}`);
const original = (await loadOriginal()).default;
const optimized = await getImage({
  src: original,
  width: Math.min(400, original.width),
  widths: [...new Set([240, 400, 800].map(width => Math.min(width, original.width)))],
  format: 'webp',
  quality: 80,
});
---

<figure class="subclass-artwork" data-subclass-art={subclass.id} hidden>
  <img
    src={optimized.src}
    srcset={optimized.srcSet.attribute}
    sizes="(max-width: 760px) 220px, (max-width: 1099px) 38vw, (max-width: 1399px) 28vw, 400px"
    width={original.width}
    height={original.height}
    alt={artwork.alt}
    loading="lazy"
    decoding="async"
  />
  <figcaption>{subclass.name}</figcaption>
</figure>
